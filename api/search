ckage_api.py`","locale":"en"},"11717":{"id":"/en/docs/development-testing-45","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#layout","content":"`import hoshimi` loads no server dependency; the lazily exported objects are the implementation's own","locale":"en"},"11718":{"id":"/en/docs/development-testing-46","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#layout","content":"`tests/fixtures/apply_patch/`","locale":"en"},"11719":{"id":"/en/docs/development-testing-47","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#layout","content":"`apply_patch` scenarios from Codex (codex-rs/apply-patch, Apache-2.0), one folder each","locale":"en"},"11720":{"id":"/en/docs/development-testing-48","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#layout","content":"To run part of the suite, call pytest directly (`test-py` takes no options):","locale":"en"},"11721":{"id":"/en/docs/development-testing-49","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#shared-fixtures","content":"`tests/conftest.py` provides a provider that never touches the network, and services and an app built on it:","locale":"en"},"11722":{"id":"/en/docs/development-testing-50","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#shared-fixtures","content":"Name","locale":"en"},"11723":{"id":"/en/docs/development-testing-51","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#shared-fixtures","content":"Kind","locale":"en"},"11724":{"id":"/en/docs/development-testing-52","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#shared-fixtures","content":"What it does","locale":"en"},"11725":{"id":"/en/docs/development-testing-53","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#shared-fixtures","content":"`isolated_data_dir`","locale":"en"},"11726":{"id":"/en/docs/development-testing-54","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#shared-fixtures","content":"Autouse fixture","locale":"en"},"11727":{"id":"/en/docs/development-testing-55","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#shared-fixtures","content":"Points `HOSHIMI_DATA_DIR` at the test's own `tmp_path`, so configuration and data never reach the real data folder","locale":"en"},"11728":{"id":"/en/docs/development-testing-56","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#shared-fixtures","content":"`FakeProvider`","locale":"en"},"11729":{"id":"/en/docs/development-testing-57","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#shared-fixtures","content":"`Provider` subclass, ID `fake`","locale":"en"},"11730":{"id":"/en/docs/development-testing-58","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#shared-fixtures","content":"Echoes the model and the message count: yields `text_delta` `echo:<model>:`, the count, `usage`, `finish`; its models are `fake-1` (marked free) and `fake-2`; `provider.seen` records the bodies it received","locale":"en"},"11731":{"id":"/en/docs/development-testing-59","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#shared-fixtures","content":"`make_services(*extra, **settings)`","locale":"en"},"11732":{"id":"/en/docs/development-testing-60","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#shared-fixtures","content":"Function","locale":"en"},"11733":{"id":"/en/docs/development-testing-61","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#shared-fixtures","content":"A `Services` whose `fake` provider is declared in the configuration, so a settings save rebuilds the pool as it was; providers in `extra` join the pool as `fake0`, `fake1`","locale":"en"},"11734":{"id":"/en/docs/development-testing-62","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#shared-fixtures","content":"`services`","locale":"en"},"11735":{"id":"/en/docs/development-testing-63","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#shared-fixtures","content":"Fixture","locale":"en"},"11736":{"id":"/en/docs/development-testing-64","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#shared-fixtures","content":"`make_services()`","locale":"en"},"11737":{"id":"/en/docs/development-testing-65","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#shared-fixtures","content":"`client`","locale":"en"},"11738":{"id":"/en/docs/development-testing-66","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#shared-fixtures","content":"Fixture","locale":"en"},"11739":{"id":"/en/docs/development-testing-67","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#shared-fixtures","content":"`TestClient(create_app(services, serve_ui=False), base_url=\"http://localhost\")`","locale":"en"},"11740":{"id":"/en/docs/development-testing-68","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#shared-fixtures","content":"`FakeProvider` is registered in `PROVIDER_CLASSES[\"fake\"]`; without that, the rebuild after a settings save would drop `fake` as an unknown provider.","locale":"en"},"11741":{"id":"/en/docs/development-testing-69","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#shared-fixtures","content":"A route test looks like this:","locale":"en"},"11742":{"id":"/en/docs/development-testing-70","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#common-patterns","content":"**Provider adapters**: build the adapter's client on `httpx.MockTransport` and check the request's address, headers and body, and the chunk types `stream_raw` yields. There is an example in Provider adapters.","locale":"en"},"11743":{"id":"/en/docs/development-testing-71","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#common-patterns","content":"**Anthropic Messages**: `tests/api/test_native_messages.py` drives the gateway with the official Anthropic SDK's JSON and stream helpers (the SDK is in the `dev` extra), against a local mock transport, so no real credentials are needed. `tests/api/test_messages_heartbeat.py` separately checks the heartbeat timing, that heartbeats never split a whole SSE frame, and that the upstream is released when the client goes away. To try a configured gateway with real Claude Code, see Claude Code.","locale":"en"},"11744":{"id":"/en/docs/development-testing-72","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#common-patterns","content":"**POSIX-only tests**: the Playground's shell and background-command tests skip on Windows (`pytest.mark.skipif(os.name == \"nt\", ...)`); usage tests that switch the local time zone skip where `time.tzset` is missing.","locale":"en"},"11745":{"id":"/en/docs/development-testing-73","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#common-patterns","content":"**Your own Services**: call `make_services(default_model=..., ...)` for particular settings; pass extra `FakeProvider`s or subclasses for several providers.","locale":"en"},"11746":{"id":"/en/docs/development-testing-74","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#web-ui-tests","content":"In `hoshimi/webui`, `bun run test` runs Vitest and `bun run typecheck` runs vue-tsc; `python scripts/dev.py test-web` runs both in turn. The environment is happy-dom; `src/test/setup.ts` supplies the `ElementInternals` that `@material/web` asks for, and `src/test/motion-zero.css` sets every motion duration to zero, so a test never waits on a transition. Vitest uses the `vmThreads` pool (worker threads race each other creating their temporary folder on Windows).","locale":"en"},"11747":{"id":"/en/docs/development-testing-75","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#web-ui-tests","content":"Tests sit next to the files they test (`*.test.ts`). Besides the component, store and query tests, a few suites check rules that apply everywhere:","locale":"en"},"11748":{"id":"/en/docs/development-testing-76","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#web-ui-tests","content":"Test","locale":"en"},"11749":{"id":"/en/docs/development-testing-77","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#web-ui-tests","content":"Rule","locale":"en"},"11750":{"id":"/en/docs/development-testing-78","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#web-ui-tests","content":"`src/layout.test.ts`","locale":"en"},"11751":{"id":"/en/docs/development-testing-79","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#web-ui-tests","content":"The layout rules: rows that can shrink, bounded lists, scrolling only through `.app-scroll`, scrollbar lanes, the bottom navigation, unstretched charts; see Web UI","locale":"en"},"11752":{"id":"/en/docs/development-testing-80","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#web-ui-tests","content":"`src/tokens.test.ts`","locale":"en"},"11753":{"id":"/en/docs/development-testing-81","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#web-ui-tests","content":"No hex colours in `.vue` and `.css` outside `src/theme/`","locale":"en"},"11754":{"id":"/en/docs/development-testing-82","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#web-ui-tests","content":"`src/imports.test.ts`","locale":"en"},"11755":{"id":"/en/docs/development-testing-83","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#web-ui-tests","content":"Modules import each other through the `@/` alias, with no relative path","locale":"en"},"11756":{"id":"/en/docs/development-testing-84","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#web-ui-tests","content":"`src/i18n/i18n.test.ts`","locale":"en"},"11757":{"id":"/en/docs/development-testing-85","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#web-ui-tests","content":"English, Simplified Chinese and Japanese have the same keys and placeholders; system language detection","locale":"en"},"11758":{"id":"/en/docs/development-testing-86","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#web-ui-tests","content":"`src/devProxy.test.ts`","locale":"en"},"11759":{"id":"/en/docs/development-testing-87","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#web-ui-tests","content":"The dev proxy shortens only the \"API is not up\" kind of error to one line; anything else is still printed in full","locale":"en"},"11760":{"id":"/en/docs/development-testing-88","page_id":"/
elopment-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-modules-of-core","content":"Network","locale":"en"},"10957":{"id":"/en/docs/development-architecture-52","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-modules-of-core","content":"`net/` (clients, proxy policy, port binding, `server.json`)","locale":"en"},"10958":{"id":"/en/docs/development-architecture-53","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-modules-of-core","content":"Other","locale":"en"},"10959":{"id":"/en/docs/development-architecture-54","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-modules-of-core","content":"`security.py` (access key, CIDR, Host and CORS checks), `updates.py` (asks PyPI for a newer release), `agent/` (the Playground's tools)","locale":"en"},"10960":{"id":"/en/docs/development-architecture-55","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"`Services` in `hoshimi/core/context.py` is everything a command or a request handler needs:","locale":"en"},"10961":{"id":"/en/docs/development-architecture-56","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"Field","locale":"en"},"10962":{"id":"/en/docs/development-architecture-57","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"Contents","locale":"en"},"10963":{"id":"/en/docs/development-architecture-58","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"`settings`","locale":"en"},"10964":{"id":"/en/docs/development-architecture-59","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"The effective configuration (`config.json` plus command-line overrides)","locale":"en"},"10965":{"id":"/en/docs/development-architecture-60","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"`registry`","locale":"en"},"10966":{"id":"/en/docs/development-architecture-61","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"The enabled providers and their HTTP clients; routes model names to providers","locale":"en"},"10967":{"id":"/en/docs/development-architecture-62","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"`db`","locale":"en"},"10968":{"id":"/en/docs/development-architecture-63","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"The one `hoshimi.db` connection the stores below share","locale":"en"},"10969":{"id":"/en/docs/development-architecture-64","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"`probe`","locale":"en"},"10970":{"id":"/en/docs/development-architecture-65","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"The last availability verdict per model","locale":"en"},"10971":{"id":"/en/docs/development-architecture-66","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"`stats`","locale":"en"},"10972":{"id":"/en/docs/development-architecture-67","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"Usage accounting; `stats.live` is the calls in flight","locale":"en"},"10973":{"id":"/en/docs/development-architecture-68","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"`refresher`","locale":"en"},"10974":{"id":"/en/docs/development-architecture-69","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"Renews credentials on a timer","locale":"en"},"10975":{"id":"/en/docs/development-architecture-70","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"`credits`","locale":"en"},"10976":{"id":"/en/docs/development-architecture-71","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"Daily check-in and balances","locale":"en"},"10977":{"id":"/en/docs/development-architecture-72","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"`login`","locale":"en"},"10978":{"id":"/en/docs/development-architecture-73","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"Interactive login sessions (`LoginManager`)","locale":"en"},"10979":{"id":"/en/docs/development-architecture-74","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"`updates`","locale":"en"},"10980":{"id":"/en/docs/development-architecture-75","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"Asks PyPI in the background whether a newer release exists","locale":"en"},"10981":{"id":"/en/docs/development-architecture-76","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"`conversations`","locale":"en"},"10982":{"id":"/en/docs/development-architecture-77","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"The Playground's conversations","locale":"en"},"10983":{"id":"/en/docs/development-architecture-78","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"`agent`","locale":"en"},"10984":{"id":"/en/docs/development-architecture-79","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"Background commands and approvals of the Playground's tools","locale":"en"},"10985":{"id":"/en/docs/development-architecture-80","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"`build_services(settings=None)` reads `config.json` from the data folder when no settings are given, then: collects each provider's accounts and options from the configuration (`pool_inputs`) and builds the `Registry` from them; opens `hoshimi.db` in the data folder, one connection for every store; and creates the renewal, check-in, login and update services. When a browser login files a new account, the login manager rebuilds the provider pool from the new configuration at once.","locale":"en"},"10986":{"id":"/en/docs/development-architecture-81","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"A `Services` built directly (tests, embedders) needs only `settings` and `registry`; the other stores keep their rows in memory by default, and the timer services are `None`.","locale":"en"},"10987":{"id":"/en/docs/development-architecture-82","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#updating-the-configuration-while-running","content":"Saving settings in the Web UI calls `Services.apply_settings(new)`, without a restart:","locale":"en"},"10988":{"id":"/en/docs/development-architecture-83","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#updating-the-configuration-while-running","content":"The pool is rebuilt only when **its inputs** (each provider's accounts, options and disabled state) changed; a change such as the port rebuilds nothing. On a rebuild, providers whose configuration did not change are kept as they are, so what they hold in memory (which account's refresh token was refused, which account is cooling down) survives; a provider whose network options alone changed is kept as well, with only its route updated.","locale":"en"},"10989":{"id":"/en/docs/development-architecture-84","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#updating-the-configuration-while-running","content":"Every service that holds the settings object (renewal, check-in, login, update checks, the network client) is pointed at the new one, so none of them later writes the old configuration back over the file.","locale":"en"},"10990":{"id":"/en/docs/development-architecture-85","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#updating-the-configuration-while-running","content":"Switching `server.check_updates` starts or stops the update timer at once.","locale":"en"},"10991":{"id":"/en/docs/development-architecture-86","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#updating-the-configuration-while-running","content":"`Services.close()` stops the timers, closes the Playground's background commands and the providers' HTTP clients, writes the last batch of usage records, then closes the database. Calling it twice is safe.","locale":"en"},"10992":{"id":"/en/docs/development-architecture-87","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-app-factory","content":"`create_app(services, ...)` in `hoshimi/api/app.py` builds the FastAPI app:","locale":"en"},"10993":{"id":"/en/docs/development-architecture-88","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-app-factory","content":"Parameter","locale":"en"},"10994":{"id":"/en/docs/development-architecture-89","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-app-factory","content":"What it does","locale":"en"},"10995":{"id":"/en/docs/development-architecture-90","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-app-factory","content":"`services`","locale":"en"},"10996":{"id":"/en/docs/development-architecture-91","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-app-factory","content":"All of the app's services, kept in `app.state.services`; routes get them through the `ServicesDep` dependency","locale":"en"},"10997":{"id":"/en/docs/development-architecture-92","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-app-factory","content":"`bound_host`, `bound_port`, `requested_port`","locale":"en"},"10998":{"id":"/en/docs/development-architecture-93","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-app-factory","content":"The address actually bound and the port asked for; the Settings page uses them to say \"the port was taken, so another was used\" or \"restart needed\"","locale":"en"},"10999":{"id":"/en/docs/development-architecture-94","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-app-factory","content":"`extra_hosts`","locale":"en"},"11000":{"id":"/en/docs/development-architecture-95","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-app-factory","content":"Additional allowed `Host` headers","locale":"en"},"11001":{"id":"/en/docs/development-architecture-96","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-app-factory","content":"`serve_ui`","locale":"en"},"11002":{"id":"/en/docs/development-architecture-97","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-app-factory","content":"Whether to serve the Web UI (`hoshimi serve --no-ui` and the tests pass `False`)","locale":"en"},"11003":{"id":"/en/docs/development-architecture-98","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-app-factory","content":"`api_prefix`","locale":"en"},"11004":{"id":"/en/docs/development-architecture-99","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-app-factory","content":"Moves the API and the Web UI together under one path, to mount Hoshimi inside another application","locale":"en"},"11005":{"id":"/en/docs/development-architecture-100","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-app-factory","content":"What it does:","locale":"en"},"11006":{"id":"/en/docs/development-architecture-101","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-app-factory","content":"Validates the security settings; on a problem it raises `ValidationError` and the server does not start.","locale":"en"},"11007":{"id":"/en/docs/development-architecture-102","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-app-factory","content":"Lifespan: on startup it starts the timers that `server.auto_refresh`, `server.auto_checkin` and `server.check_updates` turn on, and tidies the temporary conversations the previous process left; on shutdown it calls `services.close()`.","locale":"en"},"11008":{"id":"/en/docs/development-architecture-103","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-app-factory","content":"Routes: `/health`; the management routers under an `/api` prefix (they carry `/v1` themselves, so `/api/v1/...`); the model routes under `/v1` (Chat Completions, Responses, the model list, TypeSafe classification, Anthropic Messages). The interactive docs are at `/docs`, the OpenAPI document at `/openapi.json`; ReDoc is off.","locale":"en"},"11009":{"id":"/en/docs/development-architecture-104","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-app-factory","content":"Middleware: CORS when `security.allow_origins` is set; gzip for responses of 4096 bytes and more; `SecurityMiddleware`, which checks the `Host` header, a browser request's origin, whether the client address is inside the allowed CIDRs, and the access key (management API and docs) and the model API key (`/v1/`). The rules are in Security.","locale":"en"},"11010":{"id":"/en/docs/development-architecture-105","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-app-factory","content":"Last, the Web UI (`SPAStaticFiles`): it receives only paths no other route matched; hashed files under `assets/` are cached for a year, `index.html` never; an unknown path that accepts HTML falls back to `index.html`, any other unknown path is still a 404. With no build, it logs a warning and serves the API only.","locale":"en"},"11011":{"id":"/en/docs/development-architecture-106","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-app-factory","content":"To embed Hoshimi in another ASGI application:","locale":"en"},"11012":{"id":"/en/docs/development-architecture-107","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-app-factory","content":"The Web UI derives its root from the URL of its own script, so it needs no change under a prefix.","locale":"en"},"11013":{"id":"/en/docs/development-architecture-108","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"`hoshimi/core/errors.py` defines the domain exceptions, each with a code, an HTTP status and a command-line exit code:","locale":"en"},"11014":{"id":"/en/docs/development-architecture-109","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"Exception","locale":"en"},"11015":{"id":"/en/docs/development-architecture-110","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"`code`","locale":"en"},"11016":{"id":"/en/docs/development-architecture-111","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"HTTP","locale":"en"},"11017":{"id":"/en/docs/development-architecture-112","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"Exit code","locale":"en"},"11018":{"id":"/en/docs/development-architecture-113","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"`HoshimiError`","locale":"en"},"11019":{"id":"/en/docs/development-architecture-114","page_id":"/en/docs/development-architecture
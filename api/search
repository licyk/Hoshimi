ocs/development-architecture#the-modules-of-core","content":"Network","locale":"en"},"10993":{"id":"/en/docs/development-architecture-52","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-modules-of-core","content":"`net/` (clients, proxy policy, port binding, `server.json`)","locale":"en"},"10994":{"id":"/en/docs/development-architecture-53","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-modules-of-core","content":"Other","locale":"en"},"10995":{"id":"/en/docs/development-architecture-54","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-modules-of-core","content":"`security.py` (access key, CIDR, Host and CORS checks), `updates.py` (asks PyPI for a newer release), `agent/` (the Playground's tools)","locale":"en"},"10996":{"id":"/en/docs/development-architecture-55","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"`Services` in `hoshimi/core/context.py` is everything a command or a request handler needs:","locale":"en"},"10997":{"id":"/en/docs/development-architecture-56","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"Field","locale":"en"},"10998":{"id":"/en/docs/development-architecture-57","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"Contents","locale":"en"},"10999":{"id":"/en/docs/development-architecture-58","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"`settings`","locale":"en"},"11000":{"id":"/en/docs/development-architecture-59","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"The effective configuration (`config.json` plus command-line overrides)","locale":"en"},"11001":{"id":"/en/docs/development-architecture-60","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"`registry`","locale":"en"},"11002":{"id":"/en/docs/development-architecture-61","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"The enabled providers and their HTTP clients; routes model names to providers","locale":"en"},"11003":{"id":"/en/docs/development-architecture-62","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"`db`","locale":"en"},"11004":{"id":"/en/docs/development-architecture-63","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"The one `hoshimi.db` connection the stores below share","locale":"en"},"11005":{"id":"/en/docs/development-architecture-64","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"`probe`","locale":"en"},"11006":{"id":"/en/docs/development-architecture-65","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"The last availability verdict per model","locale":"en"},"11007":{"id":"/en/docs/development-architecture-66","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"`stats`","locale":"en"},"11008":{"id":"/en/docs/development-architecture-67","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"Usage accounting; `stats.live` is the calls in flight","locale":"en"},"11009":{"id":"/en/docs/development-architecture-68","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"`refresher`","locale":"en"},"11010":{"id":"/en/docs/development-architecture-69","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"Renews credentials on a timer","locale":"en"},"11011":{"id":"/en/docs/development-architecture-70","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"`credits`","locale":"en"},"11012":{"id":"/en/docs/development-architecture-71","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"Daily check-in and balances","locale":"en"},"11013":{"id":"/en/docs/development-architecture-72","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"`login`","locale":"en"},"11014":{"id":"/en/docs/development-architecture-73","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"Interactive login sessions (`LoginManager`)","locale":"en"},"11015":{"id":"/en/docs/development-architecture-74","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"`updates`","locale":"en"},"11016":{"id":"/en/docs/development-architecture-75","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"Asks PyPI in the background whether a newer release exists","locale":"en"},"11017":{"id":"/en/docs/development-architecture-76","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"`conversations`","locale":"en"},"11018":{"id":"/en/docs/development-architecture-77","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"The Playground's conversations","locale":"en"},"11019":{"id":"/en/docs/development-architecture-78","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"`agent`","locale":"en"},"11020":{"id":"/en/docs/development-architecture-79","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"Background commands and approvals of the Playground's tools","locale":"en"},"11021":{"id":"/en/docs/development-architecture-80","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"`build_services(settings=None)` reads `config.json` from the data folder when no settings are given, then: collects each provider's accounts and options from the configuration (`pool_inputs`) and builds the `Registry` from them; opens `hoshimi.db` in the data folder, one connection for every store; and creates the renewal, check-in, login and update services. When a browser login files a new account, the login manager rebuilds the provider pool from the new configuration at once.","locale":"en"},"11022":{"id":"/en/docs/development-architecture-81","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#services","content":"A `Services` built directly (tests, embedders) needs only `settings` and `registry`; the other stores keep their rows in memory by default, and the timer services are `None`.","locale":"en"},"11023":{"id":"/en/docs/development-architecture-82","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#updating-the-configuration-while-running","content":"Saving settings in the Web UI calls `Services.apply_settings(new)`, without a restart:","locale":"en"},"11024":{"id":"/en/docs/development-architecture-83","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#updating-the-configuration-while-running","content":"The pool is rebuilt only when **its inputs** (each provider's accounts, options and disabled state) changed; a change such as the port rebuilds nothing. On a rebuild, providers whose configuration did not change are kept as they are, so what they hold in memory (which account's refresh token was refused, which account is cooling down) survives; a provider whose network options alone changed is kept as well, with only its route updated.","locale":"en"},"11025":{"id":"/en/docs/development-architecture-84","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#updating-the-configuration-while-running","content":"Every service that holds the settings object (renewal, check-in, login, update checks, the network client) is pointed at the new one, so none of them later writes the old configuration back over the file.","locale":"en"},"11026":{"id":"/en/docs/development-architecture-85","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#updating-the-configuration-while-running","content":"Switching `server.check_updates` starts or stops the update timer at once.","locale":"en"},"11027":{"id":"/en/docs/development-architecture-86","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#updating-the-configuration-while-running","content":"`Services.close()` stops the timers, closes the Playground's background commands and the providers' HTTP clients, writes the last batch of usage records, then closes the database. Calling it twice is safe.","locale":"en"},"11028":{"id":"/en/docs/development-architecture-87","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-app-factory","content":"`create_app(services, ...)` in `hoshimi/api/app.py` builds the FastAPI app:","locale":"en"},"11029":{"id":"/en/docs/development-architecture-88","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-app-factory","content":"Parameter","locale":"en"},"11030":{"id":"/en/docs/development-architecture-89","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-app-factory","content":"What it does","locale":"en"},"11031":{"id":"/en/docs/development-architecture-90","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-app-factory","content":"`services`","locale":"en"},"11032":{"id":"/en/docs/development-architecture-91","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-app-factory","content":"All of the app's services, kept in `app.state.services`; routes get them through the `ServicesDep` dependency","locale":"en"},"11033":{"id":"/en/docs/development-architecture-92","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-app-factory","content":"`bound_host`, `bound_port`, `requested_port`","locale":"en"},"11034":{"id":"/en/docs/development-architecture-93","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-app-factory","content":"The address actually bound and the port asked for; the Settings page uses them to say \"the port was taken, so another was used\" or \"restart needed\"","locale":"en"},"11035":{"id":"/en/docs/development-architecture-94","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-app-factory","content":"`extra_hosts`","locale":"en"},"11036":{"id":"/en/docs/development-architecture-95","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-app-factory","content":"Additional allowed `Host` headers","locale":"en"},"11037":{"id":"/en/docs/development-architecture-96","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-app-factory","content":"`serve_ui`","locale":"en"},"11038":{"id":"/en/docs/development-architecture-97","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-app-factory","content":"Whether to serve the Web UI (`hoshimi serve --no-ui` and the tests pass `False`)","locale":"en"},"11039":{"id":"/en/docs/development-architecture-98","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-app-factory","content":"`api_prefix`","locale":"en"},"11040":{"id":"/en/docs/development-architecture-99","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-app-factory","content":"Moves the API and the Web UI together under one path, to mount Hoshimi inside another application","locale":"en"},"11041":{"id":"/en/docs/development-architecture-100","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-app-factory","content":"What it does:","locale":"en"},"11042":{"id":"/en/docs/development-architecture-101","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-app-factory","content":"Validates the security settings; on a problem it raises `ValidationError` and the server does not start.","locale":"en"},"11043":{"id":"/en/docs/development-architecture-102","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-app-factory","content":"Lifespan: on startup it starts the timers that `server.auto_refresh`, `server.auto_checkin` and `server.check_updates` turn on, and tidies the temporary conversations the previous process left; on shutdown it calls `services.close()`.","locale":"en"},"11044":{"id":"/en/docs/development-architecture-103","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-app-factory","content":"Routes: `/health`; the management routers under an `/api` prefix (they carry `/v1` themselves, so `/api/v1/...`); the model routes under `/v1` (Chat Completions, Responses, the model list, TypeSafe classification, Anthropic Messages). The interactive docs are at `/docs`, the OpenAPI document at `/openapi.json`; ReDoc is off.","locale":"en"},"11045":{"id":"/en/docs/development-architecture-104","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-app-factory","content":"Middleware: CORS when `security.allow_origins` is set; gzip for responses of 4096 bytes and more; `SecurityMiddleware`, which checks the `Host` header, a browser request's origin, whether the client address is inside the allowed CIDRs, and the access key (management API and docs) and the model API key (`/v1/`). The rules are in Security.","locale":"en"},"11046":{"id":"/en/docs/development-architecture-105","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-app-factory","content":"Last, the Web UI (`SPAStaticFiles`): it receives only paths no other route matched; hashed files under `assets/` are cached for a year, `index.html` never; an unknown path that accepts HTML falls back to `index.html`, any other unknown path is still a 404. With no build, it logs a warning and serves the API only.","locale":"en"},"11047":{"id":"/en/docs/development-architecture-106","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-app-factory","content":"To embed Hoshimi in another ASGI application:","locale":"en"},"11048":{"id":"/en/docs/development-architecture-107","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-app-factory","content":"The Web UI derives its root from the URL of its own script, so it needs no change under a prefix.","locale":"en"},"11049":{"id":"/en/docs/development-architecture-108","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"`hoshimi/core/errors.py` defines the domain exceptions, each with a code, an HTTP status and a command-line exit code:","locale":"en"},"11050":{"id":"/en/docs/development-architecture-109","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"Exception","locale":"en"},"11051":{"id":"/en/docs/development-architecture-110","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"`code`","locale":"en"},"11052":{"id":"/en/docs/development-architecture-111","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"HTTP","locale":"en"},"11053":{"id":"/en/docs/development-architecture-112","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"Exit code","locale":"en"},"11054":{"id":"/en/docs/development-architecture-113","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"`HoshimiError`","locale":"en"},"11055":{"id":"/en/docs/development-architecture-114","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"`internal_error`","locale":"en"},"11056":{"id":"/en/docs/development-architecture-115","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"500","locale":"en"},"11057":{"id":"/en/docs/development-architecture-116","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"1","locale":"en"},"11058":{"id":"/en/docs/development-architecture-117","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"`NotFoundError`","locale":"en"},"11059":{"id":"/en/docs/development-architecture-118","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"`not_found`","locale":"en"},"11060":{"id":"/en/docs/development-architecture-119","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"404","locale":"en"},"11061":{"id":"/en/docs/development-architecture-120","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"2","locale":"en"},"11062":{"id":"/en/docs/development-architecture-121","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"`ModelNotFoundError`","locale":"en"},"11063":{"id":"/en/docs/development-architecture-122","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"`model_not_found`","locale":"en"},"11064":{"id":"/en/docs/development-architecture-123","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"404","locale":"en"},"11065":{"id":"/en/docs/development-architecture-124","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"2","locale":"en"},"11066":{"id":"/en/docs/development-architecture-125","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"`ConflictError`","locale":"en"},"11067":{"id":"/en/docs/development-architecture-126","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"`conflict`","locale":"en"},"11068":{"id":"/en/docs/development-architecture-127","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"409","locale":"en"},"11069":{"id":"/en/docs/development-architecture-128","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"3","locale":"en"},"11070":{"id":"/en/docs/development-architecture-129","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"`ValidationError`","locale":"en"},"11071":{"id":"/en/docs/development-architecture-130","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"`invalid_input`","locale":"en"},"11072":{"id":"/en/docs/development-architecture-131","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"400","locale":"en"},"11073":{"id":"/en/docs/development-architecture-132","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"4","locale":"en"},"11074":{"id":"/en/docs/development-architecture-133","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"`UpstreamError`","locale":"en"},"11075":{"id":"/en/docs/development-architecture-134","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"`upstream_error`","locale":"en"},"11076":{"id":"/en/docs/development-architecture-135","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"502","locale":"en"},"11077":{"id":"/en/docs/development-architecture-136","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"5","locale":"en"},"11078":{"id":"/en/docs/development-architecture-137","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"`ModelUnavailableError`","locale":"en"},"11079":{"id":"/en/docs/development-architecture-138","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"`model_unavailable`","locale":"en"},"11080":{"id":"/en/docs/development-architecture-139","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"503","locale":"en"},"11081":{"id":"/en/docs/development-architecture-140","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"5","locale":"en"},"11082":{"id":"/en/docs/development-architecture-141","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"A provider's `ProviderError` (see Provider adapters) is a subclass of `UpstreamError` that carries the upstream status: when the upstream answered with a 4xx or 5xx, that status goes to the client unchanged.","locale":"en"},"11083":{"id":"/en/docs/development-architecture-142","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"`hoshimi/api/errors.py` picks the error's shape by path:","locale":"en"},"11084":{"id":"/en/docs/development-architecture-143","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"`/v1/messages` and `/v1/messages/count_tokens`: Anthropic's `{\"type\": \"error\", \"error\": {\"type\", \"message\"}}`; an upstream error on the native pass-through returns the upstream's own body and headers.","locale":"en"},"11085":{"id":"/en/docs/development-architecture-144","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"Any other `/v1/` path: OpenAI's `{\"error\": {\"message\", \"type\", \"code\"}}`.","locale":"en"},"11086":{"id":"/en/docs/development-architecture-145","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"The management API: `{\"code\", \"message\", \"detail\"}`.","locale":"en"},"11087":{"id":"/en/docs/development-architecture-146","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#errors","content":"The command line's `main()` catches `HoshimiError`, logs its message and exits with its exit code; Ctrl+C exits with 130, and any other unexpected exception prints a traceback and exits with 1.","locale":"en"},"11088":{"id":"/en/docs/development-architecture-147","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#one-request-end-to-end","content":"Taking `POST /v1/chat/completions`:","locale":"en"},"11089":{"id":"/en/docs/development-architecture-148","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#middleware-and-route","content":"`SecurityMiddleware` checks the `Host`, the origin, the client address and the model API key first. The route function is thin: it parses the body, calls into `core` and turns the result into a response.","locale":"en"},"11090":{"id":"/en/docs/development-architecture-149","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#preparing-the-request","content":"`prepare_request` in `hoshimi/api/inference.py` fills in the default model when the request has no `model` (`server.default_model`, or the pool's default), and refuses with `ValidationError` when there is none; it also gives the request a `prompt_cache_key` (one the request brings is kept).","locale":"en"},"11091":{"id":"/en/docs/development-architecture-150","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#counting-it","content":"`tracked_chunks` opens the usage record (`stats.turn`) before any provider is asked, so even a request that fails to route is counted. The reasoning effort is recorded as the level the request actually carries; the account that answered is reported by the pool when the first chunk arrives (`on_route`).","locale":"en"},"11092":{"id":"/en/docs/development-architecture-151","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#routing-to-a-provider","content":"`Registry.resolve` turns the model name into a provider and an upstream model name:","locale":"en"},"11093":{"id":"/en/docs/development-architecture-152","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#routing-to-a-provider","content":"`provider/model` whose prefix is an enabled provider: that provider.","locale":"en"},"11094":{"id":"/en/docs/development-architecture-153","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#routing-to-a-provider","content":"A bare model name: the first provider, in provider order (`PROVIDER_ORDER`), whose catalogue has it.","locale":"en"},"11095":{"id":"/en/docs/development-architecture-154","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#routing-to-a-provider","content":"No catalogue has it but only one provider is enabled: passed through to that provider.","locale":"en"},"11096":{"id":"/en/docs/development-architecture-155","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#routing-to-a-provider","content":"Otherwise `model_not_found`.","locale":"en"},"11097":{"id":"/en/docs/development-architecture-156","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#routing-to-a-provider","content":"`Registry.stream` then applies the reasoning-effort policy (turning the level into the model's own wire spelling) and checks the dead-model record: once every account answered 404/410 for a model, it is noted for a while, and requests for it are refused at once with `model_unavailable` (503) instead of asking the upstream again.","locale":"en"},"11098":{"id":"/en/docs/development-architecture-157","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#account-rotation-and-the-upstream-protocol","content":"`Provider.stream_using` tries the provider's accounts in turn: a failed credential is renewed and then rotated, an account out of allowance cools down for a while, and a saturated model stops the round at once. The chosen account sends the request in the upstream's own protocol through `stream_raw`, which turns the upstream stream into **normalized chunks**. The details are in Provider adapters.","locale":"en"},"11099":{"id":"/en/docs/development-architecture-158","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-public-protocol","content":"`emit_chat_chunks` turns normalized chunks into `chat.completion.chunk` objects, the route writes them as SSE frames and ends with `data: [DONE]`. A failure after the headers went out becomes an error frame, not a 500. With `stream: false`, `aggregate_chat` folds the same chunks into one `chat.completion`.","locale":"en"},"11100":{"id":"/en/docs/development-architecture-159","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-public-protocol","content":"The other protocols share this path; only its two ends differ:","locale":"en"},"11101":{"id":"/en/docs/development-architecture-160","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-public-protocol","content":"Endpoint","locale":"en"},"11102":{"id":"/en/docs/development-architecture-161","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-public-protocol","content":"On the way in","locale":"en"},"11103":{"id":"/en/docs/development-architecture-162","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-public-protocol","content":"On the way out","locale":"en"},"11104":{"id":"/en/docs/development-architecture-163","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-public-protocol","content":"`/v1/chat/completions`","locale":"en"},"11105":{"id":"/en/docs/development-architecture-164","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-public-protocol","content":"As is","locale":"en"},"11106":{"id":"/en/docs/development-architecture-165","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-public-protocol","content":"`emit_chat_chunks` / `aggregate_chat`","locale":"en"},"11107":{"id":"/en/docs/development-architecture-166","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-public-protocol","content":"`/v1/responses`","locale":"en"},"11108":{"id":"/en/docs/development-architecture-167","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-public-protocol","content":"`responses_to_chat` turns it into a Chat request","locale":"en"},"11109":{"id":"/en/docs/development-architecture-168","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-public-protocol","content":"`emit_responses_events` / `aggregate_responses`","locale":"en"},"11110":{"id":"/en/docs/development-architecture-169","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-public-protocol","content":"`/v1/messages`","locale":"en"},"11111":{"id":"/en/docs/development-architecture-170","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-public-protocol","content":"Passed through whole when the provider has a native Messages endpoint (`Registry.native_messages`); otherwise `messages_to_chat`","locale":"en"},"11112":{"id":"/en/docs/development-architecture-171","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-public-protocol","content":"Passed through, or `emit_messages_events` / `aggregate_messages`","locale":"en"},"11113":{"id":"/en/docs/development-architecture-172","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-public-protocol","content":"A streamed Messages response sends `event: ping` every 15 seconds while the upstream is thinking, and closes the upstream connection when the client goes away (`hoshimi/api/heartbeat.py`). The 
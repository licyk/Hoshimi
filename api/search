4":{"id":"/en/docs/providers-3","page_id":"/en/docs/providers","type":"heading","tags":[],"url":"/en/docs/providers#adding-an-account","content":"Adding an account","locale":"en"},"15425":{"id":"/en/docs/providers-4","page_id":"/en/docs/providers","type":"heading","tags":[],"url":"/en/docs/providers#keys-for-each-channel","content":"Keys for each channel","locale":"en"},"15426":{"id":"/en/docs/providers-5","page_id":"/en/docs/providers","type":"heading","tags":[],"url":"/en/docs/providers#choosing-a-model-routing-rules","content":"Choosing a model: routing rules","locale":"en"},"15427":{"id":"/en/docs/providers-6","page_id":"/en/docs/providers","type":"heading","tags":[],"url":"/en/docs/providers#account-pools-and-rotation","content":"Account pools and rotation","locale":"en"},"15428":{"id":"/en/docs/providers-7","page_id":"/en/docs/providers","type":"heading","tags":[],"url":"/en/docs/providers#renewal-and-check-in","content":"Renewal and check-in","locale":"en"},"15429":{"id":"/en/docs/providers-8","page_id":"/en/docs/providers","type":"heading","tags":[],"url":"/en/docs/providers#how-to-choose","content":"How to choose","locale":"en"},"15430":{"id":"/en/docs/providers-9","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers","content":"Hoshimi treats each upstream service as a **channel** (called a provider in code and configuration, and named by an ID such as `cline`, `opencode` or `agg`). A channel holds one or more **accounts**, and the accounts of one channel form its **account pool**: requests rotate through it. This page explains those ideas and the common ways to add an account; the other pages in this section cover each kind of channel.","locale":"en"},"15431":{"id":"/en/docs/providers-10","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#kinds-of-channel","content":"Kind","locale":"en"},"15432":{"id":"/en/docs/providers-11","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#kinds-of-channel","content":"Example channel IDs","locale":"en"},"15433":{"id":"/en/docs/providers-12","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#kinds-of-channel","content":"Where accounts come from","locale":"en"},"15434":{"id":"/en/docs/providers-13","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#kinds-of-channel","content":"See","locale":"en"},"15435":{"id":"/en/docs/providers-14","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#kinds-of-channel","content":"Anonymous lanes","locale":"en"},"15436":{"id":"/en/docs/providers-15","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#kinds-of-channel","content":"`opencode`, `kilo`","locale":"en"},"15437":{"id":"/en/docs/providers-16","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#kinds-of-channel","content":"None needed; on by default","locale":"en"},"15438":{"id":"/en/docs/providers-17","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#kinds-of-channel","content":"Anonymous lanes","locale":"en"},"15439":{"id":"/en/docs/providers-18","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#kinds-of-channel","content":"Free stations and subscription logins","locale":"en"},"15440":{"id":"/en/docs/providers-19","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#kinds-of-channel","content":"`cline`, `gemini`, `zcode`, `minimax`, `trae`, `qoder`, `qodercn`, `buddy`, `workbuddy`, `codearts`, `loomy`, `raccoon`, `lobsterai`, `codex`, `eac`, `zhipu`","locale":"en"},"15441":{"id":"/en/docs/providers-20","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#kinds-of-channel","content":"Browser or device-code sign-in (`zhipu` uses an API key)","locale":"en"},"15442":{"id":"/en/docs/providers-21","page_id":"/en/docs/providers","tags":[],"type":"text"
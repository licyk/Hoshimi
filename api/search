ebui/`: a Vue 3 + Vite + TypeScript app following the Material Design 3 system it shares with its sister project Mizuoto. It talks to the server over HTTP only; the built `dist/` ships in the Python package and the server serves it as static files. This page covers its structure, its contract with the server, and the rules a change to the interface must keep, most of them enforced by tests under `src/`.","locale":"en"},"11688":{"id":"/en/docs/development-webui-17","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#stack-and-commands","content":"For","locale":"en"},"11689":{"id":"/en/docs/development-webui-18","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#stack-and-commands","content":"Dependencies","locale":"en"},"11690":{"id":"/en/docs/development-webui-19","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#stack-and-commands","content":"Framework and routing","locale":"en"},"11691":{"id":"/en/docs/development-webui-20","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#stack-and-commands","content":"Vue 3, vue-router (hash mode), Pinia","locale":"en"},"11692":{"id":"/en/docs/development-webui-21","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#stack-and-commands","content":"Components","locale":"en"},"11693":{"id":"/en/docs/development-webui-22","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#stack-and-commands","content":"`@material/web` (`md-*` custom elements), `@lucide/vue` icons, the Roboto Flex font","locale":"en"},"11694":{"id":"/en/docs/development-webui-23","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#stack-and-commands","content":"Colour","locale":"en"},"11695":{"id":"/en/docs/development-webui-24","page_id":"/en/docs/dev
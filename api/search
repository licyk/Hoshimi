the version","locale":"en"},"11330":{"id":"/en/docs/development-release-11","page_id":"/en/docs/development-release","type":"heading","tags":[],"url":"/en/docs/development-release#push-to-main","content":"Push to `main`","locale":"en"},"11331":{"id":"/en/docs/development-release-12","page_id":"/en/docs/development-release","type":"heading","tags":[],"url":"/en/docs/development-release#push-a-tag-optional","content":"Push a tag (optional)","locale":"en"},"11332":{"id":"/en/docs/development-release-13","page_id":"/en/docs/development-release","type":"heading","tags":[],"url":"/en/docs/development-release#a-manual-release-run","content":"A manual Release run","locale":"en"},"11333":{"id":"/en/docs/development-release-14","page_id":"/en/docs/development-release","type":"heading","tags":[],"url":"/en/docs/development-release#credentials","content":"Credentials","locale":"en"},"11334":{"id":"/en/docs/development-release-15","page_id":"/en/docs/development-release","type":"heading","tags":[],"url":"/en/docs/development-release#deploying-the-documentation-site","content":"Deploying the documentation site","locale":"en"},"11335":{"id":"/en/docs/development-release-16","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release","content":"Hoshimi publishes one distribution: the `hoshimi` wheel and sdist, both containing the built Web UI. CI runs the same checks and build for every push and pull request; when a push to a release branch changes `hoshimi/version.py`, CI publishes to PyPI **the very files that run checked and built**. The documentation site is deployed separately from the distribution.","locale":"en"},"11336":{"id":"/en/docs/development-release-17","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#the-version","content":"File","locale":"en"},"11337":{"id":"/en/docs/development-release-18","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/dev
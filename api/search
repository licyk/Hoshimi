en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#at-a-glance","content":"Lint","locale":"en"},"11607":{"id":"/en/docs/development-testing-15","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#at-a-glance","content":"`python scripts/dev.py lint`","locale":"en"},"11608":{"id":"/en/docs/development-testing-16","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#at-a-glance","content":"Ruff over `hoshimi`, `tests`, `scripts`","locale":"en"},"11609":{"id":"/en/docs/development-testing-17","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#at-a-glance","content":"Python types","locale":"en"},"11610":{"id":"/en/docs/development-testing-18","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#at-a-glance","content":"`python scripts/dev.py typecheck-py`","locale":"en"},"11611":{"id":"/en/docs/development-testing-19","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#at-a-glance","content":"ty","locale":"en"},"11612":{"id":"/en/docs/development-testing-20","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#at-a-glance","content":"Python tests","locale":"en"},"11613":{"id":"/en/docs/development-testing-21","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#at-a-glance","content":"`python scripts/dev.py test-py`","locale":"en"},"11614":{"id":"/en/docs/development-testing-22","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#at-a-glance","content":"pytest under `tests/`","locale":"en"},"11615":{"id":"/en/docs/development-testing-23","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#at-a-glance","co
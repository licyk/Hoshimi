/en/docs/development-release#ci-workflows","content":"Publishes to PyPI; a tag also creates a GitHub release","locale":"en"},"11418":{"id":"/en/docs/development-release-62","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#ciyml","content":"Runs on the same ref queue up; only a new push to a pull request cancels the run in progress, so a newer push never interrupts a version that is being checked, built or published. The jobs:","locale":"en"},"11419":{"id":"/en/docs/development-release-63","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#ciyml","content":"Job","locale":"en"},"11420":{"id":"/en/docs/development-release-64","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#ciyml","content":"Needs","locale":"en"},"11421":{"id":"/en/docs/development-release-65","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#ciyml","content":"What it does","locale":"en"},"11422":{"id":"/en/docs/development-release-66","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#ciyml","content":"Release plan","locale":"en"},"11423":{"id":"/en/docs/development-release-67","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#ciyml","content":"—","locale":"en"},"11424":{"id":"/en/docs/development-release-68","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#ciyml","content":"Checks out the full history, runs `python3 scripts/ci.py`, outputs `release=true` or `false`","locale":"en"},"11425":{"id":"/en/docs/development-release-69","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#ciyml","content":"Checks","locale":"en"},"11426":{"id":"/en/docs/development-release-70","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#ciyml","content":"—","locale":"en"},"11427":{"id":"/en/docs/development-release-71","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#ciyml","content":"Calls `checks.yml`","locale":"en"},"11428":{"id":"/en/docs/development-release-72","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#ciyml","content":"Distribution","locale":"en"},"11429":{"id":"/en/docs/development-release-73","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#ciyml","content":"Release plan, Checks","locale":"en"},"11430":{"id":"/en/docs/development-release-74","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#ciyml","content":"Calls `build.yml`","locale":"en"},"11431":{"id":"/en/docs/development-release-75","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#ciyml","content":"Release","locale":"en"},"11432":{"id":"/en/docs/development-release-76","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#ciyml","content":"Release plan, Distribution","locale":"en"},"11433":{"id":"/en/docs/development-release-77","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#ciyml","content":"Only when `release` is true: calls `release.yml` with the version that was built","locale":"en"},"11434":{"id":"/en/docs/development-release-78","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#ciyml","content":"The release workflow has no push trigger of its own, so one push runs one copy of the checks and the build, and what gets published is what they produced.","locale":"en"},"11435":{"id":"/en/docs/development-release-79","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#the-release-plan-scriptscipy","content":"It decides whether this push publishes:","locale":"en"},"11436":{"id":"/en/docs/development-release-80","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#the-release-plan-scriptscipy","content":"A pushed tag starting with `v`: publish.","locale":"en"},"11437":{"id":"/en/docs/development-release-81","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#the-release-plan-scriptscipy","content":"A push to `main` or `hoshimi_main` that changed `hoshimi/version.py`: publish. The comparison uses the local Git history (`git diff <before> <after> -- hoshimi/version.py`), not GitHub's compare API.","locale":"en"},"11438":{"id":"/en/docs/development-release-82","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#the-release-plan-scriptscipy","content":"The first push of a new branch (an all-zero `before`): compares against the parent of the oldest pushed commit; when the event carries no commit details, against the empty tree, so a first release is never missed.","locale":"en"},"11439":{"id":"/en/docs/development-release-83","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#the-release-plan-scriptscipy","content":"Pull requests, manual runs, branch deletions and other branches: no.","locale":"en"},"11440":{"id":"/en/docs/development-release-84","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#the-release-plan-scriptscipy","content":"`tests/cli/test_ci.py` covers these cases, including a version changed and changed back, which is not a release.","locale":"en"},"11441":{"id":"/en/docs/development-release-85","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#buildyml","content":"On Ubuntu, with Python 3.11, uv, Node 24 and bun 1.4.2:","locale":"en"},"11442":{"id":"/en/docs/development-release-86","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#buildyml","content":"Reads `hoshimi.version.VERSION`; on a tag push, checks that the tag matches it.","locale":"en"},"11443":{"id":"/en/docs/development-release-87","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#buildyml","content":"`python scripts/build_wheel.py --ci`.","locale":"en"},"11444":{"id":"/en/docs/development-release-88","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#buildyml","content":"`twine check --strict dist/*`, and checks that the wheel holds `hoshimi/webui/dist/index.html`, a favicon (`.svg`) under `assets/` and the interface's `.js`, and that the sdist holds `index.html` too.","locale":"en"},"11445":{"id":"/en/docs/development-release-89","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#buildyml","content":"Installs the wheel in a separate virtual environment and runs `hoshimi version` and `smoke_install.py`.","locale":"en"},"11446":{"id":"/en/docs/development-release-90","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#buildyml","content":"Rebuilds a wheel from the sdist, installs it in another virtual environment and runs `smoke_install.py` again.","locale":"en"},"11447":{"id":"/en/docs/development-release-91","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#buildyml","content":"Uploads `dist/` as the `distributions` artifact, kept for 14 days.","locale":"en"},"11448":{"id":"/en/docs/development-release-92","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#releaseyml","content":"Job","locale":"en"},"11449":{"id":"/en/docs/development-release-93","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#releaseyml","content":"When","locale":"en"},"11450":{"id":"/en/docs/development-release-94","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#releaseyml","content":"What it does","locale":"en"},"11451":{"id":"/en/docs/development-release-95","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#releaseyml","content":"Checks, Distribution","locale":"en"},"11452":{"id":"/en/docs/development-release-96","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#releaseyml","content":"Manual runs only","locale":"en"},"11453":{"id":"/en/docs/development-release-97","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#releaseyml","content":"Runs `checks.yml` and `build.yml` first","locale":"en"},"11454":{"id":"/en/docs/development-release-98","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#releaseyml","content":"Publish to PyPI","locale":"en"},"11455":{"id":"/en/docs/development-release-99","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#releaseyml","content":"The ref is `main`, `hoshimi_main` or a tag; on a manual run, also `publish` switched on and the checks and build succeeded","locale":"en"},"11456":{"id":"/en/docs/development-release-100","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#releaseyml","content":"In the `pypi` environment, downloads the `distributions` artifact and runs `twine upload dist/* --skip-existing --non-interactive`","locale":"en"},"11457":{"id":"/en/docs/development-release-101","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#releaseyml","content":"GitHub release","locale":"en"},"11458":{"id":"/en/docs/development-release-102","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#releaseyml","content":"Publishing succeeded and the ref is a tag","locale":"en"},"11459":{"id":"/en/docs/development-release-103","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#releaseyml","content":"Creates a GitHub release named after the tag with these files attached and generated notes; if the release exists, re-uploads the files with `--clobber`","locale":"en"},"11460":{"id":"/en/docs/development-release-104","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#releaseyml","content":"Releases queue in the `hoshimi-pypi-release` group and are never cancelled, so a version push and the tag push that follows never upload at the same time.","locale":"en"},"11461":{"id":"/en/docs/development-release-105","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#change-the-version","content":"Change `VERSION` in `hoshimi/version.py`, and bring `version` in `hoshimi/webui/package.json` along. By convention the commit message is `chore: release x.y.z`.","locale":"en"},"11462":{"id":"/en/docs/development-release-106","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#push-to-main","content":"CI checks, builds, checks the installed packages, then uploads those files to PyPI. The Release job shows in Actions; if the `pypi` environment requires approval, approve it there.","locale":"en"},"11463":{"id":"/en/docs/development-release-107","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#push-a-tag-optional","content":"The tag runs CI once more: it checks the tag against the version, skips the files PyPI already has, then creates a GitHub release with the distributions and generated notes.","locale":"en"},"11464":{"id":"/en/docs/development-release-108","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#a-manual-release-run","content":"A manual run of the **Release** workflow in Actions runs the same checks and build first. Its `publish` input is off by default, which produces checked files only (download the `distributions` artifact to look at them); switch it on and run it on `main`, `hoshimi_main` or a tag to publish.","locale":"en"},"11465":{"id":"/en/docs/development-release-109","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#credentials","content":"Uploads use a PyPI API token: set `TWINE_PASSWORD` in the `pypi` environment or the repository's secrets (the user name is always `__token__`). Without it, the publish job reports an error and fails.","locale":"en"},"11466":{"id":"/en/docs/development-release-110","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#deploying-the-documentation-site","content":"This site (`site/`) is deployed separately from the distribution:","locale":"en"},"11467":{"id":"/en/docs/development-release-111","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#deploying-the-documentation-site","content":"**Netlify** (the main site, hoshimi-dev.netlify.app): builds `site/` on every push to `main`, configured by `netlify.toml` at the repository root; it skips the build when `site/` did not change.","locale":"en"},"11468":{"id":"/en/docs/development-release-112","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#deploying-the-documentation-site","content":"**GitHub Pages** (the backup, licyk.github.io/Hoshimi): `.github/workflows/site.yml` builds the site with `VITE_BASE_PATH=/Hoshimi/` and force-pushes it to the `gh-pages` branch, which Pages serves. Pages on the backup carry a canonical link to the Netlify site.","locale":"en"},"11469":{"id":"/en/docs/development-release-113","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#deploying-the-documentation-site","content":"CI's shared checks also type-check, test and build the documentation site, so a change that breaks the site's build does not pass CI.","locale":"en"},"11470":{"id":"/en/docs/development-release-114","page_id":"/en/docs/development-release","tags":[],"type":"text","url":"/en/docs/development-release#deploying-the-documentation-site","content":"How the site is organised, written and built locally is in Documentation site.","locale":"en"},"11471":{"id":"/en/docs/development-setup","page_id":"/en/docs/development-setup","type":"page","content":"Development setup","breadcrumbs":["Hoshimi Documentation","Development"],"tags":[],"url":"/en/docs/development-setup","locale":"en"},"11472":{"id":"/en/docs/development-setup-0","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup","content":"From a fresh clone to the dev mode that runs the API and the Web UI together: the repository layout, the Python environment, bun, and every scripts/dev.py task.","locale":"en"},"11473":{"id":"/en/docs/development-setup-1","page_id":"/en/docs/development-setup","type":"heading","tags":[],"url":"/en/docs/development-setup#repository-layout","content":"Repository layout","locale":"en"},"11474":{"id":"/en/docs/development-setup-2","page_id":"/en/docs/development-setup","type":"heading","tags":[],"url":"/en/docs/development-setup#the-python-environment","content":"The Python environment","locale":"en"},"11475":{"id":"/en/docs/development-setup-3","page_id":"/en/docs/development-setup","type":"heading","tags":[],"url":"/en/docs/development-setup#clone-and-create-a-virtual-environment","content":"Clone and create a virtual environment","locale":"en"},"11476":{"id":"/en/docs/development-setup-4","page_id":"/en/docs/development-setup","type":"heading","tags":[],"url":"/en/docs/development-setup#install-editable-with-the-development-dependencies","content":"Install editable, with the development dependencies","locale":"en"},"11477":{"id":"/en/docs/development-setup-5","page_id":"/en/docs/development-setup","type":"heading","tags":[],"url":"/en/docs/development-setup#check-the-environment","content":"Check the environment","locale":"en"},"11478":{"id":"/en/docs/development-setup-6","page_id":"/en/docs/development-setup","type":"heading","tags":[],"url":"/en/docs/development-setup#the-web-ui-bun","content":"The Web UI: bun","locale":"en"},"11479":{"id":"/en/docs/development-setup-7","page_id":"/en/docs/development-setup","type":"heading","tags":[],"url":"/en/docs/development-setup#dev-mode-the-api-and-vite-together","content":"Dev mode: the API and Vite together","locale":"en"},"11480":{"id":"/en/docs/development-setup-8","page_id":"/en/docs/development-setup","type":"heading","tags":[],"url":"/en/docs/development-setup#a-separate-data-folder","content":"A separate data folder","locale":"en"},"11481":{"id":"/en/docs/development-setup-9","page_id":"/en/docs/development-setup","type":"heading","tags":[],"url":"/en/docs/development-setup#the-interface-alone","content":"The interface alone","locale":"en"},"11482":{"id":"/en/docs/development-setup-10","page_id":"/en/docs/development-setup","type":"heading","tags":[],"url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`scripts/dev.py` tasks","locale":"en"},"11483":{"id":"/en/docs/development-setup-11","page_id":"/en/docs/development-setup","type":"heading","tags":[],"url":"/en/docs/development-setup#clones-of-the-reference-projects","content":"Clones of the reference projects","locale":"en"},"11484":{"id":"/en/docs/development-setup-12","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup","content":"A Hoshimi development setup has two parts: a Python environment with Hoshimi installed editable together with its development dependencies, and bun to install, build and test the Web UI and this documentation site. Everyday tasks run through `scripts/dev.py`, which uses only the standard library, behaves the same on Linux, macOS and Windows, and runs the same tools CI runs.","locale":"en"},"11485":{"id":"/en/docs/development-setup-13","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#repository-layout","content":"The scripts in `scripts/`:","locale":"en"},"11486":{"id":"/en/docs/development-setup-14","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#repository-layout","content":"Script","locale":"en"},"11487":{"id":"/en/docs/development-setup-15","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#repository-layout","content":"What it does","locale":"en"},"11488":{"id":"/en/docs/development-setup-16","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#repository-layout","content":"`dev.py`","locale":"en"},"11489":{"id":"/en/docs/development-setup-17","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#repository-layout","content":"The task runner; see below","locale":"en"},"11490":{"id":"/en/docs/development-setup-18","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#repository-layout","content":"`build_wheel.py`","locale":"en"},"11491":{"id":"/en/docs/development-setup-19","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#repository-layout","content":"Builds the Web UI, then the wheel and the sdist; see CI and releases","locale":"en"},"11492":{"id":"/en/docs/development-setup-20","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#repository-layout","content":"`smoke_install.py`","locale":"en"},"11493":{"id":"/en/docs/development-setup-21","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#repository-layout","content":"Checks that an installed distribution works, run with that installation's interpreter","locale":"en"},"11494":{"id":"/en/docs/development-setup-22","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#repository-layout","content":"`ci.py`","locale":"en"},"11495":{"id":"/en/docs/development-setup-23","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#repository-layout","content":"CI's release plan: whether this push publishes","locale":"en"},"11496":{"id":"/en/docs/development-setup-24","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#repository-layout","content":"`generate_openapi.py`","locale":"en"},"11497":{"id":"/en/docs/development-setup-25","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#repository-layout","content":"Prints the OpenAPI document on standard output, for the Web UI's types","locale":"en"},"11498":{"id":"/en/docs/development-setup-26","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#repository-layout","content":"`generate_provider_inventory.py`","locale":"en"},"11499":{"id":"/en/docs/development-setup-27","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#repository-layout","content":"Writes the Provider inventory pages","locale":"en"},"11500":{"id":"/en/docs/development-setup-28","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#repository-layout","content":"`check_layout.py`","locale":"en"},"11501":{"id":"/en/docs/development-setup-29","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#repository-layout","content":"Looks for sideways overflow in the Web UI in real browsers; see Testing","locale":"en"},"11502":{"id":"/en/docs/development-setup-30","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#clone-and-create-a-virtual-environment","content":"Hoshimi supports Python 3.10 and newer; CI lints and builds with 3.11. `.venv/` is already in `.gitignore`.","locale":"en"},"11503":{"id":"/en/docs/development-setup-31","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#install-editable-with-the-development-dependencies","content":"The `dev` extra holds pytest, Ruff, ty, build and the official Anthropic SDK (the Messages regression tests use it). To cover the cloud providers' code as well, add `google` (`google-auth[requests]`) and `bedrock` (`boto3`): CI's type checks and tests install `.[dev,google,bedrock]`.","locale":"en"},"11504":{"id":"/en/docs/development-setup-32","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#check-the-environment","content":"`dev.py` runs Ruff, ty and pytest with the interpreter running it (`sys.executable`), not whichever is on `PATH`, so running it with the virtual environment's `python` is enough.","locale":"en"},"11505":{"id":"/en/docs/development-setup-33","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#the-web-ui-bun","content":"The Web UI (`hoshimi/webui/`) and the documentation site (`site/`) both use bun to install, build and test; CI uses bun 1.4.2. When `bun` is not on `PATH`, `dev.py` prints one line saying so and exits with status 127 rather than a traceback.","locale":"en"},"11506":{"id":"/en/docs/development-setup-34","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#the-web-ui-bun","content":"The built `dist/` ships in the wheel as package data. When `hoshimi serve` runs from a checkout with no `dist/index.html`, the server logs a warning and serves the API only.","locale":"en"},"11507":{"id":"/en/docs/development-setup-35","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#dev-mode-the-api-and-vite-together","content":"It starts two processes and tags each line of their output with the process name (`api` or `web`):","locale":"en"},"11508":{"id":"/en/docs/development-setup-36","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#dev-mode-the-api-and-vite-together","content":"**API**: `python -m hoshimi serve --no-open --no-ui --port 10600 --strict-port`, with the repository root first on `PYTHONPATH`, so the code in the working tree is what runs.","locale":"en"},"11509":{"id":"/en/docs/development-setup-37","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#dev-mode-the-api-and-vite-together","content":"**Vite**: `bun run dev --port 5173 --strictPort` in `hoshimi/webui`, with `HOSHIMI_BACKEND=http://127.0.0.1:10600`.","locale":"en"},"11510":{"id":"/en/docs/development-setup-38","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#dev-mode-the-api-and-vite-together","content":"Open only `http://localhost:5173`: Vite proxies `/api`, `/v1`, `/health`, `/openapi.json`, `/docs` and `/redoc` to the API, so the interface and the model API share that one address. Interface changes reload in place; Python changes need the task restarted.","locale":"en"},"11511":{"id":"/en/docs/development-setup-39","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#dev-mode-the-api-and-vite-together","content":"Option","locale":"en"},"11512":{"id":"/en/docs/development-setup-40","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#dev-mode-the-api-and-vite-together","content":"Default","locale":"en"},"11513":{"id":"/en/docs/development-setup-41","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#dev-mode-the-api-and-vite-together","content":"What it sets","locale":"en"},"11514":{"id":"/en/docs/development-setup-42","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#dev-mode-the-api-and-vite-together","content":"`--api-port`","locale":"en"},"11515":{"id":"/en/docs/development-setup-43","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#dev-mode-the-api-and-vite-together","content":"`10600`","locale":"en"},"11516":{"id":"/en/docs/development-setup-44","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#dev-mode-the-api-and-vite-together","content":"The API server's port","locale":"en"},"11517":{"id":"/en/docs/development-setup-45","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#dev-mode-the-api-and-vite-together","content":"`--web-port`","locale":"en"},"11518":{"id":"/en/docs/development-setup-46","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#dev-mode-the-api-and-vite-together","content":"`5173`","locale":"en"},"11519":{"id":"/en/docs/development-setup-47","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#dev-mode-the-api-and-vite-together","content":"Vite's port","locale":"en"},"11520":{"id":"/en/docs/development-setup-48","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#dev-mode-the-api-and-vite-together","content":"Ctrl+C stops both processes; when one exits, the other is stopped too and the task ends with its exit status.","locale":"en"},"11521":{"id":"/en/docs/development-setup-49","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#dev-mode-the-api-and-vite-together","content":"Before the Web UI's dependencies are installed, the task says to run `python scripts/dev.py web-install` first.","locale":"en"},"11522":{"id":"/en/docs/development-setup-50","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#dev-mode-the-api-and-vite-together","content":"While the API restarts, Vite's proxy prints at most one \"API is not answering\" line every 5 seconds and answers requests with HTTP 502 and `{\"code\": \"api_unreachable\", ...}`, instead of a screen full of connection errors.","locale":"en"},"11523":{"id":"/en/docs/development-setup-51","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#a-separate-data-folder","content":"To keep the development configuration, accounts and usage apart from your everyday data, set `HOSHIMI_DATA_DIR`:","locale":"en"},"11524":{"id":"/en/docs/development-setup-52","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#a-separate-data-folder","content":"What else lives in the data folder is in Paths and data folder.","locale":"en"},"11525":{"id":"/en/docs/development-setup-53","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#the-interface-alone","content":"With an API already running elsewhere, `python scripts/dev.py web-dev` starts only Vite. It proxies to `http://127.0.0.1:10600` by default; for an API at another address, set the `HOSHIMI_BACKEND` environment variable to it first (for example `http://127.0.0.1:10601`).","locale":"en"},"11526":{"id":"/en/docs/development-setup-54","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`python scripts/dev.py` with no arguments lists every task. Several tasks can be named at once; they run in order and stop at the first failure. Everything from the first argument that starts with `-` belongs to the task; options can only be given when running a single task, and a task that takes none fails with status 2 when given some.","locale":"en"},"11527":{"id":"/en/docs/development-setup-55","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"Task","locale":"en"},"11528":{"id":"/en/docs/development-setup-56","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"What it does","locale":"en"},"11529":{"id":"/en/docs/development-setup-57","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`lint`","locale":"en"},"11530":{"id":"/en/docs/development-setup-58","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`ruff check hoshimi tests scripts`, changing nothing","locale":"en"},"11531":{"id":"/en/docs/development-setup-59","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`format`","locale":"en"},"11532":{"id":"/en/docs/development-setup-60","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`ruff check --fix` and `ruff format` over the same folders","locale":"en"},"11533":{"id":"/en/docs/development-setup-61","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`typecheck-py [ty options…]`","locale":"en"},"11534":{"id":"/en/docs/development-setup-62","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`ty check`; extra options go to ty unchanged (CI passes the Python version and platform this way)","locale":"en"},"11535":{"id":"/en/docs/development-setup-63","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`test-py`","locale":"en"},"11536":{"id":"/en/docs/development-setup-64","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"Runs pytest (every test under `tests/`)","locale":"en"},"11537":{"id":"/en/docs/development-setup-65","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`web-install`","locale":"en"},"11538":{"id":"/en/docs/development-setup-66","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`bun install` in `hoshimi/webui`","locale":"en"},"11539":{"id":"/en/docs/development-setup-67","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`web`","locale":"en"},"11540":{"id":"/en/docs/development-setup-68","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`bun run build`: the vue-tsc type-check, then the build into `hoshimi/webui/dist`","locale":"en"},"11541":{"id":"/en/docs/development-setup-69","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`web-dev`","locale":"en"},"11542":{"id":"/en/docs/development-setup-70","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"Vite only (expects an API already running)","locale":"en"},"11543":{"id":"/en/docs/development-setup-71","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`dev [--api-port] [--web-port]`","locale":"en"},"11544":{"id":"/en/docs/development-setup-72","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"The API and Vite together; see above","locale":"en"},"11545":{"id":"/en/docs/development-setup-73","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`test-web`","locale":"en"},"11546":{"id":"/en/docs/development-setup-74","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`bun run test` (Vitest), then `bun run typecheck` (vue-tsc)","locale":"en"},"11547":{"id":"/en/docs/development-setup-75","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`openapi`","locale":"en"},"11548":{"id":"/en/docs/development-setup-76","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"Prints the OpenAPI document on standard output (`scripts/generate_openapi.py`)","locale":"en"},"11549":{"id":"/en/docs/development-setup-77","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`typegen`","locale":"en"},"11550":{"id":"/en/docs/development-setup-78","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"Regenerates `hoshimi/webui/src/api/schema.d.ts` from the OpenAPI document (commit the result)","locale":"en"},"11551":{"id":"/en/docs/development-setup-79","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`typegen-check`","locale":"en"},"11552":{"id":"/en/docs/development-setup-80","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`typegen`, then `gi
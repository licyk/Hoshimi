scripts/dev.py check` once before committing: it covers CI's Python and Web UI checks.","locale":"en"},"11683":{"id":"/en/docs/development-testing-11","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#at-a-glance","content":"Check","locale":"en"},"11684":{"id":"/en/docs/development-testing-12","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#at-a-glance","content":"Command","locale":"en"},"11685":{"id":"/en/docs/development-testing-13","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#at-a-glance","content":"What it covers","locale":"en"},"11686":{"id":"/en/docs/development-testing-14","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#at-a-glance","content":"Lint","locale":"en"},"11687":{"id":"/en/docs/development-testing-15","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#at-a-glance","content":"`python scripts/dev.py lint`","locale":"en"},"11688":{"id":"/en/docs/development-testing-16","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#at-a-glance","content":"Ruff over `hoshimi`, `tests`, `scripts`","locale":"en"},"11689":{"id":"/en/docs/development-testing-17","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#at-a-glance","content":"Python types","locale":"en"},"11690":{"id":"/en/docs/development-testing-18","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#at-a-glance","content":"`python scripts/dev.py typecheck-py`","locale":"en"},"11691":{"id":"/en/docs/development-testing-19","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#at-a-glance","content":"ty","locale":"en"},"11692":{"id":"/en/docs/development-test
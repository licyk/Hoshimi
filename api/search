t","url":"/en/docs/config#when-changes-take-effect","content":"`server.access_token`, `server.model_api_key`, `security.allow_cidrs`, `server.default_model`","locale":"en"},"10883":{"id":"/en/docs/config-276","page_id":"/en/docs/config","tags":[],"type":"text","url":"/en/docs/config#when-changes-take-effect","content":"At once","locale":"en"},"10884":{"id":"/en/docs/config-277","page_id":"/en/docs/config","tags":[],"type":"text","url":"/en/docs/config#when-changes-take-effect","content":"`security.allow_origins`","locale":"en"},"10885":{"id":"/en/docs/config-278","page_id":"/en/docs/config","tags":[],"type":"text","url":"/en/docs/config#when-changes-take-effect","content":"The origin check at once; the CORS response headers browsers need use the list from startup, so restart after a change","locale":"en"},"10886":{"id":"/en/docs/config-279","page_id":"/en/docs/config","tags":[],"type":"text","url":"/en/docs/config#when-changes-take-effect","content":"`network`, `providers.*`","locale":"en"},"10887":{"id":"/en/docs/config-280","page_id":"/en/docs/config","tags":[],"type":"text","url":"/en/docs/config#when-changes-take-effect","content":"At once, for new requests; only channels whose inputs changed are rebuilt, and streaming replies finish on their original connections","locale":"en"},"10888":{"id":"/en/docs/config-281","page_id":"/en/docs/config","tags":[],"type":"text","url":"/en/docs/config#when-changes-take-effect","content":"`server.max_account_retries`","locale":"en"},"10889":{"id":"/en/docs/config-282","page_id":"/en/docs/config","tags":[],"type":"text","url":"/en/docs/config#when-changes-take-effect","content":"The next time the account pool is rebuilt (any channel's accounts or options change), or after a restart","locale":"en"},"10890":{"id":"/en/docs/config-283","page_id":"/en/docs/config","tags":[],"type":"text","url":"/en/docs/config#when-changes-take-effect","content":"`server.stats_keep_days`","locale":"en"},"10891":{"id":"/en/docs/config-284","page_id"
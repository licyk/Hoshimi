e":"zh-CN"},"3590":{"id":"/docs/development-release-82","page_id":"/docs/development-release","tags":[],"type":"text","url":"/docs/development-release#发布计划scriptscipy","content":"新分支的第一次推送（`before` 全为零）：与最早推送的那个提交的父提交比较；事件里没有提交信息时与空树比较，这样第一次发布不会被漏掉。","locale":"zh-CN"},"3591":{"id":"/docs/development-release-83","page_id":"/docs/development-release","tags":[],"type":"text","url":"/docs/development-release#发布计划scriptscipy","content":"拉取请求、手动触发、删除分支或其他分支：不发布。","locale":"zh-CN"},"3592":{"id":"/docs/development-release-84","page_id":"/docs/development-release","tags":[],"type":"text","url":"/docs/development-release#发布计划scriptscipy","content":"`tests/cli/test_ci.py` 覆盖这些情形，包括“版本改了又改回来”不算发布。","locale":"zh-CN"},"3593":{"id":"/docs/development-release-85","page_id":"/docs/development-release","tags":[],"type":"text","url":"/docs/development-release#buildyml","content":"在 Ubuntu 上，用 Python 3.11、uv、Node 24 和 bun 1.4.2：","locale":"zh-CN"},"3594":{"id":"/docs/development-release-86","page_id":"/docs/development-release","tags":[],"type":"text","url":"/docs/development-release#buildyml","content":"读取 `hoshimi.version.VERSION`；标签推送时检查标签与之相符。","locale":"zh-CN"},"3595":{"id":"/docs/development-release-87","page_id":"/docs/development-release","tags":[],"type":"text","url":"/docs/development-release#buildyml","content":"`python scripts/build_wheel.py --ci`。","locale":"zh-CN"},"3596":{"id":"/docs/development-release-88","page_id":"/docs/development-release","tags":[],"type":"text","url":"/docs/development-release#buildyml","content":"`twine check --strict dist/*`，并确认 wheel 中有 `hoshimi/webui/dist/index.html`、`assets/` 下的 favicon（`.svg`）和界面的 `.js`，sdist 中也有 `index.html`。","locale":"zh-CN"},"3597":{"id":"/docs/development-release-89","page_id":"/docs/development-release","tags":[],"type":"text","url":"/docs/development-release#buildyml","content":"在一个独立的虚拟环境中安装 wheel，运行 `hoshimi version` 和 `smoke_install.py`。","locale":"zh-CN"},"3598":{"id":"/docs/development-release-90","page_id":"/docs/development-release","tags":[],"type":"text","url":"/docs/development-release#buildyml","content":"从 sdist 重新构建 wheel，安装到另一个虚拟环境，再运行 `smoke_install.py`。","locale":"zh-CN"},"3599":{"id":"/docs/development-release-91","page_id":"/docs/development-release","tags":[],"type":"text","url":"/docs/development-release#buildyml","content":"把 `dist/` 上传为 `distributions` 产物，保留 14 天。","locale":"zh-CN"},"3600":{"id":"/docs/development-release-92","page_id":"/docs/development-release","tags":[],"type":"text","url":"/docs/development-release#releaseyml","content":"作业","locale":"zh-CN"},"3601":{"id":"/docs/development-release-93","page_id":"/docs/development-release","tags":[],"type":"text","url":"/docs/development-release#releaseyml","content":"条件","locale":"zh-CN"},"3602":{"id":"/docs/development-release-94","page_id":"/docs/development-release","tags":[],"type":"text","url":"/docs/development-release#releaseyml","content":"内容","locale":"zh-CN"},"3603":{"id":"/docs/development-release-95","page_id":"/docs/development-release","tags":[],"type":"text","url":"/docs/development-release#releaseyml","content":"Checks、Distribution","locale":"zh-CN"},"3604":{"id":"/docs/development-release-96","page_id":"/docs/development-release","tags":[],"type":"text","url":"/docs/development-release#releaseyml","content":"仅手动触发","locale":"zh-CN"},"3605":{"id":"/docs/development-release-97","page_id":"/docs/development-release","tags":[],"type":"text","url":"/docs/development-release#releaseyml","content":"先运行 `checks.yml` 和 `build.yml`","locale":"zh-CN"},"3606":{"id":"/docs/development-release-98","page_id":"/docs/development-release","tags":[],"type":"text","url":"/docs/development-release#releaseyml","content":"Publish to PyPI","locale":"zh-CN"},"3607":{"id":"/docs/development-release-99","page_id":"/docs/development-release","tags":[],"type":"text","url":"/docs/development-release#releaseyml","content":"引用是 `main`、`hoshimi_main` 或标签；手动触发时还要求打开 `publish` 且检查和构建都成功","locale":"zh-CN"},"3608":{"id":"/docs/development-release-100","page_id":"/docs/development-release","tags":[],"type":"text","url":"/docs/development-release#releaseyml","content":"在 `pypi` 环境中下载 `distributions` 产物，`twine upload dist/* --skip-existing --non-interactive`","locale":"zh-CN"},"3609":{"id":"/docs/development-release-101","page_id":"/docs/development-release","tags":[],"type":"text","url":"/docs/development-release#releaseyml","content":"GitHub release","locale":"zh-CN"},"3610":{"id":"/docs/development-release-102","page_id":"/docs/development-release","tags":[],"type":"text","url":"/docs/development-release#releaseyml","content":"发布成功且引用是标签","locale":"zh-CN"},"3611":{"id":"/docs/development-release-103","page_id":"/docs/development-release","tags":[],"type":"text","url":"/docs/development-release#releaseyml","content":"以标签为名创建 GitHub 发布并附上这些文件，说明自动生成；发布已存在时用 `--clobber` 重新上传文件","locale":"zh-CN"},"3612":{"id":"/docs/development-release-104","page_id":"/docs/development-release","tags":[],"type":"text","url":"/docs/development-release#releaseyml","content":"发布按 `hoshimi-pypi-release` 组排队，从不取消，所以一次版本推送和随后的标签推送不会同时上传。","locale":"zh-CN"},"3613":{"id":"/docs/development-release-105","page_id":"/docs/development-release","tags":[],"type":"text","url":"/docs/development-release#改版本号","content":"修改 `hoshimi/version.py` 的 `VERSION`，并让 `hoshimi/webui/package.json` 的 `version` 跟上。按惯例，提交信息为 `chore: release x.y.z`。","locale":"zh-CN"},"3614":{"id":"/docs/development-release-106","page_id":"/docs/development-release","tags":[],"type":"text","url":"/docs/development-release#推送到-main","content":"CI 检查、构建、在安装后检查，然后把这些文件上传到 PyPI。在 Actions 中可以看到 Release 作业；`pypi` 环境若配置了审批，要在这里批准。","locale":"zh-CN"},"3615":{"id":"/docs/development-release-107","page_id":"/docs/development-release","tags":[],"type":"text","url":"/docs/development-release#推送标签可选","content":"标签会再运行一次 CI：检查标签与版本号一致，上传时跳过 PyPI 上已有的文件，然后创建带有发行包和自动生成说明的 GitHub 发布。","locale":"zh-CN"},"3616":{"id":"/docs/development-release-108","page_id":"/docs/development-release","tags":[],"type":"text","url":"/docs/development-release#手动运行-release","content":"在 Actions 中手动运行 **Release** 工作流时，它先运行同样的检查和构建。输入 `publish` 默认关闭，此时只产出检查过的文件，可以下载 `distributions` 产物查看；打开它并在 `main`、`hoshimi_main` 或标签上运行，才会发布。","locale":"zh-CN"},"3617":{"id":"/docs/development-release-109","page_id":"/docs/development-release","tags":[],"type":"text","url":"/docs/development-release#凭据","content":"上传使用 PyPI API 令牌：在 `pypi` 环境或仓库的机密中设置 `TWINE_PASSWORD`（用户名固定为 `__token__`）。没有设置时，发布作业给出错误并失败。","locale":"zh-CN"},"3618":{"id":"/docs/development-release-110","page_id":"/docs/development-release","tags":[],"type":"text","url":"/docs/development-release#文档站的部署","content":"本站（`site/`）与发行包分开部署：","locale":"zh-CN"},"3619":{"id":"/docs/development-release-111","page_id":"/docs/development-release","tags":[],"type":"text","url":"/docs/development-release#文档站的部署","content":"**Netlify**（主站，hoshimi-dev.netlify.app）：每次推送到 `main` 都构建 `site/`，配置在仓库根目录的 `netlify.toml`；`site/` 没有改动时跳过构建。","locale":"zh-CN"},"3620":{"id":"/docs/development-release-112","page_id":"/docs/development-release","tags":[],"type":"text","url":"/docs/development-release#文档站的部署","content":"**GitHub Pages**（备份，licyk.github.io/Hoshimi）：`.github/workflows/site.yml` 以 `VITE_BASE_PATH=/Hoshimi/` 构建站点，并强制推送到 `gh-pages` 分支，由 Pages 提供服务。备份站的页面带有指向 Netlify 站点的 canonical 链接。","locale":"zh-CN"},"3621":{"id":"/docs/development-release-113","page_id":"/docs/development-release","tags":[],"type":"text","url":"/docs/development-release#文档站的部署","content":"CI 的共享检查也会对文档站做类型检查、测试和构建，所以一个让站点构建失败的改动过不了 CI。","locale":"zh-CN"},"3622":{"id":"/docs/development-release-114","page_id":"/docs/development-release","tags":[],"type":"text","url":"/docs/development-release#文档站的部署","content":"站点的结构、写法和本地构建见文档站。","locale":"zh-CN"},"3623":{"id":"/docs/development-setup","page_id":"/docs/development-setup","type":"page","content":"开发环境","breadcrumbs":["Hoshimi 文档","开发文档"],"tags":[],"url":"/docs/development-setup","locale":"zh-CN"},"3
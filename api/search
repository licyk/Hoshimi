n/docs/development-providers","tags":[],"type":"text","url":"/en/docs/development-providers#the-normalized-chunk-protocol","content":"Once any chunk has gone out, the pool never retries on another account, or the client would receive the content twice.","locale":"en"},"11121":{"id":"/en/docs/development-providers-136","page_id":"/en/docs/development-providers","tags":[],"type":"text","url":"/en/docs/development-providers#the-normalized-chunk-protocol","content":"OpenAI-compatible stations need not parse their stream: `consume_openai_sse(lines, provider=...)` in `providers/openai_compat.py` turns OpenAI-style SSE into the chunks above, and `read_body` also copes with an upstream that answers a stream request with one whole JSON document. Translation for the other protocols is in `core/translate/` (`anthropic.py`, `gemini.py`, `solo.py`, `responses.py`).","locale":"en"},"11122":{"id":"/en/docs/development-providers-137","page_id":"/en/docs/development-providers","tags":[],"type":"text","url":"/en/docs/development-providers#errors-and-account-rotation","content":"An adapter reports an upstream refusal with a `ProviderError` subclass, and the pool decides what comes next by its type:","locale":"en"},"11123":{"id":"/en/docs/development-providers-138","page_id":"/en/docs/development-providers","tags":[],"type":"text","url":"/en/docs/development-providers#errors-and-account-rotation","content":"Exception","locale":"en"},"11124":{"id":"/en/docs/development-providers-139","page_id":"/en/docs/development-providers","tags":[],"type":"text","url":"/en/docs/development-providers#errors-and-account-rotation","content":"Code","locale":"en"},"11125":{"id":"/en/docs/development-providers-140","page_id":"/en/docs/development-providers","tags":[],"type":"text","url":"/en/docs/development-providers#errors-and-account-rotation","content":"What the pool does","locale":"en"},"11126":{"id":"/en/docs/development-providers-141","page_id":"/en/docs/development-providers","tags":[],"type":"tex
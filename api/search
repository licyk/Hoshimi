ype":"text","url":"/en/docs/development-site#writing-mdx","content":"Keys are written `<kbd>Ctrl</kbd>`.","locale":"en"},"11505":{"id":"/en/docs/development-site-66","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#links","content":"Link other pages as `/docs/<slug>`, with no language prefix and no `.mdx`, written the same in both languages; add `#anchor` when needed. Anchors come from the heading text, so preferably link only to headings you wrote yourself.","locale":"en"},"11506":{"id":"/en/docs/development-site-67","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#links","content":"Link source files as `https://github.com/licyk/Hoshimi/blob/main/<path>`.","locale":"en"},"11507":{"id":"/en/docs/development-site-68","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#the-code-is-the-reference","content":"Every statement must be backed by the code; when old documentation or memory disagrees with the code, the code wins. What cannot be confirmed is left out.","locale":"en"},"11508":{"id":"/en/docs/development-site-69","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#the-code-is-the-reference","content":"Page content","locale":"en"},"11509":{"id":"/en/docs/development-site-70","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#the-code-is-the-reference","content":"Backed by","locale":"en"},"11510":{"id":"/en/docs/development-site-71","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#the-code-is-the-reference","content":"Config keys and defaults","locale":"en"},"11511":{"id":"/en/docs/development-site-72","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#the-code-is-the-reference","content":"`hoshimi/core/config.py`, `hoshimi/core/paths.py`, `config.example.json`","locale":"en"},"11512":{"id":"/en/docs/development-site-73","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#the-code-is-the-reference","content":"Commands and options","locale":"en"},"11513":{"id":"/en/docs/development-site-74","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#the-code-is-the-reference","content":"`hoshimi/cli/`; `hoshimi <command> --help`","locale":"en"},"11514":{"id":"/en/docs/development-site-75","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#the-code-is-the-reference","content":"Environment variables","locale":"en"},"11515":{"id":"/en/docs/development-site-76","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#the-code-is-the-reference","content":"`hoshimi env`","locale":"en"},"11516":{"id":"/en/docs/development-site-77","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#the-code-is-the-reference","content":"Endpoints","locale":"en"},"11517":{"id":"/en/docs/development-site-78","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#the-code-is-the-reference","content":"`hoshimi/api/routers/`; a running server's `/docs` and `/openapi.json`","locale":"en"},"11518":{"id":"/en/docs/development-site-79","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#the-code-is-the-reference","content":"Provider registration and account fields","locale":"en"},"11519":{"id":"/en/docs/development-site-80","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#the-code-is-the-reference","content":"`hoshimi/core/providers/factory.py`, `hoshimi/core/provider_forms.py`, `hoshimi/core/provider_definitions.py`","locale":"en"},"11520":{"id":"/en/docs/development-site-81","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#the-code-is-the-reference","content":"Web UI text","locale":"en"},"11521":{"id":"/en/docs/development-site-82","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#the-code-is-the-reference","content":"The labels in `hoshimi/webui/src/i18n/en.ts` on English pages and in `zh-CN.ts` on Chinese pages, in bold","locale":"en"},"11522":{"id":"/en/docs/development-site-83","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#the-code-is-the-reference","content":"To read command-line help, use a temporary data folder so the real one is untouched:","locale":"en"},"11523":{"id":"/en/docs/development-site-84","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#the-code-is-the-reference","content":"As for writing: be task-oriented; say what to do and why first, then the details. A reference page is complete (every command, key, endpoint); a guide walks through real tasks. Prefer examples the reader can copy: commands, JSON, curl.","locale":"en"},"11524":{"id":"/en/docs/development-site-85","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#the-generated-page","content":"The Provider inventory (`providers-inventory.mdx` and `providers-inventory.en.mdx`) is generated by a script from `hoshimi/core/provider_sources.py`; do not edit it by hand:","locale":"en"},"11525":{"id":"/en/docs/development-site-86","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#the-generated-page","content":"Both languages share one table; only the words around it differ. Run it again after changing `provider_sources.py`, and commit both generated files.","locale":"en"},"11526":{"id":"/en/docs/development-site-87","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#deployment","content":"Site","locale":"en"},"11527":{"id":"/en/docs/development-site-88","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#deployment","content":"Address","locale":"en"},"11528":{"id":"/en/docs/development-site-89","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#deployment","content":"How","locale":"en"},"11529":{"id":"/en/docs/development-site-90","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#deployment","content":"Main","locale":"en"},"11530":{"id":"/en/docs/development-site-91","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#deployment","content":"hoshimi-dev.netlify.app","locale":"en"},"11531":{"id":"/en/docs/development-site-92","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#deployment","content":"Netlify builds `site/` on every push to `main`, configured by `netlify.toml` at the repository root; it skips builds when `site/` did not change","locale":"en"},"11532":{"id":"/en/docs/development-site-93","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#deployment","content":"Backup","locale":"en"},"11533":{"id":"/en/docs/development-site-94","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#deployment","content":"licyk.github.io/Hoshimi","locale":"en"},"11534":{"id":"/en/docs/development-site-95","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#deployment","content":"`.github/workflows/site.yml` builds with `VITE_BASE_PATH=/Hoshimi/` and force-pushes the output to the `gh-pages` branch (with the `GITEE_RSA_PRIVATE_KEY` deploy key), which Pages serves","locale":"en"},"11535":{"id":"/en/docs/development-site-96","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#deployment","content":"The site can live under a sub-path: `VITE_BASE_PATH` sets Vite's `base`, and the routes and the search index follow it. Pages on the backup carry a canonical link to the Netlify site, so search engines treat the main site as the original. CI's shared checks also type-check, test and build the site.","locale":"en"},"11536":{"id":"/en/docs/development-site-97","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#analytics-and-comments","content":"**Analytics**: the site uses Umami, loaded in production builds only and counted on the two site domains alone; local previews are not counted.","locale":"en"},"11537":{"id":"/en/docs/development-site-98","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#analytics-and-comments","content":"**Comments**: every documentation page ends with Giscus comments (`components/docs-comments.tsx`, `lib/giscus.ts`, as rvc-next's site), backed by this repository's GitHub Discussions in the \"Comment\" category. Each page has one discussion thread, mapped `specific` on the page path with the base path, the language prefix and the slashes around it dropped (`docs/<slug>`), so a page's Chinese and English versions, on the main site (at the root) and the backup (under `/Hoshimi/`) alike, share one thread. The comments follow the site's theme and language, which are posted to the loaded comments frame rather than reloading it.","locale":"en"},"11538":{"id":"/en/docs/development-site-99","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#the-readme","content":"The repository's `README.md` and `README.zh-CN.md` are also the project description on PyPI, so their links are full URLs (to this site or to GitHub), never paths relative to the repository.","locale":"en"},"11539":{"id":"/en/docs/development-testing","page_id":"/en/docs/development-testing","type":"page","content":"Testing","breadcrumbs":["Hoshimi Documentation","Development"],"tags":[],"url":"/en/docs/development-testing","locale":"en"},"11540":{"id":"/en/docs/development-testing-0","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing","content":"Every kind of check in Hoshimi: the pytest layout and shared fixtures, how provider and route tests are written, the Web UI's Vitest rule tests, the generated-type check, check_layout.py for sideways overflow in real browsers, and how CI runs them.","locale":"en"},"11541":{"id":"/en/docs/development-testing-1","page_id":"/en/docs/development-testing","type":"heading","tags":[],"url":"/en/docs/development-testing#at-a-glance","content":"At a glance","locale":"en"},"11542":{"id":"/en/docs/development-testing-2","page_id":"/en/docs/development-testing","type":"heading","tags":[],"url":"/en/docs/development-testing#python-tests","content":"Python tests","locale":"en"},"11543":{"id":"/en/docs/development-testing-3","page_id":"/en/docs/development-testing","type":"heading","tags":[],"url":"/en/docs/development-testing#layout","content":"Layout","locale":"en"},"11544":{"id":"/en/docs/development-testing-4","page_id":"/en/docs/development-testing","type":"heading","tags":[],"url":"/en/docs/development-testing#shared-fixtures","content":"Shared fixtures","locale":"en"},"11545":{"id":"/en/docs/development-testing-5","page_id":"/en/docs/development-testing","type":"heading","tags":[],"url":"/en/docs/development-testing#common-patterns","content":"Common patterns","locale":"en"},"11546":{"id":"/en/docs/development-testing-6","page_id":"/en/docs/development-testing","type":"heading","tags":[],"url":"/en/docs/development-testing#web-ui-tests","content":"Web UI tests","locale":"en"},"11547":{"id":"/en/docs/development-testing-7","page_id":"/en/docs/development-testing","type":"heading","tags":[],"url":"/en/docs/development-testing#the-generated-type-check","content":"The generated-type check","locale":"en"},"11548":{"id":"/en/docs/development-testi
glance","content":"Documentation site","locale":"en"},"11625":{"id":"/en/docs/development-testing-33","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#at-a-glance","content":"`python scripts/dev.py test-site`","locale":"en"},"11626":{"id":"/en/docs/development-testing-34","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#at-a-glance","content":"The docs site's tests and type-check; see Documentation site","locale":"en"},"11627":{"id":"/en/docs/development-testing-35","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#layout","content":"pytest is configured in `pyproject.toml`: `testpaths = [\"tests\"]`, skipping `tests/_pytest_tmp` and `tests/_tmp`, which sandboxed runs leave behind.","locale":"en"},"11628":{"id":"/en/docs/development-testing-36","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#layout","content":"Path","locale":"en"},"11629":{"id":"/en/docs/development-testing-37","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#layout","content":"Contents","locale":"en"},"11630":{"id":"/en/docs/development-testing-38","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#layout","content":"`tests/core/`","locale":"en"},"11631":{"id":"/en/docs/development-testing-39","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#layout","content":"Domain logic without HTTP: every provider adapter, normalized chunks, routing, protocol translation, reasoning effort, failure classification and backoff, catalogues, usage and the database, renewal, logins, the Playground's tools and patches, and the layering rule (`test_architecture.py`)","locale":"en"},"11632":{"id":"/en/docs/development-testing-40","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#layout","content":"`tests/api/`","locale":"en"},"11633":{"id":"/en/docs/development-testing-41","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#layout","content":"Routes through `TestClient`: Chat Completions, Responses, Messages (including the official Anthropic SDK), heartbeats, the management API, auth boundaries, network settings, the Playground and its tools","locale":"en"},"11634":{"id":"/en/docs/development-testing-42","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#layout","content":"`tests/cli/`","locale":"en"},"11635":{"id":"/en/docs/development-testing-43","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#layout","content":"The command line (a command-tree snapshot, `--debug` on every command, reading and writing `config`), `scripts/dev.py` and `build_wheel.py`, the release plan in `scripts/ci.py`","locale":"en"},"11636":{"id":"/en/docs/development-testing-44","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#layout","content":"`tests/test_package_api.py`","locale":"en"},"11637":{"id":"/en/docs/development-testing-45","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#layout","content":"`import hoshimi` loads no server dependency; the lazily exported objects are the implementation's own","locale":"en"},"11638":{"id":"/en/docs/development-testing-46","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#layout","content":"`tests/fixtures/apply_patch/`","locale":"en"},"11639":{"id":"/en/docs/development-testing-47","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#layout","content":"`apply_patch` scenarios from Codex (codex-rs/apply-patch, Apache-2.0), one folder each","locale":"en"},"11640":{"id":"/en/docs/development-testing-48","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#layout","content":"To run part of the suite, call pytest directly (`test-py` takes no options):","locale":"en"},"11641":{"id":"/en/docs/development-testing-49","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#shared-fixtures","content":"`tests/conftest.py` provides a provider that never touches the network, and services and an app built on it:","locale":"en"},"11642":{"id":"/en/docs/development-testing-50","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#shared-fixtures","content":"Name","locale":"en"},"11643":{"id":"/en/docs/development-testing-51","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#shared-fixtures","content":"Kind","locale":"en"},"11644":{"id":"/en/docs/development-testing-52","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#shared-fixtures","content":"What it does","locale":"en"},"11645":{"id":"/en/docs/development-testing-53","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#shared-fixtures","content":"`isolated_data_dir`","locale":"en"},"11646":{"id":"/en/docs/development-testing-54","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#shared-fixtures","content":"Autouse fixture","locale":"en"},"11647":{"id":"/en/docs/development-testing-55","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#shared-fixtures","content":"Points `HOSHIMI_DATA_DIR` at the test's own `tmp_path`, so configuration and data never reach the real data folder","locale":"en"},"11648":{"id":"/en/docs/development-testing-56","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#shared-fixtures","content":"`FakeProvider`","locale":"en"},"11649":{"id":"/en/docs/development-testing-57","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#shared-fixtures","content":"`Provider` subclass, ID `fake`","locale":"en"},"11650":{"id":"/en/docs/development-testing-58","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#shared-fixtures","content":"Echoes the model and the message count: yields `text_delta` `echo:<model>:`, the count, `usage`, `finish`; its models are `fake-1` (marked free) and `fake-2`; `provider.seen` records the bodies it received","locale":"en"},"11651":{"id":"/en/docs/development-testing-59","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#shared-fixtures","content":"`make_services(*extra, **settings)`","locale":"en"},"11652":{"id":"/en/docs/development-testing-60","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#shared-fixtures","content":"Function","locale":"en"},"11653":{"id":"/en/docs/development-testing-61","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#shared-fixtures","content":"A `Services` whose `fake` provider is declared in the configuration, so a settings save rebuilds the pool as it was; providers in `extra` join the pool as `fake0`, `fake1`","locale":"en"},"11654":{"id":"/en/docs/development-testing-62","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#shared-fixtures","content":"`services`","locale":"en"},"11655":{"id":"/en/docs/development-testing-63","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#shared-fixtures","content":"Fixture","locale":"en"},"11656":{"id":"/en/docs/development-testing-64","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#shared-fixtures","content":"`make_services()`","locale":"en"},"11657":{"id":"/en/docs/development-testing-65","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#shared-fixtures","content":"`client`","locale":"en"},"11658":{"id":"/en/docs/development-testing-66","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#shared-fixtures","content":"Fixture","locale":"en"},"11659":{"id":"/en/docs/development-testing-67","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#shared-fixtures","content":"`TestClient(create_app(services, serve_ui=False), base_url=\"http://localhost\")`","locale":"en"},"11660":{"id":"/en/docs/development-testing-68","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#shared-fixtures","content":"`FakeProvider` is registered in `PROVIDER_CLASSES[\"fake\"]`; without that, the rebuild after a settings save would drop `fake` as an unknown provider.","locale":"en"},"11661":{"id":"/en/docs/development-testing-69","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#shared-fixtures","content":"A route test looks like this:","locale":"en"},"11662":{"id":"/en/docs/development-testing-70","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#common-patterns","content":"**Provider adapters**: build the adapter's client on `httpx.MockTransport` and check the request's address, headers and body, and the chunk types `stream_raw` yields. There is an example in Provider adapters.","locale":"en"},"11663":{"id":"/en/docs/development-testing-71","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#common-patterns","content":"**Anthropic Messages**: `tests/api/test_native_messages.py` drives the gateway with the official Anthropic SDK's JSON and stream helpers (the SDK is in the `dev` extra), against a local mock transport, so no real credentials are needed. `tests/api/test_messages_heartbeat.py` separately checks the heartbeat timing, that heartbeats never split a whole SSE frame, and that the upstream is released when the client goes away. To try a configured gateway with real Claude Code, see Claude Code.","locale":"en"},"11664":{"id":"/en/docs/development-testing-72","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#common-patterns","content":"**POSIX-only tests**: the Playground's shell and background-command tests skip on Windows (`pytest.mark.skipif(os.name == \"nt\", ...)`); usage tests that switch the local time zone skip where `time.tzset` is missing.","locale":"en"},"11665":{"id":"/en/docs/development-testing-73","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#common-patterns","content":"**Your own Services**: call `make_services(default_model=..., ...)` for particular settings; pass extra `FakeProvider`s or subclasses for several providers.","locale":"en"},"11666":{"id":"/en/docs/development-testing-74","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#web-ui-tests","content":"In `hoshimi/webui`, `bun run test` runs Vitest and `bun run typecheck` runs vue-tsc; `python scripts/dev.py test-web` runs both in turn. The environment is happy-dom; `src/test/setup.ts` supplies the `ElementInternals` that `@material/web` asks for, and `src/test/motion-zero.css` sets every motion duration to zero, so a test never waits on a transition. Vitest uses the `vmThreads` pool (worker threads race each other creating their temporary folder on Windows).","locale":"en"},"11667":{"id":"/en/docs/development-testing-75","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#web-ui-tests","content":"Tests sit next to the files they test (`*.test.ts`). Besides the component, store and query tests, a few suites check rules that apply everywhere:","locale":"en"},"11668":{"id":"/en/docs/development-testing-76","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#web-ui-tests","content":"Test","locale":"en"},"11669":{"id":"/en/docs/development-testing-77","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#web-ui-tests","content":"Rule","locale":"en"},"11670":{"id":"/en/docs/development-testing-78","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#web-ui-tests","content":"`src/layout.test.ts`","locale":"en"},"11671":{"id":"/en/docs/development-testing-79","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#web-ui-tests","content":"The layout rules: rows that can shrink, bounded lists, scrolling only through `.app-scroll`, scrollbar lanes, the bottom navigation, unstretched charts; see Web UI","locale":"en"},"11672":{"id":"/en/docs/development-testing-80","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#web-ui-tests","content":"`src/tokens.test.ts`","locale":"en"},"11673":{"id":"/en/docs/development-testing-81","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#web-ui-tests","content":"No hex colours in `.vue` and `.css` outside `src/theme/`","locale":"en"},"11674":{"id":"/en/docs/development-testing-82","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#web-ui-tests","content":"`src/imports.test.ts`","locale":"en"},"11675":{"id":"/en/docs/development-testing-83","page_id":"/en/docs/development-testing","tags":[],"type":"t
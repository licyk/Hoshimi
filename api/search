,"13114":{"id":"/en/docs/installation-12","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#requirements","content":"Python","locale":"en"},"13115":{"id":"/en/docs/installation-13","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#requirements","content":"3.10 or newer (CI checks 3.10–3.14)","locale":"en"},"13116":{"id":"/en/docs/installation-14","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#requirements","content":"Operating system","locale":"en"},"13117":{"id":"/en/docs/installation-15","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#requirements","content":"Linux, Windows, macOS","locale":"en"},"13118":{"id":"/en/docs/installation-16","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#requirements","content":"Network","locale":"en"},"13119":{"id":"/en/docs/installation-17","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#requirements","content":"PyPI to install; at run time, the upstream services you enable. A proxy can be used, see Network and proxies","locale":"en"},"13120":{"id":"/en/docs/installation-18","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#requirements","content":"Browser","locale":"en"},"13121":{"id":"/en/docs/installation-19","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#requirements","content":"Any modern browser, for the Web UI","locale":"en"},"13122":{"id":"/en/docs/installation-20","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#install","content":"Install into an environment of its own: a virtual environment, or a tool environment managed by uv or pipx.","locale":"en"},"13123":{"id":"/en/docs/installation-21","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#install","content":"Installed as a tool, the `hoshimi` command lands in uv's tool directory:","locale":"en"},"13124":{"id":"/en/docs/installation-22","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#install","content":"To install into the current virtual environment instead: `uv pip install hoshimi`.","locale":"en"},"13125":{"id":"/en/docs/installation-23","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#install","content":"`python -m hoshimi` is the same as the `hoshimi` command, which helps when `hoshimi` is not on your `PATH`. After installing, a quick check:","locale":"en"},"13126":{"id":"/en/docs/installation-24","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#optional-extras","content":"Two cloud platforms need an extra SDK; install the matching extra when you use them:","locale":"en"},"13127":{"id":"/en/docs/installation-25","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#optional-extras","content":"Extra","locale":"en"},"13128":{"id":"/en/docs/installation-26","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#optional-extras","content":"Installs","locale":"en"},"13129":{"id":"/en/docs/installation-27","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#optional-extras","content":"Needed for","locale":"en"},"13130":{"id":"/en/docs/installation-28","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#optional-extras","content":"`google`","locale":"en"},"13131":{"id":"/en/docs/installation-29","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#optional-extras","content":"`google-auth[requests]`","locale":"en"},"13132":{"id":"/en/docs/installation-30","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#optional-extras","content":"Vertex with application default credentials (ADC) or a service account file; Vertex's API key mode does not need it","locale":"en"},"13133":{"id":"/en/docs/installation-31","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#optional-extras","content":"`bedrock`","locale":"en"},"13134":{"id":"/en/docs/installation-32","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#optional-extras","content":"`boto3`","locale":"en"},"13135":{"id":"/en/docs/installation-33","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#optional-extras","content":"Amazon Bedrock, including bearer (API key) mode: decoding Bedrock's event stream needs it too","locale":"en"},"13136":{"id":"/en/docs/installation-34","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#optional-extras","content":"No other channel needs these SDKs; ordinary HTTP API channels work without them. Setting up the accounts is covered in Cloud platforms.","locale":"en"},"13137":{"id":"/en/docs/installation-35","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#upgrade","content":"Restart the server after upgrading. While the update check is on (`server.check_updates`, on by default), the server asks PyPI at startup and once a day whether a newer release exists, and shows the answer as **Latest version** in the **Server** section of the **Overview** page.","locale":"en"},"13138":{"id":"/en/docs/installation-36","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#upgrade","content":"Configuration and data live in the data folder, which an upgrade leaves alone. Two things to know when upgrading from an older release (details in Data folder):","locale":"en"},"13139":{"id":"/en/docs/installation-37","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#upgrade","content":"The `--config` option and the `HOSHIMI_CONFIG` environment variable are gone, and a configuration file in the working directory is neither read nor migrated. Before starting the new release, move the old file to the path that `hoshimi config path` prints.","locale":"en"},"13140":{"id":"/en/docs/installation-38","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#upgrade","content":"On the first start, old `stats.json`, `checkin.json` and `probe.json` files are imported into the `hoshimi.db` database and renamed to `*.migrated`.","locale":"en"},"13141":{"id":"/en/docs/installation-39","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#install-from-source","content":"A source checkout has no built Web UI. Build it once with Bun:","locale":"en"},"13142":{"id":"/en/docs/installation-40","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#install-from-source","content":"Without a Web UI build, the server logs a warning and serves the API only. The development setup (dev dependencies, a hot-reloading UI) is in Development setup.","locale":"en"},"13143":{"id":"/en/docs/installation-41","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#ports-and-addresses","content":"`hoshimi serve` listens on `127.0.0.1:10600` by default, reachable from this machine only.","locale":"en"},"13144":{"id":"/en/docs/installation-42","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#ports-and-addresses","content":"**When the port is taken**: the server binds the socket itself, so the port it tested is the port it serves. If the requested port is taken or reserved by the system, it tries the next port, up to 65535, then wraps around to the ports from 1024 up to the requested one; any other bind error (such as an address this machine does not have) fails at once. When it moves, the log says `Port 10600 is unavailable. Using port 10601.`","locale":"en"},"13145":{"id":"/en/docs/installation-43","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#ports-and-addresses","content":"**A fixed port**: when a client needs a fixed address, use `--strict-port` (or `server.strict_port: true` in the configuration). Only the requested port is tried, and if it is taken the command ends with exit code 3.","locale":"en"},"13146":{"id":"/en/docs/installation-44","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#ports-and-addresses","content":"**Any free port**: `--port 0` lets the system pick one.","locale":"en"},"13147":{"id":"/en/docs/installation-45","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#ports-and-addresses","content":"**Where to find the actual address**: the `SERVER_READY url=…` line in the terminal; `server.json` in the data folder (host, actual port, URL and process PID, removed when the server exits); and **Listening on …** under **Settings › Access › Listening address**.","locale":"en"},"13148":{"id":"/en/docs/installation-46","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#ports-and-addresses","content":"`--host` and `--port` on the command line apply to that start only. To change them for good, run `hoshimi config set server.port 11000` or edit them in **Settings › Access** (they take effect after a restart).","locale":"en"},"13149":{"id":"/en/docs/installation-47","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#ports-and-addresses","content":"With `--host` set to `0.0.0.0` or a LAN address, anyone who can reach this machine could spend your upstream accounts. Hoshimi refuses to start until both a tool access key (`server.access_token`) and allowed networks (`security.allow_cidrs`) are configured. The full procedure is in Security.","locale":"en"},"13150":{"id":"/en/docs/installation-48","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#running-in-the-background","content":"On a server or a machine without a desktop, add `--no-open` so no browser is opened. Use the system's service manager to keep it running, for example a systemd user service on Linux (`~/.config/systemd/user/hoshimi.service`):","locale":"en"},"13151":{"id":"/en/docs/installation-49","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#running-in-the-background","content":"Replace `/path/to/hoshimi` with the output of `which hoshimi`, then:","locale":"en"},"13152":{"id":"/en/docs/installation-50","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#running-in-the-background","content":"The service uses the data folder of the user it runs as; to choose the location, add `Environment=HOSHIMI_DATA_DIR=/srv/hoshimi` under `[Service]` (see Environment variables). `GET /health` needs no key and returns `{\"status\":\"ok\"}`, which makes it a liveness check:","locale":"en"},"13153":{"id":"/en/docs/installation-51","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#uninstall","content":"Uninstalling leaves the data folder in place. It holds the configuration (including channel credentials), the usage database and the Playground conversations; delete it by hand when you no longer need them:","locale":"en"},"13154":{"id":"/en/docs/installation-52","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#uninstall","content":"Platform","locale":"en"},"13155":{"id":"/en/docs/installation-53","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#uninstall","content":"Default data folder","locale":"en"},"13156":{"id":"/en/docs/installation-54","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#uninstall","content":"Linux","locale":"en"},"13157":{"id":"/en/docs/installation-55","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#uninstall","content":"`~/.local/share/hoshimi`, or `$XDG_DATA_HOME/hoshimi` when `XDG_DATA_HOME` is set","locale":"en"},"13158":{"id":"/en/docs/installation-56","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#uninstall","content":"Windows","locale":"en"},"13159":{"id":"/en/docs/installation-57","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#uninstall","content":"`%APPDATA%\\hoshimi`","locale":"en"},"13160":{"id":"/en/docs/installation-58","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#uninstall","content":"macOS","locale":"en"},"13161":{"id":"/en/docs/installation-59","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#uninstall","content":"`~/Library/Application Support/hoshimi`","locale":"en"},"13162":{"id":"/en/docs/installation-60","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation#uninstall","content":"When `HOSHIMI_DATA_DIR` is set, the data folder is wherever it points. `hoshimi config path` prints the full path of the configuration file; the folder it is in is the data folder.","locale":"en"},"13163":{"id":"/en/docs/providers-agg","page_id":"/en/docs/providers-agg","type":"page","content":"The agg aggregator","breadcrumbs":["Hoshimi Documentation","Providers"],"tags":[],"url":"/en/docs/providers-agg","locale":"en"},"13164":{"id":"/en/docs/providers-agg-0","page_id":"/en/docs/providers-agg","tags":[],"type":"text","url":"/en/docs/providers-agg","content":"Use the agg channel for any OpenAI-compatible station: give its address or one of the 22 station presets, the account fields, several stations side by side, capability declarations and free marks.","locale":"en"},"13165":{"id":"/en/docs/providers-agg-1","page_id":"/en/docs/providers-agg","type":"heading","tags":[],"url":"/en/docs/providers-agg#adding-an-account","content":"Adding an account","locale":"en"},"13166":{"id":"/en/docs/providers-agg-2","page_id":"/en/docs/providers-agg","type":"heading","tags":[],"url":"/en/docs/providers-agg#account-fields","content":"Account fields","locale":"en"},"13167":{"id":"/en/docs/providers-agg-3","page_id":"/en/docs/providers-agg","type":"heading","tags":[],"url":"/en/docs/providers-agg#station-presets","content":"Station presets","locale":"en"},"13168":{"id":"/en/docs/providers-agg-4","page_id":"/en/docs/providers-agg","type":"heading","tags":[],"url":"/en/docs/providers-agg#several-stations-in-one-channel","content":"Several stations in one channel","locale":"en"},"13169":{"id":"/en/docs/providers-agg-5","page_id":"/en/docs/providers-agg","type":"heading","tags":[],"url":"/en/docs/providers-agg#capability-declarations","content":"Capability declarations","locale":"en"},"13170":{"id":"/en/docs/providers-agg-6","page_id":"/en/docs/providers-agg","type":"heading","tags":[],"url":"/en/docs/providers-agg#free-marks","content":"Free marks","locale":"en"},"13171":{"id":"/en/docs/providers-agg-7","page_id":"/en/docs/providers-agg","type":"heading","tags":[],"url":"/en/docs/providers-agg#station-specific-handling","content":"Station-specific handling","locale":"en"},"13172":{"id":"/en/docs/providers-agg-8","page_id":"/en/docs/providers-agg","tags":[],"type":"text","url":"/en/docs/providers-agg","content":"`agg` is the generic compatible lane: one channel can hold many stations, and each account carries its own station address (`base_url`) and key. Services such as OpenRouter's free pool, SiliconFlow or SambaNova become a line of configuration rather than new code, as long as they speak OpenAI Chat Completions. The 22 most common stations are built in as presets, so you only give a name and a key.","locale":"en"},"13173":{"id":"/en/docs/providers-agg-9","page_id":"/en/docs/providers-agg","tags":[],"type":"text","url":"/en/docs/providers-agg","content":"If the service has a native channel (for example `openrouter`, `groq`, `deepseek` or `siliconflow`), prefer that; see Local and compatible endpoints. Stations with native sign-in and renewal, such as Cline, Kilo, Qoder and OpenCode, are not presets: pointing agg at them would trade a renewable credential for a token that expires.","locale":"en"},"13174":{"id":"/en/docs/providers-agg-10","page_id":"/en/docs/providers-agg","tags":[],"type":"text","url":"/en/docs/providers-agg#adding-an-account","content":"Open **Channels** › **Aggregator** and click **Add account**.","locale":"en"},"13175":{"id":"/en/docs/providers-agg-11","page_id":"/en/docs/providers-agg","tags":[],"type":"text","url":"/en/docs/providers-agg#adding-an-account","content":"Search the **Station** list and pick a preset. For a station that is not listed, choose **Custom address…** and enter its OpenAI root in **Base URL** (the level where `/chat/completions` and `/models` live, usually ending in `/v1`).","locale":"en"},"13176":{"id":"/en/docs/providers-agg-12","page_id":"/en/docs/providers-agg","tags":[],"type":"text","url":"/en/docs/providers-agg#adding-an-account","content":"Enter the **API key**. Leave **Account ID (optional)** blank to let the gateway name the account, then click **Save account**.","locale":"en"},"13177":{"id":"/en/docs/providers-agg-13","page_id":"/en/docs/providers-agg","tags":[],"type":"text","url":"/en/docs/providers-agg#adding-an-account","content":"The form is validated before saving: an account with no address, an unknown preset or no key is not saved.","locale":"en"},"13178":{"id":"/en/docs/providers-agg-14","page_id":"/en/docs/providers-agg","tags":[],"type":"text","url":"/en/docs/providers-agg#adding-an-account","content":"Restart after editing the file. An account with no address, an unknown preset or no key is logged at startup (`agg: dropping accounts without base_url or key`) and dropped; the other accounts keep working.","locale":"en"},"13179":{"id":"/en/docs/providers-agg-15","page_id":"/en/docs/providers-agg","tags":[],"type":"text","url":"/en/docs/providers-agg#account-fields","content":"Field","locale":"en"},"13180":{"id":"/en/docs/providers-agg-16","page_id":"/en/docs/providers-agg","tags":[],"type":"text","url":"/en/docs/providers-agg#account-fields","content":"Meaning","locale":"en"},"13181":{"id":"/en/docs/providers-agg-17","page_id":"/en/docs/providers-agg","tags":[],"type":"text","url":"/en/docs/providers-agg#account-fields","content":"`id`","locale":"en"},"13182":{"id":"/en/docs/providers-agg-18","page_id":"/en/docs/providers-agg","tags":[],"type":"text","url":"/en/docs/providers-agg#account-fields","content":"The account's name.","locale":"en"},"13183":{"id":"/en/docs/providers-agg-19","page_id":"/en/docs/providers-agg","tags":[],"type":"text","url":"/en/docs/providers-agg#account-fields","content":"`base_url`","locale":"en"},"13184":{"id":"/en/docs/providers-agg-20","page_id":"/en/docs/providers-agg","tags":[],"type":"text","url":"/en/docs/providers-agg#account-fields","content":"The station's OpenAI root. When both are given, `base_url` wins over `preset`.","locale":"en"},"13185":{"id":"/en/docs/providers-agg-21","page_id":"/en/docs/providers-agg","tags":[],"type":"text","url":"/en/docs/providers-agg#account-fields","content":"`preset`","locale":"en"},"13186":{"id":"/en/docs/providers-agg-22","page_id":"/en/docs/providers-agg","tags":[],"type":"text","url":"/en/docs/providers-agg#account-fields","content":"A preset station ID (see the table below), in place of `base_url`.","locale":"en"},"13187":{"id":"/en/docs/providers-agg-23","page_id":"/en/docs/providers-agg","tags":[],"type":"text","url":"/en/docs/providers-agg#account-fields","content":"`api_key`","locale":"en"},"13188":{"id":"/en/docs/providers-agg-24","page_id":"/en/docs/providers-agg","tags":[],"type":"text","url":"/en/docs/providers-agg#account-fields","content":"The key, sent as `Authorization: Bearer`. `access_token` or `token` are also accepted.","locale":"en"},"13189":{"id":"/en/d
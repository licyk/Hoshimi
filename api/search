e-usage-101","page_id":"/en/docs/guide-usage","tags":[],"type":"text","url":"/en/docs/guide-usage#calls","content":"**TTFT**","locale":"en"},"12975":{"id":"/en/docs/guide-usage-102","page_id":"/en/docs/guide-usage","tags":[],"type":"text","url":"/en/docs/guide-usage#calls","content":"From receiving the request to the first token","locale":"en"},"12976":{"id":"/en/docs/guide-usage-103","page_id":"/en/docs/guide-usage","tags":[],"type":"text","url":"/en/docs/guide-usage#calls","content":"**Duration**","locale":"en"},"12977":{"id":"/en/docs/guide-usage-104","page_id":"/en/docs/guide-usage","tags":[],"type":"text","url":"/en/docs/guide-usage#calls","content":"The whole call","locale":"en"},"12978":{"id":"/en/docs/guide-usage-105","page_id":"/en/docs/guide-usage","tags":[],"type":"text","url":"/en/docs/guide-usage#calls","content":"**tok/s**","locale":"en"},"12979":{"id":"/en/docs/guide-usage-106","page_id":"/en/docs/guide-usage","tags":[],"type":"text","url":"/en/docs/guide-usage#calls","content":"Generation speed","locale":"en"},"12980":{"id":"/en/docs/guide-usage-107","page_id":"/en/docs/guide-usage","tags":[],"type":"text","url":"/en/docs/guide-usage#calls","content":"**Status**","locale":"en"},"12981":{"id":"/en/docs/guide-usage-108","page_id":"/en/docs/guide-usage","tags":[],"type":"text","url":"/en/docs/guide-usage#calls","content":"**Served** or **Failed**","locale":"en"},"12982":{"id":"/en/docs/guide-usage-109","page_id":"/en/docs/guide-usage","tags":[],"type":"text","url":"/en/docs/guide-usage#calls","content":"**Search calls**: searches the model, provider, account, error code, error message and finish reason (case-insensitive).","locale":"en"},"12983":{"id":"/en/docs/guide-usage-110","page_id":"/en/docs/guide-usage","tags":[],"type":"text","url":"/en/docs/guide-usage#calls","content":"**Failed only**: only calls that failed.","locale":"en"},"12984":{"id":"/en/docs/guide-usage-111","page_id":"/en/docs/guide-usage","tags":[],"type":"text","url":"/en/docs/guide-usage#calls","content":"Click a row to open **Call details**:","locale":"en"},"12985":{"id":"/en/docs/guide-usage-112","page_id":"/en/docs/guide-usage","tags":[],"type":"text","url":"/en/docs/guide-usage#calls","content":"The model and status at the top; for a failure, the error code and a short error message.","locale":"en"},"12986":{"id":"/en/docs/guide-usage-113","page_id":"/en/docs/guide-usage","tags":[],"type":"text","url":"/en/docs/guide-usage#calls","content":"**Time**, **Model**, **Provider**, **Account**, **API**, **Effort**, **Response** (**Streamed** or **Whole**), **Accounts tried** (how many accounts the rotation went through), **Finish reason**.","locale":"en"},"12987":{"id":"/en/docs/guide-usage-114","page_id":"/en/docs/guide-usage","tags":[],"type":"text","url":"/en/docs/guide-usage#calls","content":"Tokens: an **Input by cache use** bar, then **Input tokens**, **Uncached input**, **Cache read** (with its share), **Cache write**, **Output tokens**, **Reasoning tokens**. **no usage reported** when the upstream did not report usage.","locale":"en"},"12988":{"id":"/en/docs/guide-usage-115","page_id":"/en/docs/guide-usage","tags":[],"type":"text","url":"/en/docs/guide-usage#calls","content":"**Timing**: **TTFT**, **Decode**, **Duration**, **tok/s**.","locale":"en"},"12989":{"id":"/en/docs/guide-usage-116","page_id":"/en/docs/guide-usage","tags":[],"type":"text","url":"/en/docs/guide-usage#calls","content":"The arrows at the top right of the sheet (or the ↑ and ↓ keys) step to the **Newer call** and **Older call**.","locale":"en"},"12990":{"id":"/en/docs/guide-usage-117","page_id":"/en/docs/guide-usage","tags":[],"type":"text","url":"/en/docs/guide-usage#what-counts-as-a-call-and-as-a-failure","content":"Each Chat Completions, Responses, Messages, classification and Playground request is one record, however many accounts it went through.","locale":"en"},"12991":{"id":"/en/docs/guide-usage-118","page_id":"/en/docs/guide-usage","tags":[],"type":"text","url":"/en/docs/guide-usage#what-counts-as-a-call-and-as-a-failure","content":"A request that errors is a failure, including a routing error that fails before reaching any upstream (such as an unknown model). A client that disconnects midway counts as served, not as a gateway failure.","locale":"en"},"12992":{"id":"/en/docs/guide-usage-119","page_id":"/en/docs/guide-usage","tags":[],"type":"text","url":"/en/docs/guide-usage#what-counts-as-a-call-and-as-a-failure","content":"Cache writes are read from `prompt_tokens_details.cache_write_tokens` (or `cache_creation_tokens`, or Anthropic's `cache_creation_input_tokens`); DeepSeek's `prompt_cache_hit_tokens` counts as a cache read.","locale":"en"},"12993":{"id":"/en/docs/guide-usage-120","page_id":"/en/docs/guide-usage","tags":[],"type":"text","url":"/en/docs/guide-usage#how-long-data-is-kept","content":"Data","locale":"en"},"12994":{"id":"/en/docs/guide-usage-121","page_id":"/en/docs/guide-usage","tags":[],"type":"text","url":"/en/docs/guide-usage#how-long-data-is-kept","content":"Kept for","locale":"en"},"12995":{"id":"/en/docs/guide-usage-122","page_id":"/en/docs/guide-usage","tags":[],"type":"text","url":"/en/docs/guide-usage#how-long-data-is-kept","content":"Each call's record","locale":"en"},"12996":{"id":"/en/docs/guide-usage-123","page_id":"/en/docs/guide-usage","tags":[],"type":"text","url":"/en/docs/guide-usage#how-long-data-is-kept","content":"`server.stats_keep_days` days (default 90); change it in **Settings › General › Usage history**","locale":"en"},"12997":{"id":"/en/docs/guide-usage-124","page_id":"/en/docs/guide-usage","tags":[],"type":"text","url":"/en/docs/guide-usage#how-long-data-is-kept","content":"Hourly totals","locale":"en"},"12998":{"id":"/en/docs/guide-usage-125","page_id":"/en/docs/guide-usage","tags":[],"type":"text","url":"/en/docs/guide-usage#how-long-data-is-kept","content":"120 days","locale":"en"},"12999":{"id":"/en/docs/guide-usage-126","page_id":"/en/docs/guide-usage","tags":[],"type":"text","url":"/en/docs/guide-usage#how-long-data-is-kept","content":"Daily totals and lifetime counters","locale":"en"},"13000":{"id":"/en/docs/guide-usage-127","page_id":"/en/docs/guide-usage","tags":[],"type":"text","url":"/en/docs/guide-usage#how-long-data-is-kept","content":"Forever","locale":"en"},"13001":{"id":"/en/docs/guide-usage-128","page_id":"/en/docs/guide-usage","tags":[],"type":"text","url":"/en/docs/guide-usage#how-long-data-is-kept","content":"A new keep period applies from the next pruning, which runs with newly recorded calls at most once a minute. Statistics are written to the database about once a second, and on shutdown.","locale":"en"},"13002":{"id":"/en/docs/guide-usage-129","page_id":"/en/docs/guide-usage","tags":[],"type":"text","url":"/en/docs/guide-usage#reset-statistics","content":"**Reset statistics** in the ⋮ menu clears every counter, chart and recorded call, after you confirm **Reset all usage statistics?**. **It cannot be undone.** Calls in flight at the time are still recorded when they end.","locale":"en"},"13003":{"id":"/en/docs/guide-usage-130","page_id":"/en/docs/guide-usage","tags":[],"type":"text","url":"/en/docs/guide-usage#reset-statistics","content":"A reset deletes all usage data in `hoshimi.db`. To keep fewer records, lower **Keep calls for (days)** instead.","locale":"en"},"13004":{"id":"/en/docs/guide","page_id":"/en/docs/guide","type":"page","content":"Web UI overview","breadcrumbs":["Hoshimi Documentation","Web UI guides"],"tags":[],"url":"/en/docs/guide","locale":"en"},"13005":{"id":"/en/docs/guide-0","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide","content":"How the Web UI is laid out: the navigation, live activity in the top bar, signing in with the access key, language and appearance, and the guide to each page.","locale":"en"},"13006":{"id":"/en/docs/guide-1","page_id":"/en/docs/guide","type":"heading","tags":[],"url":"/en/docs/guide#navigation","content":"Navigation","locale":"en"},"13007":{"id":"/en/docs/guide-2","page_id":"/en/docs/guide","type":"heading","tags":[],"url":"/en/docs/guide#top-bar","content":"Top bar","locale":"en"},"13008":{"id":"/en/docs/guide-3","page_id":"/en/docs/guide","type":"heading","tags":[],"url":"/en/docs/guide#access-key","content":"Access key","locale":"en"},"13009":{"id":"/en/docs/guide-4","page_id":"/en/docs/guide","type":"heading","tags":[],"url":"/en/docs/guide#language-and-appearance","content":"Language and appearance","locale":"en"},"13010":{"id":"/en/docs/guide-5","page_id":"/en/docs/guide","type":"heading","tags":[],"url":"/en/docs/guide#how-the-model-catalogue-loads","content":"How the model catalogue loads","locale":"en"},"13011":{"id":"/en/docs/guide-6","page_id":"/en/docs/guide","type":"heading","tags":[],"url":"/en/docs/guide#guides-to-each-page","content":"Guides to each page","locale":"en"},"13012":{"id":"/en/docs/guide-7","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide","content":"This section walks through Hoshimi's Web UI page by page. Start `hoshimi serve` and open `http://127.0.0.1:10600` in a browser (if the port was taken, use the address the server prints). If Hoshimi is not installed yet, start with Quick start; for what you see the first time, see First run.","locale":"en"},"13013":{"id":"/en/docs/guide-8","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide","content":"Changes you make on **Channels** and **Settings** (other than browser preferences such as appearance and language) are written to `config.json` in the data folder and take effect in the running gateway at once, without a restart (the listening address and port are the exception). Most of it can also be done from the command line or the management API.","locale":"en"},"13014":{"id":"/en/docs/guide-9","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"On a wide window the navigation is a rail on the left; on a narrow one (a phone) it moves to the bottom. **Settings** sits at the foot of the rail.","locale":"en"},"13015":{"id":"/en/docs/guide-10","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"Page","locale":"en"},"13016":{"id":"/en/docs/guide-11","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"What it is for","locale":"en"},"13017":{"id":"/en/docs/guide-12","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"**Overview**","locale":"en"},"13018":{"id":"/en/docs/guide-13","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"Today's usage, endpoint addresses to copy, the channels in use, version and default model","locale":"en"},"13019":{"id":"/en/docs/guide-14","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"**Models**","locale":"en"},"13020":{"id":"/en/docs/guide-15","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"Every model you can call: search, abilities, context length, availability probes, and a shortcut to try one in the Playground","locale":"en"},"13021":{"id":"/en/docs/guide-16","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"**Channels**","locale":"en"},"13022":{"id":"/en/docs/guide-17","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"The accounts of every provider (free stations, cloud services, local servers): sign-in, API keys, renewal, check-in, allowance and network route","locale":"en"},"13023":{"id":"/en/docs/guide-18","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"**Usage**","locale":"en"},"13024":{"id":"/en/docs/guide-19","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"Charts of tokens, cache hits, time to first token and speed, breakdowns by model, provider, account and API, and a record of every call","locale":"en"},"13025":{"id":"/en/docs/guide-20","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"**Playground**","locale":"en"},"13026":{"id":"/en/docs/guide-21","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"Chat with any model in the browser; with tools turned on it can also read and edit files, run commands and search the web","locale":"en"},"13027":{"id":"/en/docs/guide-22","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"**Settings**","locale":"en"},"13028":{"id":"/en/docs/guide-23","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"Language, default model, Playground and tools, listening address and keys, access limits, global network, timers, appearance","locale":"en"},"13029":{"id":"/en/docs/guide-24","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"When channels need a hand (a new login, an expired token, an account held out of rotation, an allowance about to run out), the **Channels** icon shows how many.","locale":"en"},"13030":{"id":"/en/docs/guide-25","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"Each page keeps its state and scroll position while you are elsewhere, and the navigation takes you back to where you left it. Some state is part of the address, so a reload or a shared link opens the same view:","locale":"en"},"13031":{"id":"/en/docs/guide-26","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"Address","locale":"en"},"13032":{"id":"/en/docs/guide-27","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"Opens","locale":"en"},"13033":{"id":"/en/docs/guide-28","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"`#/channels/kilo`","locale":"en"},"13034":{"id":"/en/docs/guide-29","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"The Kilo channel on the **Channels** page","locale":"en"},"13035":{"id":"/en/docs/guide-30","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"`#/usage?range=30d`","locale":"en"},"13036":{"id":"/en/docs/guide-31","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"**Usage** over **30 days**","locale":"en"},"13037":{"id":"/en/docs/guide-32","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"`#/usage?range=day&date=2026-10-20`","locale":"en"},"13038":{"id":"/en/docs/guide-33","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"**Usage** for one day","locale":"en"},"13039":{"id":"/en/docs/guide-34","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"`#/settings?tab=access`","locale":"en"},"13040":{"id":"/en/docs/guide-35","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#navigation","content":"The **Access** tab of **Settings**","locale":"en"},"13041":{"id":"/en/docs/guide-36","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#top-bar","content":"Two buttons sit at the top right:","locale":"en"},"13042":{"id":"/en/docs/guide-37","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#top-bar","content":"**Live activity**: an activity icon while nothing runs; a spinner with a count (**N calls running**) while calls are in flight. Click it for the live activity sheet:","locale":"en"},"13043":{"id":"/en/docs/guide-38","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#top-bar","content":"At the top, the connection state (**Live**, **Reconnecting…**, **Offline**) and today's **Tokens today**, **Calls** and **Cache hit**.","locale":"en"},"13044":{"id":"/en/docs/guide-39","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#top-bar","content":"**Running now (N)** shows a card per call: the model, provider / account (**Choosing an account…** until one is picked), the API, the reasoning effort, how many accounts were tried, a **Waiting**, **Thinking**, **Answering** track, and **TTFT**, **Tokens out** (estimated from the streamed text, marked ≈, until the station reports its own count) and **tok/s**.","locale":"en"},"13045":{"id":"/en/docs/guide-40","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#top-bar","content":"**Just finished** lists the last 10 calls, each **Served** or **Failed**.","locale":"en"},"13046":{"id":"/en/docs/guide-41","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#top-bar","content":"**Open usage** goes to the **Usage** page.","locale":"en"},"13047":{"id":"/en/docs/guide-42","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#top-bar","content":"**Theme**: cycles between light, dark and following the system. More appearance options are in **Settings › Appearance**.","locale":"en"},"13048":{"id":"/en/docs/guide-43","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#top-bar","content":"Live activity, the **Overview** figures for today and the **Usage** page share one live connection to the server (`/api/v1/stats/live`). When it drops it reconnects by itself and starts again from a fresh snapshot, so nothing missed in between is left stale.","locale":"en"},"13049":{"id":"/en/docs/guide-44","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#access-key","content":"When the server has a tool access key (`server.access_token`), the interface opens with **Tool access key required**. Enter the key and click **Sign in**; the interface checks it with the server first, then keeps it in this browser's localStorage and does not ask again. A wrong key shows **The tool access key is incorrect.** and does not replace a key saved earlier.","locale":"en"},"13050":{"id":"/en/docs/guide-45","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#access-key","content":"When you change or clear the key in **Settings › Access**, this browser switches to the new key by itself; other browsers have to sign in again. The Playground uses the management API, so it needs only the tool access key, not the model API key. For the difference between the two keys see Access and security.","locale":"en"},"13051":{"id":"/en/docs/guide-46","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#language-and-appearance","content":"The interface follows the system language by default: English, 简体中文 and 日本語 are available, and **Settings › General › Language** fixes one. Theme, colour, contrast and motion are in **Settings › Appearance**. These are browser preferences: they are kept in the current browser, not in the server's config file.","locale":"en"},"13052":{"id":"/en/docs/guide-47","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#how-the-model-catalogue-loads","content":"**Models**, the **Playground** and the model pickers in **Settings** share one model catalogue. It arrives as a stream: cached models first, then each provider's own results as they come in, with **Loading providers: done/total** while it loads. A provider that fails or times out (after 20 seconds) is named with the reason, the models already received stay, and **Retry** loads again. See Models.","locale":"en"},"13053":{"id":"/en/docs/guide-48","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#guides-to-each-page","content":"<Card title=\"Overview\" href=\"/docs/guide-overview\" description=\"Today's usage, endpoint addresses, channels at a glance, version and updates, default model.\" />","locale":"en"},"13054":{"id":"/en/docs/guide-49","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#guides-to-each-page","content":"<Card title=\"Models\" href=\"/docs/guide-models\" description=\"The catalogue, ability marks, context length, availability probes, and trying a model in the Playground.\" />","locale":"en"},"13055":{"id":"/en/docs/guide-50","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#guides-to-each-page","content":"<Card title=\"Channels\" href=\"/docs/guide-channels\" description=\"Signing in, adding keys, renewal and expiry, balances and check-in, allowance, network per channel.\" />","locale":"en"},"13056":{"id":"/en/docs/guide-51","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#guides-to-each-page","content":"<Card title=\"Playground\" href=\"/docs/guide-playground\" description=\"Chats, history, temporary chats, branching, versions and retry, attachments and images, Copy as API request.\" />","locale":"en"},"13057":{"id":"/en/docs/guide-52","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#guides-to-each-page","content":"<Card title=\"Playground tools\" href=\"/docs/guide-agent\" description=\"The six built-in tools, approval modes, approving in the chat, steering a reply, background commands and the workspace.\" />","locale":"en"},"13058":{"id":"/en/docs/guide-53","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#guides-to-each-page","content":"<Card title=\"Usage\" href=\"/docs/guide-usage\" description=\"Ranges, headline tiles, tokens over time, speed, breakdowns and the call list.\" />","locale":"en"},"13059":{"id":"/en/docs/guide-54","page_id":"/en/docs/guide","tags":[],"type":"text","url":"/en/docs/guide#guides-to-each-page","content":"<Card title=\"Settings\" href=\"/docs/guide-settings\" description=\"General, Tools, Access, Security, Network, Automation, Appearance and About.\" />","locale":"en"},"13060":{"id":"/en/docs","page_id":"/en/docs","type":"page","content":"Hoshimi","breadcrumbs":["Hoshimi Documentation","Getting started"],"tags":[],"url":"/en/docs","locale":"en"},"13061":{"id":"/en/docs-0","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs","content":"Hoshimi is an OpenAI- and Anthropic-compatible gateway that puts free model stations, cloud services and local models behind one API and one Web UI. This page covers what it does and how the docs are organised.","locale":"en"},"13062":{"id":"/en/docs-1","page_id":"/en/docs","type":"heading","tags":[],"url":"/en/docs#what-it-does","content":"What it does","locale":"en"},"13063":{"id":"/en/docs-2","page_id":"/en/docs","type":"heading","tags":[],"url":"/en/docs#documentation-sections","content":"Documentation sections","locale":"en"},"13064":{"id":"/en/docs-3","page_id":"/en/docs","type":"heading","tags":[],"url":"/en/docs#license","content":"License","locale":"en"},"13065":{"id":"/en/docs-4","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs","content":"Hoshimi is a model gateway written in Python. It puts free model stations (Cline, TRAE, ZCode, Qoder, MiniMax, Gemini, CodeBuddy, Kilo, OpenCode Zen and more), cloud services (Azure, Cloudflare, Vertex, Bedrock, NVIDIA NIM and more) and local or self-hosted OpenAI-compatible servers behind **one local server**: a client needs one base URL and one model catalogue to call any of those models through Chat Completions, Responses or Anthropic Messages, and a multilingual Web UI manages channels and accounts, browses models, chats and shows usage.","locale":"en"},"13066":{"id":"/en/docs-5","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs","content":"Install it, run `hoshimi serve` and open `http://127.0.0.1:10600`. The anonymous OpenCode Zen and Kilo entry points are on by default, with no account and no configuration file.","locale":"en"},"13067":{"id":"/en/docs-6","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs","content":"<Card title=\"Quick start\" href=\"/docs/quick-start\" description=\"Install, start, send a first message in the Playground, then a first API request.\" />","locale":"en"},"13068":{"id":"/en/docs-7","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs","content":"<Card title=\"Installation\" href=\"/docs/installation\" description=\"Requirements, pip / uv / pipx, optional extras, upgrades, source installs and running in the background.\" />","locale":"en"},"13069":{"id":"/en/docs-8","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs","content":"<Card title=\"First run\" href=\"/docs/first-run\" description=\"What you see the first time you open the Web UI: sign-in, the default anonymous channels, where everything is.\" />","locale":"en"},"13070":{"id":"/en/docs-9","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs#what-it-does","content":"Feature","locale":"en"},"13071":{"id":"/en/docs-10","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs#what-it-does","content":"What it means","locale":"en"},"13072":{"id":"/en/docs-11","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs#what-it-does","content":"More","locale":"en"},"13073":{"id":"/en/docs-12","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs#what-it-does","content":"One API","locale":"en"},"13074":{"id":"/en/docs-13","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs#what-it-does","content":"Chat Completions, Responses, Anthropic Messages and token counting under `/v1`, plus the model list","locale":"en"},"13075":{"id":"/en/docs-14","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs#what-it-does","content":"Connecting clients","locale":"en"},"13076":{"id":"/en/docs-15","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs#what-it-does","content":"Channels and accounts","locale":"en"},"13077":{"id":"/en/docs-16","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs#what-it-does","content":"API keys, browser or device-code sign-in, automatic credential renewal, rotation across accounts, balances and daily check-in","locale":"en"},"13078":{"id":"/en/docs-17","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs#what-it-does","content":"Channels, Provider concepts","locale":"en"},"13079":{"id":"/en/docs-18","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs#what-it-does","content":"Model catalogue","locale":"en"},"13080":{"id":"/en/docs-19","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs#what-it-does","content":"Each model's abilities (reasoning, vision, tool calls), reasoning effort options and availability probes","locale":"en"},"13081":{"id":"/en/docs-20","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs#what-it-does","content":"Models, Model behaviour","locale":"en"},"13082":{"id":"/en/docs-21","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs#what-it-does","content":"Live usage","locale":"en"},"13083":{"id":"/en/docs-22","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs#what-it-does","content":"Calls in flight, token and cache breakdowns, first-token latency and generation speed, hour by hour for any day, kept in a local SQLite database","locale":"en"},"13084":{"id":"/en/docs-23","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs#what-it-does","content":"Usage","locale":"en"},"13085":{"id":"/en/docs-24","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs#what-it-does","content":"Playground","locale":"en"},"13086":{"id":"/en/docs-25","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs#what-it-does","content":"Chat with any model in the browser, optionally with built-in tools (read and edit files, run commands, search the web) that ask before they act","locale":"en"},"13087":{"id":"/en/docs-26","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs#what-it-does","content":"Playground, Playground tools","locale":"en"},"13088":{"id":"/en/docs-27","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs#what-it-does","content":"Security","locale":"en"},"13089":{"id":"/en/docs-28","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs#what-it-does","content":"Separate keys for the management UI and the model API; allowed networks, host names and origins","locale":"en"},"13090":{"id":"/en/docs-29","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs#what-it-does","content":"Security","locale":"en"},"13091":{"id":"/en/docs-30","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs#documentation-sections","content":"<Card title=\"Getting started\" href=\"/docs/quick-start\" description=\"Install, start and use it for the first time.\" />","locale":"en"},"13092":{"id":"/en/docs-31","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs#documentation-sections","content":"<Card title=\"Web UI guides\" href=\"/docs/guide\" description=\"The Web UI page by page: Overview, Models, Channels, Playground, Usage and Settings.\" />","locale":"en"},"13093":{"id":"/en/docs-32","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs#documentation-sections","content":"<Card title=\"Connecting clients\" href=\"/docs/clients\" description=\"OpenAI and Anthropic SDKs, curl, Claude Code, Codex and OpenCode.\" />","locale":"en"},"13094":{"id":"/en/docs-33","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs#documentation-sections","content":"<Card title=\"Providers\" href=\"/docs/providers\" description=\"Free stations, anonymous lanes, agg aggregators, cloud platforms, NVIDIA and local models.\" />","locale":"en"},"13095":{"id":"/en/docs-34","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs#documentation-sections","content":"<Card title=\"Command line\" href=\"/docs/cli\" description=\"The hoshimi command, every option and every environment variable.\" />","locale":"en"},"13096":{"id":"/en/docs-35","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs#documentation-sections","content":"<Card title=\"Configuration\" href=\"/docs/config\" description=\"Every config.json key, networking and proxies, security, the data folder.\" />","locale":"en"},"13097":{"id":"/en/docs-36","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs#documentation-sections","content":"<Card title=\"Advanced\" href=\"/docs/advanced-models\" description=\"Abilities and probes, retries and account rotation, usage records, EAC, migration and FAQ.\" />","locale":"en"},"13098":{"id":"/en/docs-37","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs#documentation-sections","content":"<Card title=\"API reference\" href=\"/docs/api\" description=\"The /v1 model API, the /api/v1 management API and the Playground API.\" />","locale":"en"},"13099":{"id":"/en/docs-38","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs#documentation-sections","content":"<Card title=\"Development\" href=\"/docs/development\" description=\"Repository layout, architecture, writing a provider adapter, the Web UI, testing and releases.\" />","locale":"en"},"13100":{"id":"/en/docs-39","page_id":"/en/docs","tags":[],"type":"text","url":"/en/docs#license","content":"Hoshimi is licensed under **GPL-3.0-only**. The source is on GitHub; the full text is in LICENSE.","locale":"en"},"13101":{"id":"/en/docs/installation","page_id":"/en/docs/installation","type":"page","content":"Installation","breadcrumbs":["Hoshimi Documentation","Getting started"],"tags":[],"url":"/en/docs/installation","locale":"en"},"13102":{"id":"/en/docs/installation-0","page_id":"/en/docs/installation","tags":[],"type":"text","url":"/en/docs/installation","content":"Requirements, installing with pip, uv or pipx, the optional cloud extras, upgrading and uninstalling, installing from source, running in the background, and how the port is chosen.","locale":"en"},"13103":{"id":"/en/docs/installation-1","page_id":"/en/docs/installation","type":"heading","tags":[],"url":"/en/docs/installation#requirements","content":"Requirements","locale":"en"},"13104":{"id":"/en/docs/installation-2","page_id":"/e
tion","content":"Classification","locale":"en"},"8877":{"id":"/en/docs/api-openai-13","page_id":"/en/docs/api-openai","tags":[],"type":"text","url":"/en/docs/api-openai","content":"These endpoints serve OpenAI-compatible clients at `http://127.0.0.1:10600/v1`, authenticated with the model API key (see API overview). Usage examples are in OpenAI SDKs and curl.","locale":"en"},"8878":{"id":"/en/docs/api-openai-14","page_id":"/en/docs/api-openai","tags":[],"type":"text","url":"/en/docs/api-openai","content":"Method and path","locale":"en"},"8879":{"id":"/en/docs/api-openai-15","page_id":"/en/docs/api-openai","tags":[],"type":"text","url":"/en/docs/api-openai","content":"Purpose","locale":"en"},"8880":{"id":"/en/docs/api-openai-16","page_id":"/en/docs/api-openai","tags":[],"type":"text","url":"/en/docs/api-openai","content":"`POST /v1/chat/completions`","locale":"en"},"8881":{"id":"/en/docs/api-openai-17","page_id":"/en/docs/api-openai","tags":[],"type":"text","url":"/en/docs/api-openai","content":"Chat Completions; streams when `stream` is absent","locale":"en"},"8882":{"id":"/en/docs/api-openai-18","page_id":"/en/docs/api-openai","tags":[],"type":"text","url":"/en/docs/api-openai","content":"`POST /v1/responses`","locale":"en"},"8883":{"id":"/en/docs/api-openai-19","page_id":"/en/docs/api-openai","tags":[],"type":"text","url":"/en/docs/api-openai","content":"Responses, stateless, converted to Chat internally; streams when `stream` is absent","locale":"en"},"8884":{"id":"/en/docs/api-openai-20","page_id":"/en/docs/api-openai","tags":[],"type":"text","url":"/en/docs/api-openai","content":"`GET /v1/models`","locale":"en"},"8885":{"id":"/en/docs/api-openai-21","page_id":"/en/docs/api-openai","tags":[],"type":"text","url":"/en/docs/api-openai","content":"The model catalogue","locale":"en"},"8886":{"id":"/en/docs/api-openai-22","page_id":"/en/docs/api-openai","tags":[],"type":"text","url":"/en/docs/api-openai","content":"`GET /v1/classifiers`","locale":"en"},"8887":{"id":"/en/docs/api-openai-23","page_id":"/en/docs/api-openai","tags":[],"type":"text","url":"/en/docs/api-openai","content":"Available classifiers","locale":"en"},"8888":{"id":"/en/docs/api-openai-24","page_id":"/en/docs/api-openai","tags":[],"type":"text","url":"/en/docs/api-openai","content":"`POST /v1/classify`","locale":"en"},"8889":{"id":"/en/docs/api-openai-25","page_id":"/en/docs/api-openai","tags":[],"type":"text","url":"/en/docs/api-openai","content":"Answer questions with a classifier","locale":"en"},"8890":{"id":"/en/docs/api-openai-26","page_id":"/en/docs/api-openai","tags":[],"type":"text","url":"/en/docs/api-openai","content":"The inference endpoints and `/v1/messages` share one model catalogue and the same account rotation, retries and usage recording. Every call is recorded on the **Usage** page, with the origin `chat`, `responses` or `classify`.","locale":"en"},"8891":{"id":"/en/docs/api-openai-27","page_id":"/en/docs/api-openai","tags":[],"type":"text","url":"/en/docs/api-openai#chat-completions","content":"`POST /v1/chat/completions`","locale":"en"},"8892":{"id":"/en/docs/api-openai-28","page_id":"/en/docs/api-openai","tags":[],"type":"text","url":"/en/docs/api-openai#request","content":"The body is a standard Chat Completions object. The fields Hoshimi reads itself:","locale":"en"},"8893":{"id":"/en/docs/api-openai-29","page_id":"/en/docs/api-openai","tags":[],"type":"text","url":"/en/docs/api-openai#request","content":"Field","locale":"en"},"8894":{"id":"/en/docs/api-openai-30","page_id":"/en/docs/api-openai","tags":[],"type":"text","url":"/en/docs/api-openai#request","content":"Notes","locale":"en"},"8895":{"id":"/en/docs/api-openai-31","page_id":"/en/docs/api-openai","tags":[],"type":"text","url":"/en/docs/api-openai#request","content":"`model`","locale":"en"},"8896":{"id":"/en/docs/api-openai-32","page_id":"/en/docs/api-openai","tags":[],"type":"text","url":"/en/docs/api-openai#request","content":"The model name; see \"Model routing\" below. When absent, `server.default_model` is used; with no default model either, the answer is `400` (`Missing 'model' field.`)","locale":"en"},"8897":{"id":"/en/docs/api-openai-33","page_id":"/en/docs/api-openai","tags":[],"type":"text","url":"/en/docs/api-openai#request","content":"`messages`","locale":"en"},"8898":{"id":"/en/docs/api-openai-34","page_id":"/en/docs/api-openai","tags":[],"type":"text","url":"/en/docs/api-openai#request","content":"The whole conversation; Hoshimi keeps no history","locale":"en"},"8899":{"id":"/en/docs/api-openai-35","page_id":"/en/docs/api-openai","tags":[],"type":"text","url":"/en/docs/api-openai#request","content":"`stream`","locale":"en"},"8900":{"id":"/en/docs/api-openai-36","page_id":"/en/docs/api-openai","tags":[],"type":"text","url":"/en/docs/api-openai#request","content":"Defaults to `true`. Send `false` explicitly to get one JSON object","locale":"en"},"8901":{"id":"/en/docs/api-openai-37","page_id":"/en/docs/api-openai","tags":[],"type":"text","url":"/en/docs/api-openai#request","content":"`reasoning_effort`","locale":"en"},"8902":{"id":"/en/docs/api-openai-38","page_id":"/en/docs/api-openai","tags":[],"type":"text","url":"/en/docs/api-openai#request","content":"The effort level; see \"Reasoning effort\" below","locale":"en"},"8903":{"id":"/en/docs/api-openai-39","page_id":"/en/docs/api-openai","tags":[],"type":"text","url":"/en/docs/api-openai#request","content":"`max_tokens` / `max_completion_tokens`","locale":"en"},"8904":{"id":"/en/docs/api-openai-40","page_id":"/en/docs/api-openai","tags":[],"type":"text","url":"/en/docs/api-openai#request","content":"The output ceiling; rewritten by the effort budget when an effort is given, see below","locale":"en"},"8905":{"id":"/en/docs/api-openai-41","page_id":"/en/docs/api-openai","tags":[],"type":"text","url":"/en/docs/api-openai#request","content":"`tools` / `tool_choice`","locale":"en"},"8906":{"id":"/en/docs/api-openai-42","page_id":"/en/docs/api-openai","tags":[],"type":"text","url":"/e
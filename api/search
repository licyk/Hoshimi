en"},"10383":{"id":"/en/docs/config-network-110","page_id":"/en/docs/config-network","tags":[],"type":"text","url":"/en/docs/config-network#network-diagnostics","content":"`region_restricted`","locale":"en"},"10384":{"id":"/en/docs/config-network-111","page_id":"/en/docs/config-network","tags":[],"type":"text","url":"/en/docs/config-network#network-diagnostics","content":"Region restriction","locale":"en"},"10385":{"id":"/en/docs/config-network-112","page_id":"/en/docs/config-network","tags":[],"type":"text","url":"/en/docs/config-network#network-diagnostics","content":"The station does not serve the region of this egress","locale":"en"},"10386":{"id":"/en/docs/config-network-113","page_id":"/en/docs/config-network","tags":[],"type":"text","url":"/en/docs/config-network#network-diagnostics","content":"`signature_rejected`","locale":"en"},"10387":{"id":"/en/docs/config-network-114","page_id":"/en/docs/config-network","tags":[],"type":"text","url":"/en/docs/config-network#network-diagnostics","content":"Request signature rejected","locale":"en"},"10388":{"id":"/en/docs/config-network-115","page_id":"/en/docs/config-network","tags":[],"type":"text","url":"/en/docs/config-network#network-diagnostics","content":"The station refused the request signature","locale":"en"},"10389":{"id":"/en/docs/config-network-116","page_id":"/en/docs/config-network","tags":[],"type":"text","url":"/en/docs/config-network#network-diagnostics","content":"`authentication`","locale":"en"},"10390":{"id":"/en/docs/config-network-117","page_id":"/en/docs/config-network","tags":[],"type":"text","url":"/en/docs/config-network#network-diagnostics","content":"Credentials rejected","locale":"en"},"10391":{"id":"/en/docs/config-network-118","page_id":"/en/docs/config-network","tags":[],"type":"text","url":"/en/docs/config-network#network-diagnostics","content":"HTTP 401","locale":"en"},"10392":{"id":"/en/docs/config-network-119","page_id":"/en/docs/config-network","tags":[],"type":"text","url":"/en/docs/config-network#network-diagnostics","content":"`permission_denied`","locale":"en"},"10393":{"id":"/en/docs/config-network-120","page_id":"/en/docs/config-network","tags":[],"type":"text","url":"/en/docs/config-network#network-diagnostics","content":"Permission denied","locale":"en"},"10394":{"id":"/en/docs/config-network-121","page_id":"/en/docs/config-network","tags":[],"type":"text","url":"/en/docs/config-network#network-diagnostics","content":"HTTP 403","locale":"en"},"10395":{"id":"/en/docs/config-network-122","page_id":"/en/docs/config-network","tags":[],"type":"text","url":"/en/docs/config-network#network-diagnostics","content":"`quota_exhausted`","locale":"en"},"10396":{"id":"/en/docs/config-network-123","page_id":"/en/docs/config-network","tags":[],"type":"text","url":"/en/docs/config-network#network-diagnostics","content":"Quota exhausted","locale":"en"},"10397":{"id":"/en/docs/config-network-124","page_id":"/en/docs/config-network","tags":[],"type":"text","url":"/en/docs/config-network#network-diagnostics","content":"HTTP 402","locale":"en"},"10398":{"id":"/en/docs/config-network-125","page_id":"/en/docs/config-network","tags":[],"type":"text","url":"/en/docs/config-network#network-diagnostics","content":"`rate_limited`","locale":"en"},"10399":{"id":"/en/docs/config-network-126","page_id":"/en/docs/config-network","tags":[],"type":"text","url":"/en/docs/config-network#network-diagnostics","content":"Rate limited","locale":"en"},"10400":{"id":"/en/docs/config-network-127","page_id":"/en/docs/config-network","tags":[],"type":"text","url":"/en/docs/config-network#network-diagnostics","content":"HTTP 429","locale":"en"},"10401":{"id":"/en/docs/config-network-128","page_id":"/en/docs/config-network","tags":[],"type":"text","url":"/en/docs/config-network#network-diagnostics","content":"`upstream_error`","locale":"en"},"10402":{"id":"/en/docs/config-network-129","page_id":"/en/docs/config-network","tags":[],"type":"text","url":"/en/docs/config-network#network-diagnostics","content":"Upstream service error","locale":"en"},"10403":{"id":"/en/docs/config-network-130","page_id":"/en/docs/config-network","tags":[],"type":"text","url":"/en/docs/config-network#network-diagnostics","content":"Any other error status","locale":"en"},"10404":{"id":"/en/docs/config-network-131","page_id":"/en/docs/config-network","tags":[],"type":"text","url":"/en/docs/config-network#network-diagnostics","content":"`challenge`, `edge_rejected`, `invalid_response`, `client_restricted`, `region_restricted` and `signature_rejected` are recognised before any token handling: they never invalidate an account's refresh token, rotate accounts or mark a model as gone. A bare HTTP 403 is not treated as an expired token either. When you see one of these, check the route first (another proxy, or direct), the region and the station's status. More steps are in Troubleshooting.","locale":"en"},"10405":{"id":"/en/docs/config-network-132","page_id":"/en/docs/config-network","tags":[],"type":"text","url":"/en/docs/config-network#provider-concurrency-and-waiting","content":"Inference requests share a concurrency limit per provider instance: two by default, one for Zcode. A stream holds its slot until it finishes or closes. Configure `providers.<id>.options.admission` to change the limit, minimum dispatch interval, or maximum queue wait:","locale":"en"},"10406":{"id":"/en/docs/config-network-133","page_id":"/en/docs/config-network","tags":[],"type":"text","url":"/en/docs/config-network#provider-concurrency-and-waiting","content":"`max_concurrency` must be a positive integer; the other values are finite, nonnegative seconds. Server-declared waits are preserved: a wait longer than the request's retry budget returns an error with `Retry-After` instead of sending an early retry. These limits are in memory per instance; separate processes do not share them.","locale":"en"},"10407":{"id":"/en/docs/config-network-134","page_id":"/en/docs/config-network","tags":[],"type":"text","url":"/en/docs/config-network#provider-concurrency-and-waiting","content":"OpenCode free limits and Cline daily model limits hold the account/model pair. Zcode concurrency errors and Qoder queue responses wait without invalidating credentials. Account-wide quota errors still hold the whole account. When no reset time is supplied for an exhausted quota, the conservative fallback is one hour.","locale":"en"},"10408":{"id":"/en/docs/config-network-135","page_id":"/en/docs/config-network","tags":[],"type":"text","url":"/en/docs/config-network#shared-capacity-and-business-errors","content":"Within one gateway, chat, native Messages and availability probes share provider capacity; probes also share account quota holds. Reconfiguring a provider preserves occupied slots. Lower limits take effect as existing streams finish. Cancelling a queued native Messages request prevents dispatch. Changing accounts or credentials clears account-specific temporary waits while retaining provider and model waits.","locale":"en"},"10409":{"id":"/en/docs/config-network-136","page_id":"/en/docs/config-network","tags":[],"type":"text","url":"/en/docs/config-network#shared-capacity-and-business-errors","content":"Waits can affect a provider, account, model, or account/model pair. Quotas are checked again after admission. Native Messages preserves original HTTP 200 and SSE business-error responses while recording limits for subsequent requests.","locale":"en"},"10410":{"id":"/en/docs/config-network-137","page_id":"/en/docs/config-network","tags":[],"type":"text","url":"/en/docs/config-network#shared-capacity-and-business-errors","content":"Provider","locale":"en"},"10411":{"id":"/en/docs/config-network-138","page_id":"/en/docs/config-network","tags":[],"type":"text","url":"/en/docs/config-network#shared-capacity-and-business-errors","content":"Handling","locale":"en"},"10412":{"id":"/en/docs/config-network-139","page_id":"/en/docs/config-network","tags":[],"type":"text","url":"/en/docs/config-network#shared-capacity-and-business-errors","content":"MiniMax Agent / API","locale":"en"},"10413":{"id":"/en/docs/config-network-140","page_id":"/en/docs/config-network","tags":[],"type":"text","url":"/en/docs/config-network#shared-capacity-and-business-errors","content":"Temporary limits such as `1002`, `1039`, `1041`; account quotas such as `1008`, `2056`; authentication errors `1004`, `2049`. Supports `base_resp.status_code`; unknown nonzero values remain errors","locale":"en"},"10414":{"id":"/en/docs/config-network-141","page_id":"/en/docs/config-network","tags":[],"type":"text","url":"/en/docs/config-network#shared-capacity-and-business-errors","content":"Zhipu / Z.AI","locale":"en"},"10415":{"id":"/en/docs/config-network-142","page_id":"/en/docs/config-network","tags":[],"type":"text","url":"/en/docs/config-network#shared-capacity-and-business-errors","content":"Separates rate limits (`1302`, `1305`), quotas (`1113`, `1308`, `1310` and related codes), expired credentials (`1003`), and context overflow (`1261`). Plan permissions and fair-use restrictions are not retried automatically","locale":"en"},"10416":{"id":"/en/docs/config-network-143","page_id":"/en/docs/config-network","tags":[],"type":"text","url":"/en/docs/config-network#shared-capacity-and-business-errors","content":"TRAE","locale":"en"},"10417":{"id":"/en/docs/config-network-144","page_id":"/en/docs/config-network","tags":[],"type":"text","url":"/en/docs/config-network#shared-capacity-and-business-errors","content":"`4008` exhausted credits; `1005` with plan wording indicates plan allowance; `4011` is temporary throttling","locale":"en"},"10418":{"id":"/en/docs/config-network-145","page_id":"/en/docs/config-network","tags":[],"type":"text","url":"/en/docs/config-network#shared-capacity-and-business-errors","content":"LobsterAI / Loomy / Raccoon","locale":"en"},"10419":{"id":"/en/docs/config-network-146","page_id":"/en/docs/config-network","tags":[],"type":"text","url":"/en/docs/config-network#shared-capacity-and-business-errors","content":"Recognizes insufficient credits/balance and business code `402`; LobsterAI `40100` / `40101` enter credential recovery","locale":"en"},"10420":{"id":"/en/docs/config-network-147","page_id":"/en/docs/config-network","tags":[],"type":"text","url":"/en/docs/config-network#shared-capacity-and-business-errors","content":"ZCode","locale":"en"},"10421":{"id":"/en/docs/config-network-148","page_id":"/en/docs/config-network","tags":[],"type":"text","url":"/en/docs/config-network#shared-capacity-and-business-errors","content":"`1002` rejects credentials; `3007` verification failures and `3012` risk rejections return without automatic retries","locale":"en"},"10422":{"id":"/en/docs/config-network-149","page_id":"/en/docs/config-network","tags":[],"type":"text","url":"/en/docs/config-network#shared-capacity-and-business-errors","content":"Qoder","locale":"en"},"10423":{"id":"/en/docs/config-network-150","page_id":"/en/docs/config-network","tags":[],"type":"text","url":"/en/docs/config-network#shared-capacity-and-business-errors","content":"`105` authentication, `110` quota. Queue waits use the longer delay when both header and body specify one","locale":"en"},"10424":{"id":"/en/docs/config-network-151","page_id":"/en/docs/config-network","tags":[],"type":"text","url":"/en/docs/config-network#shared-capacity-and-business-errors","content":"Standard compatible error types such as `rate_limit_error`, `insufficient_quota` and `overloaded_error` also use shared recovery. An untyped HTTP 429 is temporary throttling unless the response explicitly reports an exhausted quota.","locale":"en"},"10425":{"id":"/en/docs/config-network-152","page_id":"/en/docs/config-network","tags":[],"type":"text","url":"/en/docs/config-network#shared-capacity-and-business-errors","content":"Mappings follow the MiniMax error reference, Z.AI error reference, and the local dsh-our-free-model reference. These are local recovery policies, not confirmation of live upstream availability.","locale":"en"},"10426":{"id":"/en/docs/config-paths","page_id":"/en/docs/config-paths","type":"page","content":"Data directory and migration","breadcrumbs":["Hoshimi Documentation","Configuration"],"tags":[],"url":"/en/docs/config-paths","locale":"en"},"10427":{"id":"/en/docs/config-paths-0","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths","content":"Where Hoshimi keeps its configuration, database and other files, what each holds and for how long, where the logs go, and how to back up, reset and migrate from older versions.","locale":"en"},"10428":{"id":"/en/docs/config-paths-1","page_id":"/en/docs/config-paths","type":"heading","tags":[],"url":"/en/docs/config-paths#where-the-data-directory-is","content":"Where the data directory is","locale":"en"},"10429":{"id":"/en/docs/config-paths-2","page_id":"/en/docs/config-paths","type":"heading","tags":[],"url":"/en/docs/config-paths#what-is-in-it","content":"What is in it","locale":"en"},"10430":{"id":"/en/docs/config-paths-3","page_id":"/en/docs/config-paths","type":"heading","tags":[],"url":"/en/docs/config-paths#the-database-hoshimidb","content":"The database, hoshimi.db","locale":"en"},"10431":{"id":"/en/docs/config-paths-4","page_id":"/en/docs/config-paths","type":"heading","tags":[],"url":"/en/docs/config-paths#schema-upgrades","content":"Schema upgrades","locale":"en"},"10432":{"id":"/en/docs/config-paths-5","page_id":"/en/docs/config-paths","type":"heading","tags":[],"url":"/en/docs/config-paths#logs","content":"Logs","locale":"en"},"10433":{"id":"/en/docs/config-paths-6","page_id":"/en/docs/config-paths","type":"heading","tags":[],"url":"/en/docs/config-paths#migrating-from-older-versions","content":"Migrating from older versions","locale":"en"},"10434":{"id":"/en/docs/config-paths-7","page_id":"/en/docs/config-paths","type":"heading","tags":[],"url":"/en/docs/config-paths#move-the-configuration-file","content":"Move the configuration file","locale":"en"},"10435":{"id":"/en/docs/config-paths-8","page_id":"/en/docs/config-paths","type":"heading","tags":[],"url":"/en/docs/config-paths#let-the-old-json-records-import-themselves","content":"Let the old JSON records import themselves","locale":"en"},"10436":{"id":"/en/docs/config-paths-9","page_id":"/en/docs/config-paths","type":"heading","tags":[],"url":"/en/docs/config-paths#check","content":"Check","locale":"en"},"10437":{"id":"/en/docs/config-paths-10","page_id":"/en/docs/config-paths","type":"heading","tags":[],"url":"/en/docs/config-paths#backing-up-and-resetting","content":"Backing up and resetting","locale":"en"},"10438":{"id":"/en/docs/config-paths-11","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths","content":"All of Hoshimi's state lives in one data directory: the configuration file, the database that records usage and conversations, and a few files meant for people or other programs to read. Moving, backing up or resetting Hoshimi means dealing with this one folder.","locale":"en"},"10439":{"id":"/en/docs/config-paths-12","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#where-the-data-directory-is","content":"System","locale":"en"},"10440":{"id":"/en/docs/config-paths-13","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#where-the-data-directory-is","content":"Default location","locale":"en"},"10441":{"id":"/en/docs/config-paths-14","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#where-the-data-directory-is","content":"Linux","locale":"en"},"10442":{"id":"/en/docs/config-paths-15","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#where-the-data-directory-is","content":"`~/.local/share/hoshimi`, or `$XDG_DATA_HOME/hoshimi` when `XDG_DATA_HOME` is set","locale":"en"},"10443":{"id":"/en/docs/config-paths-16","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#where-the-data-directory-is","content":"macOS","locale":"en"},"10444":{"id":"/en/docs/config-paths-17","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#where-the-data-directory-is","content":"`~/Library/Application Support/hoshimi`","locale":"en"},"10445":{"id":"/en/docs/config-paths-18","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#where-the-data-directory-is","content":"Windows","locale":"en"},"10446":{"id":"/en/docs/config-paths-19","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#where-the-data-directory-is","content":"`%APPDATA%\\hoshimi`","locale":"en"},"10447":{"id":"/en/docs/config-paths-20","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#where-the-data-directory-is","content":"The `HOSHIMI_DATA_DIR` environment variable moves it anywhere (`~` is expanded and the path is made absolute). The server and every command find the data directory through this variable, so for `hoshimi config`, `hoshimi login` and the rest to work on the same data, set the same value wherever you run them:","locale":"en"},"10448":{"id":"/en/docs/config-paths-21","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#where-the-data-directory-is","content":"To see the location in use:","locale":"en"},"10449":{"id":"/en/docs/config-paths-22","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#where-the-data-directory-is","content":"`hoshimi config path` prints the config file's path; its folder is the data directory;","locale":"en"},"10450":{"id":"/en/docs/config-paths-23","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#where-the-data-directory-is","content":"`hoshimi env` lists the environment variables Hoshimi reads and the ones currently set;","locale":"en"},"10451":{"id":"/en/docs/config-paths-24","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#where-the-data-directory-is","content":"the Web UI's **Settings** › **About** shows the **Data directory**, **Config file** and **Database**;","locale":"en"},"10452":{"id":"/en/docs/config-paths-25","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#where-the-data-directory-is","content":"`GET /api/v1/settings` returns `data_dir` and `config_path`.","locale":"en"},"10453":{"id":"/en/docs/config-paths-26","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#what-is-in-it","content":"Not every file is always there: each is created the first time it is needed. By design, records that grow with traffic go into the database, and things people edit or other programs read stay plain files.","locale":"en"},"10454":{"id":"/en/docs/config-paths-27","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#what-is-in-it","content":"File","locale":"en"},"10455":{"id":"/en/docs/config-paths-28","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#what-is-in-it","content":"Contents","locale":"en"},"10456":{"id":"/en/docs/config-paths-29","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#what-is-in-it","content":"Notes","locale":"en"},"10457":{"id":"/en/docs/config-paths-30","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#what-is-in-it","content":"`config.json`","locale":"en"},"10458":{"id":"/en/docs/config-paths-31","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#what-is-in-it","content":"Every setting and the channel accounts' credentials","locale":"en"},"10459":{"id":"/en/docs/config-paths-32","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#what-is-in-it","content":"See Configuration file. Holds plain-text tokens; restricted to its owner where possible","locale":"en"},"10460":{"id":"/en/docs/config-paths-33","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#what-is-in-it","content":"`hoshimi.db`","locale":"en"},"10461":{"id":"/en/docs/config-paths-34","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#what-is-in-it","content":"Usage statistics, check-in state and history, probe verdicts, Playground conversations and attachments","locale":"en"},"10462":{"id":"/en/docs/config-paths-35","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#what-is-in-it","content":"See below","locale":"en"},"10463":{"id":"/en/docs/config-paths-36","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#what-is-in-it","content":"`server.json`","locale":"en"},"10464":{"id":"/en/docs/config-paths-37","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#what-is-in-it","content":"`host`, `port` (the port actually bound), `url` and the process id `pid`","locale":"en"},"10465":{"id":"/en/docs/config-paths-38","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#what-is-in-it","content":"Written once the server has bound its port, removed on a normal exit. When the recorded process is gone the file counts as stale and is ignored","locale":"en"},"10466":{"id":"/en/docs/config-paths-39","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#what-is-in-it","content":"`eac-user.json`","locale":"en"},"10467":{"id":"/en/docs/config-paths-40","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#what-is-in-it","content":"The EAC GitHub authorization token, login name, avatar and save time","locale":"en"},"10468":{"id":"/en/docs/config-paths-41","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#what-is-in-it","content":"See EAC. Owner read/write only","locale":"en"},"10469":{"id":"/en/docs/config-paths-42","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#what-is-in-it","content":"`catalog-cache/*.json`","locale":"en"},"10470":{"id":"/en/docs/config-paths-43","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#what-is-in-it","content":"Model catalogue snapshots","locale":"en"},"10471":{"id":"/en/docs/config-paths-44","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#what-is-in-it","content":"Named by a hash of the channel, its options and account configuration. Model metadata and account ids only, no credentials. Only snapshots up to 7 days old are restored; safe to delete at any time","locale":"en"},"10472":{"id":"/en/docs/config-paths-45","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#what-is-in-it","content":"`workspace/`","locale":"en"},"10473":{"id":"/en/docs/config-paths-46","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#what-is-in-it","content":"Files the Playground tools read and write","locale":"en"},"10474":{"id":"/en/docs/config-paths-47","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#what-is-in-it","content":"Used only when `playground.workspace` is empty","locale":"en"},"10475":{"id":"/en/docs/config-paths-48","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#the-database-hoshimidb","content":"One SQLite file holds every record the gateway accumulates:","locale":"en"},"10476":{"id":"/en/docs/config-paths-49","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#the-database-hoshimidb","content":"Contents","locale":"en"},"10477":{"id":"/en/docs/config-paths-50","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#the-database-hoshimidb","content":"Kept for","locale":"en"},"10478":{"id":"/en/docs/config-paths-51","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#the-database-hoshimidb","content":"Each recorded call","locale":"en"},"10479":{"id":"/en/docs/config-paths-52","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#the-database-hoshimidb","content":"`server.stats_keep_days` days (default 90)","locale":"en"},"10480":{"id":"/en/docs/config-paths-53","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#the-database-hoshimidb","content":"Hourly totals","locale":"en"},"10481":{"id":"/en/docs/config-paths-54","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#the-database-hoshimidb","content":"120 days","locale":"en"},"10482":{"id":"/en/docs/config-paths-55","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#the-database-hoshimidb","content":"Daily totals and lifetime counters","locale":"en"},"10483":{"id":"/en/docs/config-paths-56","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#the-database-hoshimidb","content":"Forever","locale":"en"},"10484":{"id":"/en/docs/config-paths-57","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#the-database-hoshimidb","content":"Daily check-in state","locale":"en"},"10485":{"id":"/en/docs/config-paths-58","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#the-database-hoshimidb","content":"The latest","locale":"en"},"10486":{"id":"/en/docs/config-paths-59","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#the-database-hoshimidb","content":"Check-in history","locale":"en"},"10487":{"id":"/en/docs/config-paths-60","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#the-database-hoshimidb","content":"365 days","locale":"en"},"10488":{"id":"/en/docs/config-paths-61","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#the-database-hoshimidb","content":"Model probe verdicts","locale":"en"},"10489":{"id":"/en/docs/config-paths-62","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#the-database-hoshimidb","content":"The latest per model","locale":"en"},"10490":{"id":"/en/docs/config-paths-63","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#the-database-hoshimidb","content":"Playground conversations, messages and attachments","locale":"en"},"10491":{"id":"/en/docs/config-paths-64","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#the-database-hoshimidb","content":"Until deleted; temporary chats are deleted when left and at the next start","locale":"en"},"10492":{"id":"/en/docs/config-paths-65","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#the-database-hoshimidb","content":"Usage statistics are written in batches about once a second, and once more when the server stops; conversation messages are written as they are sent. At each start, replies that were cut off mid-stream are marked as stopped and attachments that were never sent are removed.","locale":"en"},"10493":{"id":"/en/docs/config-paths-66","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#the-database-hoshimidb","content":"The database runs in WAL mode with a 5-second busy timeout, so the command line can read and write the same file while the server is running.","locale":"en"},"10494":{"id":"/en/docs/config-paths-67","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#schema-upgrades","content":"The database schema moves forward through numbered upgrades, with the version kept in SQLite's `user_version`. A newer Hoshimi upgrades an older database the first time it opens it; nothing needs to be done by hand.","locale":"en"},"10495":{"id":"/en/docs/config-paths-68","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#schema-upgrades","content":"When the database was last used by a newer Hoshimi, an older one warns at start:","locale":"en"},"10496":{"id":"/en/docs/config-paths-69","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#schema-upgrades","content":"The older version still runs, but some records may not show correctly. Back up the data directory before downgrading.","locale":"en"},"10497":{"id":"/en/docs/config-paths-70","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#logs","content":"Hoshimi writes no log file: every log line goes to standard error (stderr). Once the server listens, standard output gets one line, `SERVER_READY url=http://…`, so scripts can pick up the actual address.","locale":"en"},"10498":{"id":"/en/docs/config-paths-71","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#logs","content":"When Hoshimi runs as a system service, the service manager collects the logs (for example `journalctl`); see Installation.","locale":"en"},"10499":{"id":"/en/docs/config-paths-72","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#move-the-configuration-file","content":"The old `--config` option and `HOSHIMI_CONFIG` environment variable have been removed. A `config.json` in the working directory is neither read nor migrated automatically. After upgrading, run:","locale":"en"},"10500":{"id":"/en/docs/config-paths-73","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#move-the-configuration-file","content":"and move the old configuration file to the path it prints before starting the new version.","locale":"en"},"10501":{"id":"/en/docs/config-paths-74","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#let-the-old-json-records-import-themselves","content":"Earlier versions kept usage, check-ins and probe verdicts in `stats.json`, `checkin.json` and `probe.json`. At the first start after upgrading, these files are imported into `hoshimi.db` and renamed to `*.migrated`. An unreadable one is renamed to `*.corrupt` and that record starts empty. Nothing is imported again once the database holds that kind of record.","locale":"en"},"10502":{"id":"/en/docs/config-paths-75","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#check","content":"This confirms the configuration can be read and lists the channels and account counts that would run. Afterwards the `*.migrated` files can be deleted.","locale":"en"},"10503":{"id":"/en/docs/config-paths-76","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#backing-up-and-resetting","content":"Task","locale":"en"},"10504":{"id":"/en/docs/config-paths-77","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#backing-up-and-resetting","content":"How","locale":"en"},"10505":{"id":"/en/docs/config-paths-78","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#backing-up-and-resetting","content":"Full backup","locale":"en"},"10506":{"id":"/en/docs/config-paths-79","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#backing-up-and-resetting","content":"Stop the server and copy the whole data directory","locale":"en"},"10507":{"id":"/en/docs/config-paths-80","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#backing-up-and-resetting","content":"Move to another machine","locale":"en"},"10508":{"id":"/en/docs/config-paths-81","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#backing-up-and-resetting","content":"Copy the data directory, then point `HOSHIMI_DATA_DIR` at it on the new machine (or put it in the default location)","locale":"en"},"10509":{"id":"/en/docs/config-paths-82","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#backing-up-and-resetting","content":"Clear usage statistics only","locale":"en"},"10510":{"id":"/en/docs/config-paths-83","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#backing-up-and-resetting","content":"**Reset statistics** on the Web UI's **Usage** page, or `DELETE /api/v1/stats`. Cannot be undone","locale":"en"},"10511":{"id":"/en/docs/config-paths-84","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#backing-up-and-resetting","content":"Discard every record","locale":"en"},"10512":{"id":"/en/docs/config-paths-85","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#backing-up-and-resetting","content":"Stop the server and delete `hoshimi.db` (with its `-wal` and `-shm` files). Settings and accounts are untouched","locale":"en"},"10513":{"id":"/en/docs/config-paths-86","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#backing-up-and-resetting","content":"Discard cached model catalogues","locale":"en"},"10514":{"id":"/en/docs/config-paths-87","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#backing-up-and-resetting","content":"Delete `catalog-cache/`; catalogues are fetched again at the next start","locale":"en"},"10515":{"id":"/en/docs/config-paths-88","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#backing-up-and-resetting","content":"Return to default settings","locale":"en"},"10516":{"id":"/en/docs/config-paths-89","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#backing-up-and-resetting","content":"Stop the server and rename `config.json`. Channel accounts live in this file too and go with it","locale":"en"},"10517":{"id":"/en/docs/config-paths-90","page_id":"/en/docs/config-paths","tags":[],"type":"text","url":"/en/docs/config-paths#backing-up-and-resetting","content":"A running server writes its in-memory configuration back to `config.json` and keeps writing to the database. Deleting or replacing these files while it runs can have the change overwritten or lost.","locale":"en"},"10518":{"id":"/en/docs/config-security","page_id":"/en/docs/config-security","type":"page","content":"Access control","breadcrumbs":["Hoshimi Documentation","Configuration"],"tags":[],"url":"/en/docs/config-security","locale":"en"},"10519":{"id":"/en/docs/config-security-0","page_id":"/en/docs/config-security","tags":[],"type":"text","url":"/en/docs/config-security","content":"What the tool access key and the model API key each protect and how to send them; how the client network, Host and origin checks work; and how to open the gateway to your LAN safely.","locale":"en"},"10520":{"id":"/en/docs/config-security-1","page_id":"/en/docs/config-security","type":"heading","tags":[],"url":"/en/docs/config-security#the-two-keys","content":"The two keys","locale":"en"},"10521":{"id":"/en/docs/config-security-2","page_id":"/en/docs/config-security","type":"heading","tags":[],"url":"/en/docs/config-security#setting-the-keys","content":"Setting the keys","locale":"en"},"10522":{"id":"/en/docs/config-security-3","page_id":"/en/docs/config-security","type":"heading","tags":[],"url":"/en/docs/config-security#signing-in-from-a-browser","content":"Signing in from a browser","locale":"en"},"10523":{"id":"/en/docs/config-security-4","page_id":"/en/docs/config-security","type":"heading","tags":[],"url":"/en/docs/config-security#the-order-of-the-checks","content":"The order of the checks","locale":"en"},"10524":{"id":"/en/docs/config-security-5","page_id":"/en/docs/config-security","type":"heading","tags":[],"url":"/en/docs/config-security#client-networks","content":"Client networks","locale":"en"},"10525"
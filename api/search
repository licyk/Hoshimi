-architecture-9","page_id":"/en/docs/development-architecture","type":"heading","tags":[],"url":"/en/docs/development-architecture#preparing-the-request","content":"Preparing the request","locale":"en"},"10951":{"id":"/en/docs/development-architecture-10","page_id":"/en/docs/development-architecture","type":"heading","tags":[],"url":"/en/docs/development-architecture#counting-it","content":"Counting it","locale":"en"},"10952":{"id":"/en/docs/development-architecture-11","page_id":"/en/docs/development-architecture","type":"heading","tags":[],"url":"/en/docs/development-architecture#routing-to-a-provider","content":"Routing to a provider","locale":"en"},"10953":{"id":"/en/docs/development-architecture-12","page_id":"/en/docs/development-architecture","type":"heading","tags":[],"url":"/en/docs/development-architecture#account-rotation-and-the-upstream-protocol","content":"Account rotation and the upstream protocol","locale":"en"},"10954":{"id":"/en/docs/development-architecture-13","page_id":"/en/docs/development-architecture","type":"heading","tags":[],"url":"/en/docs/development-architecture#the-public-protocol","content":"The public protocol","locale":"en"},"10955":{"id":"/en/docs/development-architecture-14","page_id":"/en/docs/development-architecture","type":"heading","tags":[],"url":"/en/docs/development-architecture#the-command-line","content":"The command line","locale":"en"},"10956":{"id":"/en/docs/development-architecture-15","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture","content":"Hoshimi's code has four layers, and dependencies run one way: `api` and `cli` depend on `core`; `core` depends on neither and imports no framework. Both entry points, the server and the command line, get the same `Services` from `build_services()` and wrap it in HTTP routes or commands of their own. This page covers the layering rule first, then `Services`, the app factory and errors, and finally follows one request all the way through.","locale":"en"},"10957":{"id":"/en/docs/development-architecture-16","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-layering-rule","content":"Layer","locale":"en"},"10958":{"id":"/en/docs/development-architecture-17","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-layering-rule","content":"May import","locale":"en"},"10959":{"id":"/en/docs/development-architecture-18","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-layering-rule","content":"Must not import","locale":"en"},"10960":{"id":"/en/docs/development-architecture-19","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-layering-rule","content":"`hoshimi/core`","locale":"en"},"10961":{"id":"/en/docs/development-architecture-20","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-layering-rule","content":"The standard library, httpx, pydantic, cryptography and the optional cloud SDKs","locale":"en"},"10962":{"id":"/en/docs/development-architecture-21","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-layering-rule","content":"`fastapi`, `starlette`, `typer`, `click`, `socketio`, `uvicorn`, `rich`; `hoshimi.api`, `hoshimi.cli`","locale":"en"},"10963":{"id":"/en/docs/development-architecture-22","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-layering-rule","content":"`hoshimi/api`","locale":"en"},"10964":{"id":"/en/docs/development-architecture-23","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-layering-rule","content":"`core`, FastAPI, Starlette","locale":"en"},"10965":{"id":"/en/docs/development-architecture-24","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-layering-rule","content":"`hoshimi.cli`","locale":"en"},"10966":{"id":"/en/docs/development-architecture-25","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-layering-rule","content":"`hoshimi/cli`","locale":"en"},"10967":{"id":"/en/docs/development-architecture-26","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-layering-rule","content":"`core`, Typer, Rich; the `serve` command starts the `api` app","locale":"en"},"10968":{"id":"/en/docs/development-architecture-27","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-layering-rule","content":"—","locale":"en"},"10969":{"id":"/en/docs/development-architecture-28","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-layering-rule","content":"`hoshimi/webui`","locale":"en"},"10970":{"id":"/en/docs/development-architecture-29","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-layering-rule","content":"Talks to the server over HTTP only","locale":"en"},"10971":{"id":"/en/docs/development-architecture-30","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-layering-rule","content":"Python code","locale":"en"},"10972":{"id":"/en/docs/development-architecture-31","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-layering-rule","content":"Two tests keep the rule:","locale":"en"},"10973":{"id":"/en/docs/development-architecture-32","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-layering-rule","content":"`tests/core/test_architecture.py` parses the imports of every file under `hoshimi/core` and fails on any framework the table forbids; it also checks that no file there mentions `hoshimi.api` or `hoshimi.cli`. httpx is allowed, because the provider adapters are HTTP clients of their own upstream stations.","locale":"en"},"10974":{"id":"/en/docs/development-architecture-33","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-layering-rule","content":"`tests/test_package_api.py` imports `hoshimi` in a fresh process and requires that neither `fastapi` nor `httpx` was loaded, and that the lazily exported `Services`, `build_services` and `create_app` are the very objects in the implementation modules.","locale":"en"},"10975":{"id":"/en/docs/development-architecture-34","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-layering-rule","content":"What this buys: the domain logic can be tested and reused without a server, and the domain exceptions (`hoshimi/core/errors.py`) are mapped to HTTP responses by the API and to exit codes by the command line, while `core` stays out of it.","locale":"en"},"10976":{"id":"/en/docs/development-architecture-35","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-modules-of-core","content":"Area","locale":"en"},"10977":{"id":"/en/docs/development-architecture-36","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-modules-of-core","content":"Modules","locale":"en"},"10978":{"id":"/en/docs/development-architecture-37","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-modules-of-core","content":"Assembly","locale":"en"},"10979":{"id":"/en/docs/development-architecture-38","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-modules-of-core","content":"`context.py` (`Services`, `build_services`), `config.py` (`Settings`, reading and writing `config.json`), `paths.py` (the data folder)","locale":"en"},"10980":{"id":"/en/docs/development-architecture-39","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-modules-of-core","content":"Routing and providers","locale":"en"},"10981":{"id":"/en/docs/development-architecture-40","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-modules-of-core","content":"`registry.py` (model name to provider), `providers/` (adapters), `provider_definitions.py` (services defined as data), `provider_forms.py` (account form descriptions), `presets.py` (agg presets), `credentials.py`","locale":"en"},"10982":{"id":"/en/docs/development-architecture-41","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-modules-of-core","content":"Protocols","locale":"en"},"10983":{"id":"/en/docs/development-architecture-42","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-modules-of-core","content":"`chunks.py` (normalized chunks and the Chat Completions / Responses output), `message_chunks.py` (Anthropic Messages output), `native_messages.py` (native Messages pass-through), `translate/`, `sse.py`","locale":"en"},"10984":{"id":"/en/docs/development-architecture-43","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-modules-of-core","content":"Model capabilities","locale":"en"},"10985":{"id":"/en/docs/development-architecture-44","page_id":"/en/docs/development-architecture","tags":[],"type":"text","url":"/en/docs/development-architecture#the-modules-of-core","content
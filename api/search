page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"Builds the documentation site","locale":"en"},"11528":{"id":"/en/docs/development-setup-93","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`test-site`","locale":"en"},"11529":{"id":"/en/docs/development-setup-94","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"The documentation site's tests and type-check","locale":"en"},"11530":{"id":"/en/docs/development-setup-95","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"The site tasks are covered in Documentation site. Run `python scripts/dev.py check` once before committing: it covers CI's Python and Web UI checks.","locale":"en"},"11531":{"id":"/en/docs/development-setup-96","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`test-py` always runs the whole suite. To run part of it, call pytest directly, for example `python -m pytest tests/core/test_registry.py -k prefixed`.","locale":"en"},"11532":{"id":"/en/docs/development-setup-97","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#clones-of-the-reference-projects","content":"To compare against upstream protocols, clone the reference repositories into the repository root (`dsh-our-free-model/`, `codex-api/`, `Hanaikada/`, `pi/`, `pi-free/`, `free-claude-code/` and so on). They are all in `.gitignore` and never committed; development, tests and builds do not need them. What each one is for is in Development.","locale":"en"},"11533":{"id":"/en/docs/development-site","page_id":"/en/docs/development-site","type":"page","content":"Documentation site","breadcrumbs":["Hoshimi Documentation","Development"],"tags":[],"url":"/en/docs/development-site","locale":"en"},"11534":{"id":"/en/docs/development-site-0","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site","content":"This site is Hoshimi's documentation: how it is organised, how to write and check a page, previewing and building locally, deploying to Netlify and GitHub Pages, and analytics and comments.","locale":"en"},"11535":{"id":"/en/docs/development-site-1","page_id":"/en/docs/development-site","type":"heading","tags":[],"url":"/en/docs/development-site#how-it-is-organised","content":"How it is organised","locale":"en"},"11536":{"id":"/en/docs/development-site-2","page_id":"/en/docs/development-site","type":"heading","tags":[],"url":"/en/docs/development-site#previewing-and-building-locally","content":"Previewing and building locally","locale":"en"},"11537":{"id":"/en/docs/development-site-3","page_id":"/en/docs/development-site","type":"heading","tags":[],"url":"/en/docs/development-site#writing-a-page","content":"Writing a page","locale":"en"},"11538":{"id":"/en/docs/development-site-4","page_id":"/en/docs/development-site","type":"heading","tags":[],"url":"/en/docs/development-site#create-two-files","content":"Create two files","locale":"en"},"11539":{"id":"/en/docs/development-site-5","page_id":"/en/docs/development-site","type":"heading","tags":[],"url":"/en/docs/development-site#write-the-frontmatter","content":"Write the frontmatter","locale":"en"},"11540":{"id":"/en/docs/development-site-6","page_id":"/en/docs/development-site","type":"heading","tags":[],"url":"/en/docs/development-site#add-it-to-the-sidebars","content":"Add it to the sidebars","locale":"en"},"11541":{"id":"/en/docs/development-site-7","page_id":"/en/docs/development-site","type":"heading","tags":[],"url":"/en/docs/development-site#check","content":"Check","locale":"en"},"11542":{"id":"/en/docs/development-site-8","page_id":"/en/docs/development-site","type":"heading","tags":[],"url":"/en/docs/development-site#components","content":"Components","locale":"en"},"11543":{"id":"/en/docs/development-site-9","page_id":"/en/docs/development-site","type":"heading","tags":[],"url":"/en/docs/development-site#writing-mdx","content":"Writing MDX","locale":"en"},"11544":{"id":"/en/docs/development-site-10","page_id":"/en/docs/development-site","type":"heading","tags":[],"url":"/en/docs/development-site#links","content":"Links","locale":"en"},"11545":{"id":"/en/docs/development-site-11","page_id":"/en/docs/development-site","type":"heading","tags":[],"url":"/en/docs/development-site#the-code-is-the-reference","content":"The code is the reference","locale":"en"},"11546":{"id":"/en/docs/development-site-12","page_id":"/en/docs/development-site","type":"heading","tags":[],"url":"/en/docs/development-site#the-generated-page","content":"The generated page","locale":"en"},"11547":{"id":"/en/docs/development-site-13","page_id":"/en/docs/development-site","type":"heading","tags":[],"url":"/en/docs/development-site#deployment","content":"Deployment","locale":"en"},"11548":{"id":"/en/docs/development-site-14","page_id":"/en/docs/development-site","type":"heading","tags":[],"url":"/en/docs/development-site#analytics-and-comments","content":"Analytics and comments","locale":"en"},"11549":{"id":"/en/docs/development-site-15","page_id":"/en/docs/development-site","type":"heading","tags":[],"url":"/en/docs/development-site#the-readme","content":"The README","locale":"en"},"11550":{"id":"/en/docs/development-site-16","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site","content":"This site replaces the repository's old `docs/` folder and is Hoshimi's only documentation. **A change users can see** (a command, an option, a config key, an environment variable, an endpoint, the interface) updates the matching pages in the same commit, in Chinese and in English. This page covers how the site is organised, how to write pages, how to preview and build it locally, and how it is deployed.","locale":"en"},"11551":{"id":"/en/docs/development-site-17","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#how-it-is-organised","content":"The site lives in the repository's `site/` folder, built with TanStack Start, Fumadocs (MDX) and Tailwind, and installed and run with bun.","locale":"en"},"11552":{"id":"/en/docs/development-site-18","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#how-it-is-organised","content":"Path","locale":"en"},"11553":{"id":"/en/docs/development-site-19","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#how-it-is-organised","content":"Contents","locale":"en"},"11554":{"id":"/en/docs/development-site-20","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#how-it-is-organised","content":"`site/content/docs/<slug>.mdx`","locale":"en"},"11555":{"id":"/en/docs/development-site-21","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#how-it-is-organised","content":"A Simplified Chinese page (the default language)","locale":"en"},"11556":{"id":"/en/docs/development-site-22","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#how-it-is-organised","content":"`site/content/docs/<slug>.en.mdx`","locale":"en"},"11557":{"id":"/en/docs/development-site-23","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#how-it-is-organised","content":"The English version of the same page","locale":"en"},"11558":{"id":"/en/docs/development-site-24","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#how-it-is-organised","content":"`site/content/docs/meta.json`, `meta.en.json`","locale":"en"},"11559":{"id":"/en/docs/development-site-25","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#how-it-is-organised","content":"The Chinese and English sidebars: page order and groups","locale":"en"},"11560":{"id":"/en/docs/development-site-26","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#how-it-is-organised","content":"`site/src/`","locale":"en"},"11561":{"id":"/en/docs/development-site-27","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#how-it-is-organised","content":"Routes, layout, the home page and components; the MDX components available to pages are registered in `src/components/mdx.tsx`","locale":"en"},"11562":{"id":"/en/docs/development-site-28","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#how-it-is-organised","content":"`site/scripts/prepare-static-output.mjs`","locale":"en"},"11563":{"id":"/en/docs/development-site-29","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#how-it-is-organised","content":"Checks after the build that the output is complete","locale":"en"},"11564":{"id":"/en/docs/development-site-30","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#how-it-is-organised","content":"`site/public/`","locale":"en"},"11565":{"id":"/en/docs/development-site-31","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#how-it-is-organised","content":"Static files copied to the output as they are","locale":"en"},"11566":{"id":"/en/docs/development-site-32","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#how-it-is-organised","content":"Both languages share one address, `/docs/<slug>`: the site shows the version in the language the reader picked (kept in the browser), or, when none was picked, Chinese if the browser's first language is Chinese and English otherwise.","locale":"en"},"11567":{"id":"/en/docs/development-site-33","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#previewing-and-building-locally","content":"The dev server is fixed at `http://127.0.0.1:3000` and fails when the port is taken rather than picking another. The build writes `site/.output/public`; the build script then runs `prepare-static-output.mjs`, which checks that every page listed in `meta.json` produced its HTML and copies `_shell.html` to `404.html`. A page in the sidebar with no file behind it therefore fails the build.","locale":"en"},"11568":{"id":"/en/docs/development-site-34","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#create-two-files","content":"In `site/content/docs/`, create `<slug>.mdx` (Chinese) and `<slug>.en.mdx` (English). Slugs are lowercase with hyphens, prefixed by their section (`guide-`, `clients-`, `providers-`, `cli-`, `config-`, `advanced-`, `api-`, `development-`). Both files have the same structure: the same sections in the same order, the same code blocks and links. The Chinese is natural Simplified Chinese, not a word-for-word translation; the English is plain and direct.","locale":"en"},"11569":{"id":"/en/docs/development-site-35","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#write-the-frontmatter","content":"Field","locale":"en"},"11570":{"id":"/en/docs/development-site-36","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#write-the-frontmatter","content":"Meaning","locale":"en"},"11571":{"id":"/en/docs/development-site-37","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#write-the-frontmatter","content":"`title`","locale":"en"},"11572":{"id":"/en/docs/development-site-38","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#write-the-frontmatter","content":"The page title; do not repeat it as a `#` heading in the body","locale":"en"},"11573":{"id":"/en/docs/development-site-39","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#write-the-frontmatter","content":"`description`","locale":"en"},"11574":{"id":"/en/docs/development-site-40","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#write-the-frontmatter","content":"Shown under the title, and used for search and the page's metadata","locale":"en"},"11575":{"id":"/en/docs/development-site-41","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#write-the-frontmatter","content":"`icon`","locale":"en"},"11576":{"id":"/en/docs/development-site-42","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#write-the-frontmatter","content":"A Lucide icon name in PascalCase (such as `Rocket`, `Terminal`, `Settings`)","locale":"en"},"11577":{"id":"/en/docs/development-site-43","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#write-the-frontmatter","content":"The body starts with a short paragraph, then `##` sections.","locale":"en"},"11578":{"id":"/en/docs/development-site-44","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#add-it-to-the-sidebars","content":"Add the slug to `pages` in `meta.json` and `meta.en.json`, at the same position in both. Entries written `\"---Title---\"` are group headings, which each language words its own way; the list of page slugs and its order must be identical.","locale":"en"},"11579":{"id":"/en/docs/development-site-45","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#check","content":"Run `bun run test` and `bun run build` (or `python scripts/dev.py test-site` and `site`), and read the page in both languages under `bun run dev`.","locale":"en"},"11580":{"id":"/en/docs/development-site-46","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#check","content":"`site/src/lib/i18n-content.test.ts` checks two things: every Chinese page has an English version, and both sidebars list the same page slugs in the same order.","locale":"en"},"11581":{"id":"/en/docs/development-site-47","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#components","content":"Pages can use these components directly, with no import:","locale":"en"},"11582":{"id":"/en/docs/development-site-48","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#components","content":"Component","locale":"en"},"11583":{"id":"/en/docs/development-site-49","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#components","content":"Used for","locale":"en"},"11584":{"id":"/en/docs/development-site-50","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#components","content":"`<Callout type=\"info\\|warn\\|error\" title=\"…\">`","locale":"en"},"11585":{"id":"/en/docs/development-site-51","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#components","content":"Notes and warnings; only where attention is needed, such as security or data loss","locale":"en"},"11586":{"id":"/en/docs/development-site-52","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#components","content":"`<Steps>` and `<Step>`","locale":"en"},"11587":{"id":"/en/docs/development-site-53","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#components","content":"Procedures; each step starts with a `###` heading","locale":"en"},"11588":{"id":"/en/docs/development-site-54","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#components","content":"`<Tabs items={[...]}>` and `<Tab value=\"…\">`","locale":"en"},"11589":{"id":"/en/docs/development-site-55","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#components","content":"Several ways to do the same thing (pip / uv, bash / PowerShell)","locale":"en"},"11590":{"id":"/en/docs/development-site-56","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#components","content":"`<Cards>` and `<Card title href description />`","locale":"en"},"11591":{"id":"/en/docs/development-site-57","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#components","content":"Cards pointing to other pages","locale":"en"},"11592":{"id":"/en/docs/development-site-58","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#components","content":"`<Accordions>` and `<Accordion title=\"…\">`","locale":"en"},"11593":{"id":"/en/docs/development-site-59","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#components","content":"Collapsible questions and answers","locale":"en"},"11594":{"id":"/en/docs/development-site-60","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#components","content":"`<Mermaid chart={...} />`","locale":"en"},"11595":{"id":"/en/docs/development-site-61","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#components","content":"A Mermaid diagram that follows the site's light or dark theme","locale":"en"},"11596":{"id":"/en/docs/development-site-62","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#writing-mdx","content":"MDX is JSX: escape `{`, `}` and `<` in prose (write `\\{`), or put them in inline code.","locale":"en"},"11597":{"id":"/en/docs/development-site-63","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#writing-mdx","content":"Leave a blank line before and after Markdown inside a component, or it is not parsed as Markdown.","locale":"en"},"11598":{"id":"/en/docs/development-site-64","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#writing-mdx","content":"Name the language of every code block: `bash`, `powershell`, `json`, `python`, `ts`, `http` and so on.","locale":"en"},"11599":{"id":"/en/docs/development-site-65","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#writing-mdx","content":"Keys are written `<kbd>Ctrl</kbd>`.","locale":"en"},"11600":{"id":"/en/docs/development-site-66","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#links","content":"Link other pages as `/docs/<slug>`, with no language prefix and no `.mdx`, written the same in both languages; add `#anchor` when needed. Anchors come from the heading text, so preferably link only to headings you wrote yourself.","locale":"en"},"11601":{"id":"/en/docs/development-site-67","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#links","content":"Link source files as `https://github.com/licyk/Hoshimi/blob/main/<path>`.","locale":"en"},"11602":{"id":"/en/docs/development-site-68","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#the-code-is-the-reference","content":"Every statement must be backed by the code; when old documentation or memory disagrees with the code, the code wins. What cannot be confirmed is left out.","locale":"en"},"11603":{"id":"/en/docs/development-site-69","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#the-code-is-the-reference","content":"Page content","locale":"en"},"11604":{"id":"/en/docs/development-site-70","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#the-code-is-the-reference","content":"Backed by","locale":"en"},"11605":{"id":"/en/docs/development-site-71","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#the-code-is-the-reference","content":"Config keys and defaults","locale":"en"},"11606":{"id":"/en/docs/development-site-72","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#the-code-is-the-reference","content":"`hoshimi/core/config.py`, `hoshimi/core/paths.py`, `config.example.json`","locale":"en"},"11607":{"id":"/en/docs/development-site-73","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#the-code-is-the-reference","content":"Commands and options","locale":"en"},"11608":{"id":"/en/docs/development-site-74","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#the-code-is-the-reference","content":"`hoshimi/cli/`; `hoshimi <command> --help`","locale":"en"},"11609":{"id":"/en/docs/development-site-75","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#the-code-is-the-reference","content":"Environment variables","locale":"en"},"11610":{"id":"/en/docs/development-site-76","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#the-code-is-the-reference","content":"`hoshimi env`","locale":"en"},"11611":{"id":"/en/docs/development-site-77","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#the-code-is-the-reference","content":"Endpoints","locale":"en"},"11612":{"id":"/en/docs/development-site-78","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#the-code-is-the-reference","content":"`hoshimi/api/routers/`; a running server's `/docs` and `/openapi.json`","locale":"en"},"11613":{"id":"/en/docs/development-site-79","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#the-code-is-the-reference","content":"Provider registration and account fields","locale":"en"},"11614":{"id":"/en/docs/development-site-80","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#the-code-is-the-reference","content":"`hoshimi/core/providers/factory.py`, `hoshimi/core/provider_forms.py`, `hoshimi/core/provider_definitions.py`","locale":"en"},"11615":{"id":"/en/docs/development-site-81","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#the-code-is-the-reference","content":"Web UI text","locale":"en"},"11616":{"id":"/en/docs/development-site-82","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#the-code-is-the-reference","content":"The labels in `hoshimi/webui/src/i18n/en.ts` on English pages and in `zh-CN.ts` on Chinese pages, in bold","locale":"en"},"11617":{"id":"/en/docs/development-site-83","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#the-code-is-the-reference","content":"To read command-line help, use a temporary data folder so the real one is untouched:","locale":"en"},"11618":{"id":"/en/docs/development-site-84","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#the-code-is-the-reference","content":"As for writing: be task-oriented; say what to do and why first, then the details. A reference page is complete (every command, key, endpoint); a guide walks through real tasks. Prefer examples the reader can copy: commands, JSON, curl.","locale":"en"},"11619":{"id":"/en/docs/development-site-85","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#the-generated-page","content":"The Provider inventory (`providers-inventory.mdx` and `providers-inventory.en.mdx`) is generated by a script from `hoshimi/core/provider_sources.py`; do not edit it by hand:","locale":"en"},"11620":{"id":"/en/docs/development-site-86","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#the-generated-page","content":"Both languages share one table; only the words around it differ. Run it again after changing `provider_sources.py`, and commit both generated files.","locale":"en"},"11621":{"id":"/en/docs/development-site-87","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#deployment","content":"Site","locale":"en"},"11622":{"id":"/en/docs/development-site-88","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#deployment","content":"Address","locale":"en"},"11623":{"id":"/en/docs/development-site-89","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#deployment","content":"How","locale":"en"},"11624":{"id":"/en/docs/development-site-90","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#deployment","content":"Main","locale":"en"},"11625":{"id":"/en/docs/development-site-91","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#deployment","content":"hoshimi-dev.netlify.app","locale":"en"},"11626":{"id":"/en/docs/development-site-92","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#deployment","content":"Netlify builds `site/` on every push to `main`, configured by `netlify.toml` at the repository root; it skips builds when `site/` did not change","locale":"en"},"11627":{"id":"/en/docs/development-site-93","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#deployment","content":"Backup","locale":"en"},"11628":{"id":"/en/docs/development-site-94","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#deployment","content":"licyk.github.io/Hoshimi","locale":"en"},"11629":{"id":"/en/docs/development-site-95","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#deployment","content":"`.github/workflows/site.yml` builds with `VITE_BASE_PATH=/Hoshimi/` and force-pushes the output to the `gh-pages` branch (with the `GITEE_RSA_PRIVATE_KEY` deploy key), which Pages serves","locale":"en"},"11630":{"id":"/en/docs/development-site-96","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#deployment","content":"The site can live under a sub-path: `VITE_BASE_PATH` sets Vite's `base`, and the routes and the search index follow it. Pages on the backup carry a canonical link to the Netlify site, so search engines treat the main site as the original. CI's shared checks also type-check, test and build the site.","locale":"en"},"11631":{"id":"/en/docs/development-site-97","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#analytics-and-comments","content":"**Analytics**: the site uses Umami, loaded in production builds only and counted on the two site domains alone; local previews are not counted.","locale":"en"},"11632":{"id":"/en/docs/development-site-98","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#analytics-and-comments","content":"**Comments**: every documentation page ends with Giscus comments (`components/docs-comments.tsx`, `lib/giscus.ts`, as rvc-next's site), backed by this repository's GitHub Discussions in the \"Comment\" category. Each page has one discussion thread, mapped `specific` on the page path with the base path, the language prefix and the slashes around it dropped (`docs/<slug>`), so a page's Chinese and English versions, on the main site (at the root) and the backup (under `/Hoshimi/`) alike, share one thread. The comments follow the site's theme and language, which are posted to the loaded comments frame rather than reloading it.","locale":"en"},"11633":{"id":"/en/docs/development-site-99","page_id":"/en/docs/development-site","tags":[],"type":"text","url":"/en/docs/development-site#the-readme","content":"The repository's `README.md` and `README.zh-CN.md` are also the project description on PyPI, so their links are full URLs (to this site or to GitHub), never paths relative to the repository.","locale":"en"},"11634":{"id":"/en/docs/development-testing","page_id":"/en/docs/development-testing","type":"page","content":"Testing","breadcrumbs":["Hoshimi Documentation","Development"],"tags":[],"url":"/en/docs/development-testing","locale":"en"},"11635":{"id":"/en/docs/development-testing-0","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing","content":"Every kind of check in Hoshimi: the pytest layout and shared fixtures, how provider and route tests are written, the Web UI's Vitest rule tests, the generated-type check, check_layout.py for sideways overflow in real browsers, and how CI runs them.","locale":"en"},"11636":{"id":"/en/docs/development-testing-1","page_id":"/en/docs/development-testing","type":"heading","tags":[],"url":"/en/docs/development-testing#at-a-glance","content":"At a glance","locale":"en"},"11637":{"id":"/en/docs/development-testing-2","page_id":"/en/docs/development-testing","type":"heading","tags":[],"url":"/en/docs/development-testing#python-tests","content":"Python tests","locale":"en"},"11638":{"id":"/en/docs/development-testing-3","page_id":"/en/docs/development-testing","type":"heading","tags":[],"url":"/en/docs/development-testing#layout","content":"Layout","locale":"en"},"11639":{"id":"/en/docs/development-testing-4","page_id":"/en/docs/development-testing","type":"heading","tags":[],"url":"/en/docs/development-testing#shared-fixtures","content":"Shared fixtures","locale":"en"},"11640":{"id":"/en/docs/development-testing-5","page_id":"/en/docs/development-testing","type":"heading","tags":[],"url":"/en/docs/development-testing#common-patterns","content":"Common patterns","locale":"en"},"11641":{"id":"/en/docs/development-testing-6","page_id":"/en/docs/development-testing","type":"heading","tags":[],"url":"/en/docs/development-testing#web-ui-tests","content":"Web UI tests","locale":"en"},"11642":{"id":"/en/docs/development-testing-7","page_id":"/en/docs/development-testing","type":"heading","tags":[],"url":"/en/docs/development-testing#the-generated-type-check","content":"The generated-type check","locale":"en"},"11643":{"id":"/en/docs/development-testing-8","page_id":"/en/docs/development-testing","type":"heading","tags":[],"url":"/en/docs/development-testing#checking-the-layout-in-browsers-check_layoutpy","content":"Checking the layout in browsers: `check_layout.py`","locale":"en"},"11644":{"id":"/en/docs/development-testing-9","page_id":"/en/docs/development-testing","type":"heading","tags":[],"url":"/en/docs/development-testing#checks-in-ci","content":"Checks in CI","locale":"en"},"11645":{"id":"/en/docs/development-testing-10","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing","content":"Hoshimi's tests never touch the network and need no real provider credentials: upstreams are replaced by a fake provider or by `httpx.MockTransport`, and every test gets a temporary data folder of its own. Run `python scripts/dev.py check` once before committing: it covers CI's Python and Web UI checks.","locale":"en"},"11646":{"id":"/en/docs/development-testing-11","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#at-a-glance","content":"Check","locale":"en"},"11647":{"id":"/en/docs/development-testing-12","page_id":"/en/docs/development-testing","tags":[],"type":"text","url":"/en/docs/development-testing#at-a-glance","content":"Command","locale":"en"},"11648":{"id":"/en/docs/development-testing-13","page_id":"/en/docs/development-testing","tags":
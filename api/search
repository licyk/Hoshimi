-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#general","content":"**Summary model**","locale":"en"},"12776":{"id":"/en/docs/guide-settings-73","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#general","content":"`playground.compact_model`","locale":"en"},"12777":{"id":"/en/docs/guide-settings-74","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#general","content":"**The chat's own model**","locale":"en"},"12778":{"id":"/en/docs/guide-settings-75","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#general","content":"Writes the summary when a chat is compacted","locale":"en"},"12779":{"id":"/en/docs/guide-settings-76","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#general","content":"What these do in the Playground is in Playground.","locale":"en"},"12780":{"id":"/en/docs/guide-settings-77","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#tools","content":"The Playground's built-in tools let models that make tool calls read and edit files, run commands and search the web. The tools switched on here are the tools of every chat; the approval mode set here is where new chats start, and each chat can change its own from the shield in its composer. The full guide is Playground tools.","locale":"en"},"12781":{"id":"/en/docs/guide-settings-78","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#tools","content":"Commands and file edits run on this computer with the permissions of the user running Hoshimi. There is no sandbox: Automatic review has a model judge each command and edit first, and Ask first leaves every one to you.","locale":"en"},"12782":{"id":"/en/docs/guide-settings-79","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#tools","content":"**Tools** (`playground.tools`, all on by default, for every chat):","locale":"en"},"12783":{"id":"/en/docs/guide-settings-80","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#tools","content":"Switch","locale":"en"},"12784":{"id":"/en/docs/guide-settings-81","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#tools","content":"Config value","locale":"en"},"12785":{"id":"/en/docs/guide-settings-82","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#tools","content":"What it does","locale":"en"},"12786":{"id":"/en/docs/guide-settings-83","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#tools","content":"**Read files**","locale":"en"},"12787":{"id":"/en/docs/guide-settings-84","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#tools","content":"`read`","locale":"en"},"12788":{"id":"/en/docs/guide-settings-85","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#tools","content":"Read text files and list folders","locale":"en"},"12789":{"id":"/en/docs/guide-settings-86","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#tools","content":"**Edit files**","locale":"en"},"12790":{"id":"/en/docs/guide-settings-87","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#tools","content":"`apply_patch`","locale":"en"},"12791":{"id":"/en/docs/guide-settings-88","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#tools","content":"Create, change and delete files in the workspace","locale":"en"},"12792":{"id":"/en/docs/guide-settings-89","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#tools","content":"**Run commands**","locale":"en"},"12793":{"id":"/en/docs/guide-settings-90","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#tools","content":"`shell`","locale":"en"},"12794":{"id":"/en/docs/guide-settings-91","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#tools","content":"Run a command and wait for its output","locale":"en"},"12795":{"id":"/en/docs/guide-settings-92","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#tools","content":"**Background commands**","locale":"en"},"12796":{"id":"/en/docs/guide-settings-93","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#tools","content":"`terminal`","locale":"en"},"12797":{"id":"/en/docs/guide-settings-94","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#tools","content":"Start commands that keep running (servers, watchers), read their output, type into them and stop them","locale":"en"},"12798":{"id":"/en/docs/guide-settings-95","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#tools","content":"**Search the web**","locale":"en"},"12799":{"id":"/en/docs/guide-settings-96","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#tools","content":"`web_search`","locale":"en"},"12800":{"id":"/en/docs/guide-settings-97","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#tools","content":"Search the web with DuckDuckGo, or with your own SearXNG","locale":"en"},"12801":{"id":"/en/docs/guide-settings-98","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#tools","content":"**Read web pages**","locale":"en"},"12802":{"id":"/en/docs/guide-settings-99","page_id":"/en/docs/guide-settings","tags":[],"type":"text","url":"/en/docs/guide-settings#tools","content":"`web_fetch`","locale":"en"},"12803":{"id":"/en/docs/guide-settings-100","page_id":"/en/docs/guide-settings","tags":[]
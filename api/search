ocs/providers-stations","tags":[],"type":"text","url":"/en/docs/providers-stations#other-channels-with-sign-in","content":"Device code","locale":"en"},"15522":{"id":"/en/docs/providers-stations-262","page_id":"/en/docs/providers-stations","tags":[],"type":"text","url":"/en/docs/providers-stations#other-channels-with-sign-in","content":"Anonymous lanes","locale":"en"},"15523":{"id":"/en/docs/providers-stations-263","page_id":"/en/docs/providers-stations","tags":[],"type":"text","url":"/en/docs/providers-stations#other-channels-with-sign-in","content":"`radius`","locale":"en"},"15524":{"id":"/en/docs/providers-stations-264","page_id":"/en/docs/providers-stations","tags":[],"type":"text","url":"/en/docs/providers-stations#other-channels-with-sign-in","content":"Device code","locale":"en"},"15525":{"id":"/en/docs/providers-stations-265","page_id":"/en/docs/providers-stations","tags":[],"type":"text","url":"/en/docs/providers-stations#other-channels-with-sign-in","content":"Cloud platforms","locale":"en"},"15526":{"id":"/en/docs/providers","page_id":"/en/docs/providers","type":"page","content":"Provider concepts","breadcrumbs":["Hoshimi Documentation","Providers"],"tags":[],"url":"/en/docs/providers","locale":"en"},"15527":{"id":"/en/docs/providers-0","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers","content":"How Hoshimi organises upstreams: channels (providers), accounts, account pools and model routing, how each kind of channel gets its accounts, and how to choose one.","locale":"en"},"15528":{"id":"/en/docs/providers-1","page_id":"/en/docs/providers","type":"heading","tags":[],"url":"/en/docs/providers#kinds-of-channel","content":"Kinds of channel","locale":"en"},"15529":{"id":"/en/docs/providers-2","page_id":"/en/docs/providers","type":"heading","tags":[],"url":"/en/docs/providers#similar-names-different-ids","content":"Similar names, different IDs","locale":"en"},"15530":{"id":"/en/docs/providers-3","page_id":"/en/docs/providers","type":"heading","tags":[],"url":"/en/docs/providers#adding-an-account","content":"Adding an account","locale":"en"},"15531":{"id":"/en/docs/providers-4","page_id":"/en/docs/providers","type":"heading","tags":[],"url":"/en/docs/providers#keys-for-each-channel","content":"Keys for each channel","locale":"en"},"15532":{"id":"/en/docs/providers-5","page_id":"/en/docs/providers","type":"heading","tags":[],"url":"/en/docs/providers#choosing-a-model-routing-rules","content":"Choosing a model: routing rules","locale":"en"},"15533":{"id":"/en/docs/providers-6","page_id":"/en/docs/providers","type":"heading","tags":[],"url":"/en/docs/providers#account-pools-and-rotation","content":"Account pools and rotation","locale":"en"},"15534":{"id":"/en/docs/providers-7","page_id":"/en/docs/providers","type":"heading","tags":[],"url":"/en/docs/providers#renewal-and-check-in","content":"Renewal and check-in","locale":"en"},"15535":{"id":"/en/docs/providers-8","page_id":"/en/docs/providers","type":"heading","tags":[],"url":"/en/docs/providers#how-to-choose","content":"How to choose","locale":"en"},"15536":{"id":"/en/docs/providers-9","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers","content":"Hoshimi treats each upstream service as a **channel** (called a provider in code and configuration, and named by an ID such as `cline`, `opencode` or `agg`). A channel holds one or more **accounts**, and the accounts of one channel form its **account pool**: requests rotate through it. This page explains those ideas and the common ways to add an account; the other pages in this section cover each kind of channel.","locale":"en"},"15537":{"id":"/en/docs/providers-10","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#kinds-of-channel","content":"Kind","locale":"en"},"15538":{"id":"/en/docs/providers-11","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#kinds-of-channel","content":"Example channel IDs","locale":"en"},"15539":{"id":"/en/docs/providers-12","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#kinds-of-channel","content":"Where accounts come from","locale":"en"},"15540":{"id":"/en/docs/providers-13","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#kinds-of-channel","content":"See","locale":"en"},"15541":{"id":"/en/docs/providers-14","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#kinds-of-channel","content":"Anonymous lanes","locale":"en"},"15542":{"id":"/en/docs/providers-15","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#kinds-of-channel","content":"`opencode`, `kilo`","locale":"en"},"15543":{"id":"/en/docs/providers-16","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#kinds-of-channel","content":"None needed; on by default","locale":"en"},"15544":{"id":"/en/docs/providers-17","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#kinds-of-channel","content":"Anonymous lanes","locale":"en"},"15545":{"id":"/en/docs/providers-18","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#kinds-of-channel","content":"Free stations and subscription logins","locale":"en"},"15546":{"id":"/en/docs/providers-19","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#kinds-of-channel","content":"`cline`, `gemini`, `zcode`, `minimax`, `trae`, `qoder`, `qodercn`, `qodercli`, `qodercli-cn`, `buddy`, `workbuddy`, `codearts`, `loomy`, `raccoon`, `lobsterai`, `codex`, `eac`, `zhipu`","locale":"en"},"15547":{"id":"/en/docs/providers-20","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#kinds-of-channel","content":"Browser, device-code or token sign-in (`zhipu` uses an API key; `qodercli` a Personal Access Token)","locale":"en"},"15548":{"id":"/en/docs/providers-21","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#kinds-of-channel","content":"Free stations","locale":"en"},"15549":{"id":"/en/docs/providers-22","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#kinds-of-channel","content":"Generic compatible lane","locale":"en"},"15550":{"id":"/en/docs/providers-23","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#kinds-of-channel","content":"`agg`","locale":"en"},"15551":{"id":"/en/docs/providers-24","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#kinds-of-channel","content":"Your own base URL or one of 22 presets, plus an API key","locale":"en"},"15552":{"id":"/en/docs/providers-25","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#kinds-of-channel","content":"The agg aggregator","locale":"en"},"15553":{"id":"/en/docs/providers-26","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#kinds-of-channel","content":"Cloud platforms and special protocols","locale":"en"},"15554":{"id":"/en/docs/providers-27","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#kinds-of-channel","content":"`azure`, `cloudflare-workers-ai`, `cloudflare-ai-gateway`, `google`, `google-vertex`, `amazon-bedrock`, `radius`, `typesafe`","locale":"en"},"15555":{"id":"/en/docs/providers-28","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#kinds-of-channel","content":"Platform keys, Google or AWS credentials","locale":"en"},"15556":{"id":"/en/docs/providers-29","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#kinds-of-channel","content":"Cloud platforms","locale":"en"},"15557":{"id":"/en/docs/providers-30","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#kinds-of-channel","content":"NVIDIA NIM","locale":"en"},"15558":{"id":"/en/docs/providers-31","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#kinds-of-channel","content":"`nvidia`","locale":"en"},"15559":{"id":"/en/docs/providers-32","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#kinds-of-channel","content":"API key","locale":"en"},"15560":{"id":"/en/docs/providers-33","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#kinds-of-channel","content":"NVIDIA NIM","locale":"en"},"15561":{"id":"/en/docs/providers-34","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#kinds-of-channel","content":"Conventional API services and local backends","locale":"en"},"15562":{"id":"/en/docs/providers-35","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#kinds-of-channel","content":"`openai`, `anthropic`, `openrouter`, `deepseek`, `groq`, …; `lmstudio`, `ollama`, `llamacpp`","locale":"en"},"15563":{"id":"/en/docs/providers-36","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#kinds-of-channel","content":"API key, some with sign-in; key optional for local servers","locale":"en"},"15564":{"id":"/en/docs/providers-37","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#kinds-of-channel","content":"Local and compatible endpoints","locale":"en"},"15565":{"id":"/en/docs/providers-38","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#kinds-of-channel","content":"The provider inventory maps every channel to its sources. An inventory row records that an entry point exists, not that the upstream currently answers.","locale":"en"},"15566":{"id":"/en/docs/providers-39","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#similar-names-different-ids","content":"Different products, plans and protocols from the same company use different channel IDs, and their credentials are not interchangeable:","locale":"en"},"15567":{"id":"/en/docs/providers-40","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#similar-names-different-ids","content":"`minimax` is a MiniMax Agent login; `minimax-api`, `minimax-cn` and `minimax-chat` are three key-billed public APIs.","locale":"en"},"15568":{"id":"/en/docs/providers-41","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#similar-names-different-ids","content":"`gemini` is Gemini Code Assist (Google account sign-in); `google` is the Gemini Developer API (API key); `google-vertex` is Vertex AI.","locale":"en"},"15569":{"id":"/en/docs/providers-42","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#similar-names-different-ids","content":"`amazon-bedrock` (ConverseStream) and `bedrock-mantle` (an OpenAI-compatible endpoint) are configured separately.","locale":"en"},"15570":{"id":"/en/docs/providers-43","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#similar-names-different-ids","content":"`zhipu` is bigmodel.cn's general API; `zai`, `zai-coding-cn` and `zai-api` are Z.AI's coding plans and international API; `zcode` is the ZCode client's sign-in lane.","locale":"en"},"15571":{"id":"/en/docs/providers-44","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#similar-names-different-ids","content":"`cline` is Cline's free sign-in lane; `cline-pass` is a ClinePass subscription key.","locale":"en"},"15572":{"id":"/en/docs/providers-45","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#similar-names-different-ids","content":"`typesafe` provides classification, not chat models.","locale":"en"},"15573":{"id":"/en/docs/providers-46","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#adding-an-account","content":"All three ways write the same file: `config.json` in the data folder (`hoshimi config path` prints its location). The Web UI and `hoshimi login` apply immediately; if you edit the file by hand, restart the server.","locale":"en"},"15574":{"id":"/en/docs/providers-47","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#adding-an-account","content":"Open the **Channels** page and pick a channel. Channels without accounts are under the **Not set up** filter.","locale":"en"},"15575":{"id":"/en/docs/providers-48","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#adding-an-account","content":"For a channel that supports sign-in, click **Sign in** and finish in the browser as the dialog says. For the others, click **Add account**, choose an **Authentication method**, fill in the form and click **Save account**.","locale":"en"},"15576":{"id":"/en/docs/providers-49","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#adding-an-account","content":"The account appears under **Accounts**. Adding an account also switches a disabled channel back on.","locale":"en"},"15577":{"id":"/en/docs/providers-50","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#adding-an-account","content":"Signing in again as the same station identity updates the existing account instead of adding a second one. To delete an account, use **Forget** in its menu: the credential is removed from `config.json` and from the running pool.","locale":"en"},"15578":{"id":"/en/docs/providers-51","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#adding-an-account","content":"Account tokens and keys are stored in plain text in `config.json`. Do not commit or share a file with real credentials in it; replace them with placeholders before sharing an example.","locale":"en"},"15579":{"id":"/en/docs/providers-52","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#keys-for-each-channel","content":"Key","locale":"en"},"15580":{"id":"/en/docs/providers-53","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#keys-for-each-channel","content":"Meaning","locale":"en"},"15581":{"id":"/en/docs/providers-54","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#keys-for-each-channel","content":"`providers.<id>.enabled`","locale":"en"},"15582":{"id":"/en/docs/providers-55","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#keys-for-each-channel","content":"`false` switches the channel off entirely (this is also how the anonymous lanes are turned off). On when omitted.","locale":"en"},"15583":{"id":"/en/docs/providers-56","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#keys-for-each-channel","content":"`providers.<id>.accounts`","locale":"en"},"15584":{"id":"/en/docs/providers-57","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#keys-for-each-channel","content":"The list of accounts; each is an object whose fields depend on the channel.","locale":"en"},"15585":{"id":"/en/docs/providers-58","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#keys-for-each-channel","content":"`providers.<id>.accounts[].id`","locale":"en"},"15586":{"id":"/en/docs/providers-59","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#keys-for-each-channel","content":"The account's name, used in the UI, usage records and logs. When omitted the gateway names it (a login produces names like `cline-1a2b3c`; an unnamed entry is named by position, like `<id>-0`).","locale":"en"},"15587":{"id":"/en/docs/providers-60","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#keys-for-each-channel","content":"`providers.<id>.options`","locale":"en"},"15588":{"id":"/en/docs/providers-61","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#keys-for-each-channel","content":"Channel-level options, such as TRAE's `channel`, agg's capability declarations or a local server's `models`.","locale":"en"},"15589":{"id":"/en/docs/providers-62","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#keys-for-each-channel","content":"`providers.<id>.options.network`","locale":"en"},"15590":{"id":"/en/docs/providers-63","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#keys-for-each-channel","content":"The channel's own network route; inherits the global setting by default. See Network and proxies.","locale":"en"},"15591":{"id":"/en/docs/providers-64","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#choosing-a-model-routing-rules","content":"Clients name the model in the request's `model` field:","locale":"en"},"15592":{"id":"/en/docs/providers-65","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#choosing-a-model-routing-rules","content":"`channel/model` (for example `opencode/big-pickle` or `nvidia/<model-id>`) goes straight to that channel.","locale":"en"},"15593":{"id":"/en/docs/providers-66","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#choosing-a-model-routing-rules","content":"A bare model ID goes to the first channel that lists it, in this fixed order: `cline`, `opencode`, `kilo`, `gemini`, `zcode`, `minimax`, `trae`, `qoder`, `qodercn`, `qodercli`, `qodercli-cn`, `buddy`, `workbuddy`, `codearts`, `loomy`, `raccoon`, `lobsterai`, `eac`, `agg`, `zhipu`, `nvidia`, then every other channel.","locale":"en"},"15594":{"id":"/en/docs/providers-67","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#choosing-a-model-routing-rules","content":"When only one channel is enabled, an unknown ID is passed to it unchanged.","locale":"en"},"15595":{"id":"/en/docs/providers-68","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#choosing-a-model-routing-rules","content":"`GET /v1/models` lists each ID once; `owned_by` is the channel that wins by the order above. When the model ID itself contains a `/` (Kilo's `openrouter/free`, for example), add the channel prefix, `kilo/openrouter/free`, so the first segment is not read as a channel name. Client setup is in Connecting clients.","locale":"en"},"15596":{"id":"/en/docs/providers-69","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#account-pools-and-rotation","content":"A channel's accounts are used in the order they are configured. When a request meets an account-level failure, the gateway retries on the next account, asking at most `server.max_account_retries` accounts per request (default 3):","locale":"en"},"15597":{"id":"/en/docs/providers-70","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#account-pools-and-rotation","content":"Quota exhausted or rate limited: the account is held out of rotation for the reset time the upstream gave, or one hour if it gave none.","locale":"en"},"15598":{"id":"/en/docs/providers-71","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#account-pools-and-rotation","content":"Credentials refused: the gateway tries to renew them, then moves to another account. When the refresh token itself is refused, the account is marked **Needs login** and stays out of rotation until you sign in again.","locale":"en"},"15599":{"id":"/en/docs/providers-72","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#account-pools-and-rotation","content":"Once any content has gone to the client, a request is never replayed automatically.","locale":"en"},"15600":{"id":"/en/docs/providers-73","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#account-pools-and-rotation","content":"The full rules are in Model behaviour.","locale":"en"},"15601":{"id":"/en/docs/providers-74","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#renewal-and-check-in","content":"The tokens of many sign-in stations expire. With **Credential renewal** on (`server.auto_refresh`, on by default) the gateway checks every 30 minutes and renews accounts that expire within the hour or record no expiry. With **Daily check-in** on (`server.auto_checkin`, on by default) it claims each supporting station's free credits once a day, by the calendar day in UTC+8. Which stations support renewal, check-in and balance queries is listed in Free stations.","locale":"en"},"15602":{"id":"/en/docs/providers-75","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#how-to-choose","content":"Start with the anonymous lanes, which are on by default and need no account.","locale":"en"},"15603":{"id":"/en/docs/providers-76","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#how-to-choose","content":"For a larger free allowance, sign into free stations; several accounts give the rotation more room.","locale":"en"},"15604":{"id":"/en/docs/providers-77","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#how-to-choose","content":"If you already have a key for an OpenAI-compatible service, use its native channel when it has one (see Local and compatible endpoints), otherwise agg.","locale":"en"},"15605":{"id":"/en/docs/providers-78","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#how-to-choose","content":"Use the matching cloud platform channel for enterprise cloud accounts, and LM Studio, Ollama or llama.cpp for models on your own machine.","locale":"en"},"15606":{"id":"/en/docs/providers-79","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#how-to-choose","content":"<Card title=\"Anonymous lanes\" href=\"/docs/providers-anonymous\" description=\"OpenCode Zen and Kilo: free models with no account.\" />","locale":"en"},"15607":{"id":"/en/docs/providers-80","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#how-to-choose","content":"<Card title=\"Free stations\" href=\"/docs/providers-stations\" description=\"How to sign into each station, what it offers and what to watch for.\" />","locale":"en"},"15608":{"id":"/en/docs/providers-81","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#how-to-choose","content":"<Card title=\"The agg aggregator\" href=\"/docs/providers-agg\" description=\"Any OpenAI-compatible station, and the 22 station presets.\" />","locale":"en"},"15609":{"id":"/en/docs/providers-82","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#how-to-choose","content":"<Card title=\"Cloud platforms\" href=\"/docs/providers-cloud\" description=\"Azure, Cloudflare, Gemini, Vertex, Bedrock and special protocols.\" />","locale":"en"},"15610":{"id":"/en/docs/providers-83","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#how-to-choose","content":"<Card title=\"NVIDIA NIM\" href=\"/docs/providers-nvidia\" description=\"Accounts and compatibility translation for NVIDIA-hosted models.\" />","locale":"en"},"15611":{"id":"/en/docs/providers-84","page_id":"/en/docs/providers","tags":[],"type":"text","url":"/en/docs/providers#how-to-choose","content":"<Card title=\"Local and compatible endpoints\" href=\"/docs/providers-local\" description=\"LM Studio, Ollama, llama.cpp and key-based conventional APIs.\" />","locale":"en"},"15612":{"id":"/en/docs/quick-start","page_id":"/en/docs/quick-start","type":"page","content":"Quick start","breadcrumbs":["Hoshimi Documentation","Getting started"],"tags":[],"url":"/en/docs/quick-start","locale":"en"},"15613":{"id":"/en/docs/quick-start-0","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start","content":"From nothing to a first conversation: install Hoshimi, start the server, send a message in the Playground, then make a first API request with curl.","locale":"en"},"15614":{"id":"/en/docs/quick-start-1","page_id":"/en/docs/quick-start","type":"heading","tags":[],"url":"/en/docs/quick-start#install","content":"Install","locale":"en"},"15615":{"id":"/en/docs/quick-start-2","page_id":"/en/docs/quick-start","type":"heading","tags":[],"url":"/en/docs/quick-start#start-the-server","content":"Start the server","locale":"en"},"15616":{"id":"/en/docs/quick-start-3","page_id":"/en/docs/quick-start","type":"heading","tags":[],"url":"/en/docs/quick-start#look-at-the-overview-page","content":"Look at the Overview page","locale":"en"},"15617":{"id":"/en/docs/quick-start-4","page_id":"/en/docs/quick-start","type":"heading","tags":[],"url":"/en/docs/quick-start#send-a-first-message-in-the-playground","content":"Send a first message in the Playground","locale":"en"},"15618":{"id":"/en/docs/quick-start-5","page_id":"/en/docs/quick-start","type":"heading","tags":[],"url":"/en/docs/quick-start#make-a-first-api-request","content":"Make a first API request","locale":"en"},"15619":{"id":"/en/docs/quick-start-6","page_id":"/en/docs/quick-start","type":"heading","tags":[],"url":"/en/docs/quick-start#the-same-checks-from-the-command-line","content":"The same checks from the command line","locale":"en"},"15620":{"id":"/en/docs/quick-start-7","page_id":"/en/docs/quick-start","type":"heading","tags":[],"url":"/en/docs/quick-start#next-steps","content":"Next steps","locale":"en"},"15621":{"id":"/en/docs/quick-start-8","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start","content":"This page takes the shortest route, using only the anonymous channels that are on by default, so no account is needed. Each step is covered in detail in Installation and First run.","locale":"en"},"15622":{"id":"/en/docs/quick-start-9","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#install","content":"You need Python 3.10 or newer. Install from PyPI:","locale":"en"},"15623":{"id":"/en/docs/quick-start-10","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#install","content":"The package ships the built Web UI, so Node and Bun are not needed. Installing with uv or pipx, and the optional cloud dependencies, are in Installation.","locale":"en"},"15624":{"id":"/en/docs/quick-start-11","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#start-the-server","content":"When the server is ready, the terminal prints `SERVER_READY url=http://127.0.0.1:10600` and the browser opens that address a moment later. By default the server listens on this machine only (`127.0.0.1`), port **10600**; if that port is busy it moves to the next free one, so use the URL the terminal prints. Press Ctrl+C to stop it.","locale":"en"},"15625":{"id":"/en/docs/quick-start-12","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#start-the-server","content":"`python -m hoshimi serve` is the same as `hoshimi serve`. Add `--no-open` if you do not want a browser to open.","locale":"en"},"15626":{"id":"/en/docs/quick-start-13","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#look-at-the-overview-page","content":"The interface opens on the **Overview** page. The **Channels** section already holds two channels, **OpenCode Zen** and **Kilo AI**, both marked **No account needed**. They are the anonymous entry points that are on by default; which models they offer depends on the upstream catalogue, quota and service state at the time.","locale":"en"},"15627":{"id":"/en/docs/quick-start-14","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#look-at-the-overview-page","content":"The **Endpoints** section lists the addresses clients use (`/v1/chat/completions`, `/v1/responses`, `/v1/messages` and more), each with a copy button.","locale":"en"},"15628":{"id":"/en/docs/quick-start-15","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#send-a-first-message-in-the-playground","content":"Open **Playground** in the navigation rail on the left.","locale":"en"},"15629":{"id":"/en/docs/quick-start-16","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#send-a-first-message-in-the-playground","content":"The **Model** picker under the message box has already chosen the first model in the catalogue; click it to search for and pick another.","locale":"en"},"15630":{"id":"/en/docs/quick-start-17","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#send-a-first-message-in-the-playground","content":"Type a message in the box (**Ask anything…**) and press Enter to send (Shift+Enter adds a new line).","locale":"en"},"15631":{"id":"/en/docs/quick-start-18","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#send-a-first-message-in-the-playground","content":"The reply streams in. The conversation is saved and named automatically, and appears in the **Chats** list in the sidebar. If a model fails, try another: anonymous models can be rate limited or withdrawn at any time.","locale":"en"},"15632":{"id":"/en/docs/quick-start-19","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#make-a-first-api-request","content":"List the models first, and put one of the returned `data[].id` values in place of `<model-id>`:","locale":"en"},"15633":{"id":"/en/docs/quick-start-20","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#make-a-first-api-request","content":"Chat Completions streams (SSE) by default; `\"stream\": false` above returns one complete JSON response instead. In the Playground, **Copy as API request** in the **More actions** menu under a reply copies the conversation as an equivalent request.","locale":"en"},"15634":{"id":"/en/docs/quick-start-21","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#make-a-first-api-request","content":"With the OpenAI Python SDK, point the base URL at `/v1`:","locale":"en"},"15635":{"id":"/en/docs/quick-start-22","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#make-a-first-api-request","content":"While no model API key is set, `api_key` can be any value; once one is set, requests must send `Authorization: Bearer <model-api-key>`.","locale":"en"},"15636":{"id":"/en/docs/quick-start-23","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#the-same-checks-from-the-command-line","content":"You can confirm the channels and models without a browser (the server does not need to be running):","locale":"en"},"15637":{"id":"/en/docs/quick-start-24","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#next-steps","content":"Add more channels: sign into free stations or paste API keys on the **Channels** page; see Channels and Provider concepts.","locale":"en"},"15638":{"id":"/en/docs/quick-start-25","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#next-steps","content":"Connect Claude Code, Codex, OpenCode or your own program: Connecting clients.","locale":"en"},"15639":{"id":"/en/docs/quick-start-26","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#next-steps","content":"Let other machines on your network connect, or protect the interface with an access key: Security.","locale":"en"},"15640":{"id":"/en/docs/quick-start-27","page_id":"/en/docs/quick-start","tags":[],"type":"text","url":"/en/docs/quick-start#next-steps","content":"What each page is for the first time you open the interface: First run.","locale":"en"}},"count":15640},"sorting":{"language":"multilingual","sortableProperties":["content","page_id","type","url"],"sortablePropertiesWithTypes":{"content":"string","page_id":"string","type":"string","url":"string"},"sorts":{"content":{"docs":{"1":7853,"2":7859,"3":14569,"4":12815,"5":13138,"6":13342,"7":12214,"8":11909,"9":8336,"10":14922,"11":1351
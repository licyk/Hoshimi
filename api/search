is-recorded","content":"Generation time and generation speed (tokens/second)","locale":"en"},"8355":{"id":"/en/docs/advanced-usage-59","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#what-is-recorded","content":"`elapsed_ms`","locale":"en"},"8356":{"id":"/en/docs/advanced-usage-60","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#what-is-recorded","content":"Total time","locale":"en"},"8357":{"id":"/en/docs/advanced-usage-61","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#what-is-recorded","content":"`finish_reason`","locale":"en"},"8358":{"id":"/en/docs/advanced-usage-62","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#what-is-recorded","content":"Why it ended","locale":"en"},"8359":{"id":"/en/docs/advanced-usage-63","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#what-is-recorded","content":"`error_code`, `error_message`","locale":"en"},"8360":{"id":"/en/docs/advanced-usage-64","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#what-is-recorded","content":"Error code and a short explanation on failure","locale":"en"},"8361":{"id":"/en/docs/advanced-usage-65","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#what-is-recorded","content":"`no_usage`","locale":"en"},"8362":{"id":"/en/docs/advanced-usage-66","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#what-is-recorded","content":"The upstream reported no token usage","locale":"en"},"8363":{"id":"/en/docs/advanced-usage-67","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#what-is-recorded","content":"A few rules:","locale":"en"},"8364":{"id":"/en/docs/advanced-usage-68","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#what-is-recorded","content":"**Routing failures count as failures**: a request that ends before reaching upstream (model not found, every account failed and so on) is still recorded, as a failure.","locale":"en"},"8365":{"id":"/en/docs/advanced-usage-69","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#what-is-recorded","content":"**A client disconnecting is not a failure**: when the caller hangs up mid-answer, the gateway did serve the call, and the record counts as a success.","locale":"en"},"8366":{"id":"/en/docs/advanced-usage-70","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#what-is-recorded","content":"An error frame from the upstream inside a stream is recorded as a failure.","locale":"en"},"8367":{"id":"/en/docs/advanced-usage-71","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#what-is-recorded","content":"Records hold usage and metadata only; prompts and replies are not stored here (Playground conversations are stored separately).","locale":"en"},"8368":{"id":"/en/docs/advanced-usage-72","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#what-is-recorded","content":"Error explanations are kept to one line of at most 160 characters, with anything shaped like a key (`Bearer …`, `sk-…`, random strings of 32 characters or more, and so on) replaced with `***`. An upstream error that carries a status is recorded only as `upstream returned HTTP <status>`, without the upstream's body; error frames inside a stream keep their explanation, shortened and masked by the same rules.","locale":"en"},"8369":{"id":"/en/docs/advanced-usage-73","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#where-tokens-and-cache-counts-come-from","content":"Every channel's usage is first normalized to OpenAI's fields, then recorded:","locale":"en"},"8370":{"id":"/en/docs/advanced-usage-74","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#where-tokens-and-cache-counts-come-from","content":"Record field","locale":"en"},"8371":{"id":"/en/docs/advanced-usage-75","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#where-tokens-and-cache-counts-come-from","content":"Read from","locale":"en"},"8372":{"id":"/en/docs/advanced-usage-76","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#where-tokens-and-cache-counts-come-from","content":"`input`","locale":"en"},"8373":{"id":"/en/docs/advanced-usage-77","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#where-tokens-and-cache-counts-come-from","content":"`prompt_tokens`","locale":"en"},"8374":{"id":"/en/docs/advanced-usage-78","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#where-tokens-and-cache-counts-come-from","content":"`output`","locale":"en"},"8375":{"id":"/en/docs/advanced-usage-79","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#where-tokens-and-cache-counts-come-from","content":"`completion_tokens`","locale":"en"},"8376":{"id":"/en/docs/advanced-usage-80","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#where-tokens-and-cache-counts-come-from","content":"`reasoning`","locale":"en"},"8377":{"id":"/en/docs/advanced-usage-81","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#where-tokens-and-cache-counts-come-from","content":"`completion_tokens_details.reasoning_tokens`","locale":"en"},"8378":{"id":"/en/docs/advanced-usage-82","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#where-tokens-and-cache-counts-come-from","content":"`cache_read`","locale":"en"},"8379":{"id":"/en/docs/advanced-usage-83","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#where-tokens-and-cache-counts-come-from","content":"`prompt_tokens_details.cached_tokens`; DeepSeek's `prompt_cache_hit_tokens` and Anthropic's `cache_read_input_tokens` are mapped here too","locale":"en"},"8380":{"id":"/en/docs/advanced-usage-84","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#where-tokens-and-cache-counts-come-from","content":"`cache_write`","locale":"en"},"8381":{"id":"/en/docs/advanced-usage-85","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#where-tokens-and-cache-counts-come-from","content":"`prompt_tokens_details.cache_write_tokens` or `cache_creation_tokens`; Anthropic's `cache_creation_input_tokens` is mapped here too","locale":"en"},"8382":{"id":"/en/docs/advanced-usage-86","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#time-to-first-token-and-speed","content":"`ttft_ms` runs from the start of the request to the first content (text, reasoning or a tool call).","locale":"en"},"8383":{"id":"/en/docs/advanced-usage-87","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#time-to-first-token-and-speed","content":"Generation speed uses the time between the first content and the end. Reasoning tokens that were spent before the first frame, and never streamed, are subtracted from the count rather than credited to the answer's speed.","locale":"en"},"8384":{"id":"/en/docs/advanced-usage-88","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#time-to-first-token-and-speed","content":"A generation window under 250 milliseconds, or a speed above 250 tokens a second, counts as unmeasurable: that call's `tps` is `null` and it is left out of averages, so a rate that could not be measured never looks fast.","locale":"en"},"8385":{"id":"/en/docs/advanced-usage-89","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#time-to-first-token-and-speed","content":"Medians (p50) and p95 of time to first token and speed are computed from fixed-bucket histograms, which combine over any time range.","locale":"en"},"8386":{"id":"/en/docs/advanced-usage-90","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#how-long-records-are-kept","content":"Records are kept in `hoshimi.db` in the data directory, in these forms:","locale":"en"},"8387":{"id":"/en/docs/advanced-usage-91","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#how-long-records-are-kept","content":"Form","locale":"en"},"8388":{"id":"/en/docs/advanced-usage-92","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#how-long-records-are-kept","content":"Used for","locale":"en"},"8389":{"id":"/en/docs/advanced-usage-93","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#how-long-records-are-kept","content":"Kept for","locale":"en"},"8390":{"id":"/en/docs/advanced-usage-94","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#how-long-records-are-kept","content":"Each call","locale":"en"},"8391":{"id":"/en/docs/advanced-usage-95","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#how-long-records-are-kept","content":"The call list and call details","locale":"en"},"8392":{"id":"/en/docs/advanced-usage-96","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#how-long-records-are-kept","content":"`server.stats_keep_days` days (default 90)","locale":"en"},"8393":{"id":"/en/docs/advanced-usage-97","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#how-long-records-are-kept","content":"Hourly totals","locale":"en"},"8394":{"id":"/en/docs/advanced-usage-98","pag
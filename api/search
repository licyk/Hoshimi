ders","type":"heading","tags":[],"url":"/docs/providers#每个渠道的配置键","content":"每个渠道的配置键","locale":"zh-CN"},"7691":{"id":"/docs/providers-5","page_id":"/docs/providers","type":"heading","tags":[],"url":"/docs/providers#选择模型路由规则","content":"选择模型：路由规则","locale":"zh-CN"},"7692":{"id":"/docs/providers-6","page_id":"/docs/providers","type":"heading","tags":[],"url":"/docs/providers#账号池与轮换","content":"账号池与轮换","locale":"zh-CN"},"7693":{"id":"/docs/providers-7","page_id":"/docs/providers","type":"heading","tags":[],"url":"/docs/providers#续期与签到","content":"续期与签到","locale":"zh-CN"},"7694":{"id":"/docs/providers-8","page_id":"/docs/providers","type":"heading","tags":[],"url":"/docs/providers#怎样选择","content":"怎样选择","locale":"zh-CN"},"7695":{"id":"/docs/providers-9","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers","content":"Hoshimi 把每个上游服务当作一个**渠道**（代码和配置中称为 provider，用一个 ID 表示，例如 `cline`、`opencode`、`agg`）。渠道下面挂着一个或多个**账号**，同一渠道的账号组成**账号池**，请求在池内轮换。本页说明这些概念和通用的添加方式；各类渠道的细节见本节其他页面。","locale":"zh-CN"},"7696":{"id":"/docs/providers-10","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#渠道的种类","content":"类别","locale":"zh-CN"},"7697":{"id":"/docs/providers-11","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#渠道的种类","content":"渠道 ID 示例","locale":"zh-CN"},"7698":{"id":"/docs/providers-12","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#渠道的种类","content":"账号怎么来","locale":"zh-CN"},"7699":{"id":"/docs/providers-13","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#渠道的种类","content":"详见","locale":"zh-CN"},"7700":{"id":"/docs/providers-14","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#渠道的种类","content":"匿名入口","locale":"zh-CN"},"7701":{"id":"/docs/providers-15","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#渠道的种类","content":"`opencode`、`kilo`","locale":"zh-CN"},"7702":{"id":"/docs/providers-16","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#渠道的种类","content":"不需要账号，默认开启","locale":"zh-CN"},"7703":{"id":"/docs/providers-17","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#渠道的种类","content":"匿名入口","locale":"zh-CN"},"7704":{"id":"/docs/providers-18","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#渠道的种类","content":"免费站点与订阅登录","locale":"zh-CN"},"7705":{"id":"/docs/providers-19","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#渠道的种类","content":"`cline`、`gemini`、`zcode`、`minimax`、`trae`、`qoder`、`qodercn`、`qodercli`、`qodercli-cn`、`buddy`、`workbuddy`、`codearts`、`loomy`、`raccoon`、`lobsterai`、`codex`、`eac`、`zhipu`","locale":"zh-CN"},"7706":{"id":"/docs/providers-20","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#渠道的种类","content":"浏览器、设备码或令牌登录（`zhipu` 用 API 密钥，`qodercli` 用个人访问令牌）","locale":"zh-CN"},"7707":{"id":"/docs/providers-21","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#渠道的种类","content":"免费站点","locale":"zh-CN"},"7708":{"id":"/docs/providers-22","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#渠道的种类","content":"通用兼容入口","locale":"zh-CN"},"7709":{"id":"/docs/providers-23","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#渠道的种类","content":"`agg`","locale":"zh-CN"},"7710":{"id":"/docs/providers-24","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#渠道的种类","content":"自填地址或选 22 个预设之一，加 API 密钥","locale":"zh-CN"},"7711":{"id":"/docs/providers-25","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#渠道的种类","content":"聚合入口 agg","locale":"zh-CN"},"7712":{"id":"/docs/providers-26","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#渠道的种类","content":"云平台与特殊协议","locale":"zh-CN"},"7713":{"id":"/docs/providers-27","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#渠道的种类","content":"`azure`、`cloudflare-workers-ai`、`cloudflare-ai-gateway`、`google`、`google-vertex`、`amazon-bedrock`、`radius`、`typesafe`","locale":"zh-CN"},"7714":{"id":"/docs/providers-28","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#渠道的种类","content":"平台密钥、Google/AWS 凭据","locale":"zh-CN"},"7715":{"id":"/docs/providers-29","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#渠道的种类","content":"云平台","locale":"zh-CN"},"7716":{"id":"/docs/providers-30","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#渠道的种类","content":"NVIDIA NIM","locale":"zh-CN"},"7717":{"id":"/docs/providers-31","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#渠道的种类","content":"`nvidia`","locale":"zh-CN"},"7718":{"id":"/docs/providers-32","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#渠道的种类","content":"API 密钥","locale":"zh-CN"},"7719":{"id":"/docs/providers-33","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#渠道的种类","content":"NVIDIA NIM","locale":"zh-CN"},"7720":{"id":"/docs/providers-34","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#渠道的种类","content":"常规 API 服务与本地后端","locale":"zh-CN"},"7721":{"id":"/docs/providers-35","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#渠道的种类","content":"`openai`、`anthropic`、`openrouter`、`deepseek`、`groq`……；`lmstudio`、`ollama`、`llamacpp`","locale":"zh-CN"},"7722":{"id":"/docs/providers-36","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#渠道的种类","content":"API 密钥，部分支持登录；本地服务密钥可选","locale":"zh-CN"},"7723":{"id":"/docs/providers-37","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#渠道的种类","content":"本地与兼容端点","locale":"zh-CN"},"7724":{"id":"/docs/providers-38","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#渠道的种类","content":"所有渠道与其来源的对照见渠道清单。清单记录的是“有入口”，不代表上游当前一定可用。","locale":"zh-CN"},"7725":{"id":"/docs/providers-39","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#名字相近id-不同的服务","content":"同一家公司的不同产品、不同套餐、不同协议使用不同的渠道 ID，凭据不能互换：","locale":"zh-CN"},"7726":{"id":"/docs/providers-40","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#名字相近id-不同的服务","content":"`minimax` 是 MiniMax Agent 的登录账号；`minimax-api`、`minimax-cn`、`minimax-chat` 是三个按密钥计费的公开 API。","locale":"zh-CN"},"7727":{"id":"/docs/providers-41","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#名字相近id-不同的服务","content":"`gemini` 是 Gemini Code Assist（Google 账号登录）；`google` 是 Gemini Developer API（API 密钥）；`google-vertex` 是 Vertex AI。","locale":"zh-CN"},"7728":{"id":"/docs/providers-42","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#名字相近id-不同的服务","content":"`amazon-bedrock`（ConverseStream）和 `bedrock-mantle`（OpenAI 兼容端点）分别配置。","locale":"zh-CN"},"7729":{"id":"/docs/providers-43","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#名字相近id-不同的服务","content":"`zhipu` 是 bigmodel.cn 的通用 API；`zai`、`zai-coding-cn`、`zai-api` 是 Z.AI 的编码套餐和国际站 API；`zcode` 是 ZCode 客户端的登录通道。","locale":"zh-CN"},"7730":{"id":"/docs/providers-44","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#名字相近id-不同的服务","content":"`cline` 是 Cline 的免费登录通道；`cline-pass` 是 ClinePass 订阅密钥。","locale":"zh-CN"},"7731":{"id":"/docs/providers-45","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#名字相近id-不同的服务","content":"`typesafe` 提供分类，不是聊天模型。","locale":"zh-CN"},"7732":{"id":"/docs/providers-46","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#添加账号","content":"三种方式写入的是同一个文件：数据目录下的 `config.json`（用 `hoshimi config path` 查看位置）。网页界面和 `hoshimi login` 写入后立即生效；直接编辑文件需要重启服务。","locale":"zh-CN"},"7733":{"id":"/docs/providers-47","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#添加账号","content":"打开 **渠道** 页面，选中一个渠道。还没有账号的渠道在 **未设置** 筛选下。","locale":"zh-CN"},"7734":{"id":"/docs/providers-48","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#添加账号","content":"支持登录的渠道点 **登录**，按对话框提示在浏览器中完成授权；其余渠道点 **添加账号**，选择 **鉴权方式** 并填写表单，然后点 **保存账号**。","locale":"zh-CN"},"7735":{"id":"/docs/providers-49","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#添加账号","content":"账号出现在 **账户** 列表中。添加账号会顺带开启被关闭的渠道。","locale":"zh-CN"},"7736":{"id":"/docs/providers-50","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#添加账号","content":"同一站点身份重新登录时，会更新原有账号，而不是再叠加一个。删除账号用账号菜单中的 **删除**，凭据会同时从 `config.json` 和运行中的账号池移除。","locale":"zh-CN"},"7737":{"id":"/docs/providers-51","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#添加账号","content":"账号的令牌和密钥都以明文保存在 `config.json` 中。不要提交或分享填过真实凭据的文件；分享示例时用占位符替换。","locale":"zh-CN"},"7738":{"id":"/docs/providers-52","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#每个渠道的配置键","content":"键","locale":"zh-CN"},"7739":{"id":"/docs/providers-53","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#每个渠道的配置键","content":"说明","locale":"zh-CN"},"7740":{"id":"/docs/providers-54","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#每个渠道的配置键","content":"`providers.<id>.enabled`","locale":"zh-CN"},"7741":{"id":"/docs/providers-55","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#每个渠道的配置键","content":"`false` 完全关闭该渠道（匿名入口也用它关闭）。省略时为开启。","locale":"zh-CN"},"7742":{"id":"/docs/providers-56","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#每个渠道的配置键","content":"`providers.<id>.accounts`","locale":"zh-CN"},"7743":{"id":"/docs/providers-57","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#每个渠道的配置键","content":"账号列表，每项是一个对象，字段由渠道决定。","locale":"zh-CN"},"7744":{"id":"/docs/providers-58","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#每个渠道的配置键","content":"`providers.<id>.accounts[].id`","locale":"zh-CN"},"7745":{"id":"/docs/providers-59","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#每个渠道的配置键","content":"账号名，用于界面、用量统计和日志。省略时由网关命名（登录产生的账号形如 `cline-1a2b3c`，按位置推断的形如 `<id>-0`）。","locale":"zh-CN"},"7746":{"id":"/docs/providers-60","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#每个渠道的配置键","content":"`providers.<id>.options`","locale":"zh-CN"},"7747":{"id":"/docs/providers-61","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#每个渠道的配置键","content":"渠道级选项，例如 TRAE 的 `channel`、agg 的能力声明、本地服务的 `models`。","locale":"zh-CN"},"7748":{"id":"/docs/providers-62","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#每个渠道的配置键","content":"`providers.<id>.options.network`","locale":"zh-CN"},"7749":{"id":"/docs/providers-63","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#每个渠道的配置键","content":"该渠道自己的网络线路，默认继承全局设置，见网络与代理。","locale":"zh-CN"},"7750":{"id":"/docs/providers-64","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#选择模型路由规则","content":"客户端在请求的 `model` 字段中指定模型：","locale":"zh-CN"},"7751":{"id":"/docs/providers-65","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#选择模型路由规则","content":"写成 `渠道/模型`（例如 `opencode/big-pickle`、`nvidia/<model-id>`）会直接交给该渠道。","locale":"zh-CN"},"7752":{"id":"/docs/providers-66","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#选择模型路由规则","content":"只写模型 ID 时，网关按固定顺序查找第一个列出该 ID 的渠道：`cline`、`opencode`、`kilo`、`gemini`、`zcode`、`minimax`、`trae`、`qoder`、`qodercn`、`qodercli`、`qodercli-cn`、`buddy`、`workbuddy`、`codearts`、`loomy`、`raccoon`、`lobsterai`、`eac`、`agg`、`zhipu`、`nvidia`，然后是其他渠道。","locale":"zh-CN"},"7753":{"id":"/docs/providers-67","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#选择模型路由规则","content":"只开启了一个渠道时，未知的 ID 也会原样转给它。","locale":"zh-CN"},"7754":{"id":"/docs/providers-68","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#选择模型路由规则","content":"`GET /v1/models` 中每个 ID 只出现一次，`owned_by` 是按上述顺序胜出的渠道。模型 ID 本身含有 `/` 时（例如 Kilo 的 `openrouter/free`），建议加上渠道前缀：`kilo/openrouter/free`，避免第一段被当成渠道名。客户端配置见接入客户端。","locale":"zh-CN"},"7755":{"id":"/docs/providers-69","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#账号池与轮换","content":"同一渠道的多个账号按配置顺序使用。一次请求遇到账号层面的失败时，网关会换下一个账号重试，每次请求最多尝试 `server.max_account_retries` 个账号（默认 3）：","locale":"zh-CN"},"7756":{"id":"/docs/providers-70","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#账号池与轮换","content":"额度用尽或限流：该账号暂停轮换，时长取上游给出的重置时间，没有则为一小时。","locale":"zh-CN"},"7757":{"id":"/docs/providers-71","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#账号池与轮换","content":"凭据被拒：先尝试续期，再换账号。续期令牌本身被拒绝时，账号标记为 **需要登录**，不再参与轮换，直到重新登录。","locale":"zh-CN"},"7758":{"id":"/docs/providers-72","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#账号池与轮换","content":"已经向客户端输出内容后，请求不会自动重放。","locale":"zh-CN"},"7759":{"id":"/docs/providers-73","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#账号池与轮换","content":"这些规则的完整说明见模型行为。","locale":"zh-CN"},"7760":{"id":"/docs/providers-74","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#续期与签到","content":"很多登录型站点的令牌会过期。开启 **凭据续期**（`server.auto_refresh`，默认开启）后，网关每 30 分钟检查一次，续期一小时内到期或没有记录到期时间的账号。开启 **每日签到**（`server.auto_checkin`，默认开启）后，网关每天按北京时间日期为支持签到的站点领取免费额度。哪些站点支持续期、签到和余额查询，见免费站点。","locale":"zh-CN"},"7761":{"id":"/docs/providers-75","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#怎样选择","content":"先试默认开启的匿名入口，不需要任何账号。","locale":"zh-CN"},"7762":{"id":"/docs/providers-76","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#怎样选择","content":"想要更多免费额度，登录免费站点；多登录几个账号能让轮换更从容。","locale":"zh-CN"},"7763":{"id":"/docs/providers-77","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#怎样选择","content":"已有某个 OpenAI 兼容服务的密钥：它在原生渠道列表中就用原生渠道（见本地与兼容端点），否则用 agg。","locale":"zh-CN"},"7764":{"id":"/docs/providers-78","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#怎样选择","content":"企业云账号用云平台对应的渠道；本机模型用 LM Studio、Ollama 或 llama.cpp。","locale":"zh-CN"},"7765":{"id":"/docs/providers-79","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#怎样选择","content":"<Card title=\"匿名入口\" href=\"/docs/providers-anonymous\" description=\"OpenCode Zen 和 Kilo：无需账号的免费模型。\" />","locale":"zh-CN"},"7766":{"id":"/docs/providers-80","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#怎样选择","content":"<Card title=\"免费站点\" href=\"/docs/providers-stations\" description=\"每个登录型站点怎样登录、提供什么、注意什么。\" />","locale":"zh-CN"},"7767":{"id":"/docs/providers-81","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#怎样选择","content":"<Card title=\"聚合入口 agg\" href=\"/docs/providers-agg\" description=\"任意 OpenAI 兼容站点，以及 22 个站点预设。\" />","locale":"zh-CN"},"7768":{"id":"/docs/providers-82","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#怎样选择","content":"<Card title=\"云平台\" href=\"/docs/providers-cloud\" description=\"Azure、Cloudflare、Gemini、Vertex、Bedrock 与特殊协议。\" />","locale":"zh-CN"},"7769":{"id":"/docs/providers-83","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#怎样选择","content":"<Card title=\"NVIDIA NIM\" href=\"/docs/providers-nvidia\" description=\"NVIDIA 托管模型的账号与兼容转换。\" />","locale":"zh-CN"},"7770":{"id":"/docs/providers-84","page_id":"/docs/providers","tags":[],"type":"text","url":"/docs/providers#怎样选择","content":"<Card title=\"本地与兼容端点\" href=\"/docs/providers-local\" description=\"LM Studio、Ollama、llama.cpp 和按密钥接入的常规 API。\" />","locale":"zh-CN"},"7771":{"id":"/docs/quick-start","page_id":"/docs/quick-start","type":"page","content":"快速开始","breadcrumbs":["Hoshimi 文档","开始"],"tags":[],"url":"/docs/quick-start","locale":"zh-CN"},"7772":{"id":"/docs/quick-start-0","page_id":"/docs/quick-start","tags":[],"type":"text","url":"/docs/quick-start","content":"从零到第一次对话：安装 Hoshimi、启动服务器、在 Playground 里和模型聊一句，再用 curl 发出第一个 API 请求。","locale":"zh-CN"},"7773":{"id":"/docs/quick-start-1","page_id":"/docs/quick-start","type":"heading","tags":[],"url":"/docs/quick-start#安装","content":"安装","locale":"zh-CN"},"7774":{"id":"/docs/quick-start-2","page_id":"/docs/quick-start","type":"heading","tags":[],"url":"/docs/quick-start#启动服务器","content":"启动服务器","locale":"zh-CN"},"7775":{"id":"/docs/quick-start-3","page_id":"/docs/quick-start","type":"heading","tags":[],"url":"/docs/quick-start#看一眼概览页","content":"看一眼概览页","locale":"zh-CN"},"7776":{"id":"/docs/quick-start-4","page_id":"/docs/quick-start","type":"heading","tags":[],"url":"/docs/quick-start#在-playground-里聊第一句","content":"在 Playground 里聊第一句","locale":"zh-CN"},"7777":{"id":"/docs/quick-start-5","page_id":"/docs/quick-start","type":"heading","tags":[],"url":"/docs/quick-start#发出第一个-api-请求","content":"发出第一个 API 请求","locale":"zh-CN"},"7778":{"id":"/docs/quick-start-6","page_id":"/docs/quick-start","type":"heading","tags":[],"url":"/docs/quick-start#命令行中的同样检查","content":"命令行中的同样检查","locale":"zh-CN"},"7779":{"id":"/docs/quick-start-7","page_id":"/docs/quick-start","type":"heading","tags":[],"url":"/docs/quick-start#接下来","content":"接下来","locale":"zh-CN"},"7780":{"id":"/docs/quick-start-8","page_id":"/docs/quick-start","tags":[],"type":"text","url":"/docs/quick-start","content":"本页走最短的路线，只用默认启用的匿名渠道，不需要任何账户。每一步的细节见安装和首次运行。","locale":"zh-CN"},"7781":{"id":"/docs/quick-start-9","page_id":"/docs/quick-start","tags":[],"type":"text","url":"/docs/quick-start#安装","content":"需要 Python 3.10 或更高版本。从 PyPI 安装：","locale":"zh-CN"},"7782":{"id":"/docs/quick-start-10","page_id":"/docs/quick-start","tags":[],"type":"text","url":"/docs/quick-start#安装","content":"发行包已经包含构建好的 Web UI，不需要 Node 或 Bun。用 uv 或 pipx 安装、云平台的可选依赖见安装。","locale":"zh-CN"},"7783":{"id":"/docs/quick-start-11","page_id":"/docs/quick-start","tags":[],"type":"text","url":"/docs/quick-start#启动服务器","content":"服务器就绪后终端会打印一行 `SERVER_READY url=http://127.0.0.1:10600`，浏览器随后自动打开这个地址。默认只监听本机（`127.0.0.1`），端口 **10600**；端口被占用时会自动换用下一个空闲端口，此时以终端打印的 URL 为准。按 Ctrl+C 停止。","locale":"zh-CN"},"7784":{"id":"/docs/quick-start-12","page_id":"/docs/quick-start","tags":[],"type":"text","url":"/docs/quick-start#启动服务器","content":"`python -m hoshimi serve` 与 `hoshimi serve` 等价。不想自动打开浏览器时加 `--no-open`。","locale":"zh-CN"},"7785":{"id":"/docs/quick-start-13","page_id":"/docs/quick-start","tags":[],"type":"text","url":"/docs/quick-start#看一眼概览页","content":"界面打开后进入 **概览** 页。**渠道** 一栏里已经有两个渠道：**OpenCode Zen** 和 **Kilo AI**，都标着 **无需账户**。它们是默认启用的匿名入口，能用哪些模型取决于上游当时的目录、额度和服务状态。","locale":"zh-CN"},"7786":{"id":"/docs/quick-start-14","page_id":"/docs/quick-start","tags":[],"type":"text","url":"/docs/quick-start#看一眼概览页","content":"**接口** 一栏列出客户端要用的地址（`/v1/chat/completions`、`/v1/responses`、`/v1/messages` 等），每行都可以一键复制。","locale":"zh-CN"},"7787":{"id":"/docs/quick-start-15","page_id":"/docs/quick-start","tags":[],"type":"text","url":"/docs/quick-start#在-playground-里聊第一句","content":"在左侧导航栏打开 **Playground**。","locale":"zh-CN"},"7788":{"id":"/docs/quick-start-16","page_id":"/docs/quick-start","tags":[],"type":"text","url":"/docs/quick-start#在-playground-里聊第一句","content":"输入框下方的 **模型** 选择器已经选中了目录里的第一个模型；点它可以搜索并换成别的模型。","locale":"zh-CN"},"7789":{"id":"/docs/quick-start-17","page_id":"/docs/quick-start","tags":[],"type":"text","url":"/docs/quick-start#在-playground-里聊第一句","content":"在输入框（**有问题，尽管问…**）里输入一句话，按 Enter 发送（Shift+Enter 换行）。","locale":"zh-CN"},"7790":{"id":"/docs/quick-start-18","page_id":"/docs/quick-start","tags":[],"type":"text","url":"/docs/quick-start#在-playground-里聊第一句","content":"回复以流式显示。对话会自动保存并命名，出现在侧边栏的 **对话** 列表中。某个模型失败时，换一个再试即可：匿名入口的模型随时可能限流或下线。","locale":"zh-CN"},"7791":{"id":"/docs/quick-start-19","page_id":"/docs/quick-start","tags":[],"type":"text","url":"/docs/quick-start#发出第一个-api-请求","content":"先列出模型，从返回的 `data[].id` 里挑一个填进 `<model-id>`：","locale":"zh-CN"},"7792":{"id":"/docs/quick-start-20","page_id":"/docs/quick-start","tags":[],"type":"text","url":"/docs/quick-start#发出第一个-api-请求","content":"Chat Completions 默认以流式（SSE）返回；上面的 `\"stream\": false` 让它返回一个完整的 JSON。在 Playground 里，回复下方 **更多操作** 菜单中的 **复制为 API 请求** 会把当前对话复制成一条等价的请求。","locale":"zh-CN"},"7793":{"id":"/docs/quick-start-21","page_id":"/docs/quick-start","tags":[],"type":"text","url":"/docs/quick-start#发出第一个-api-请求","content":"用 OpenAI 的 Python SDK 时，把 Base URL 指向 `/v1`：","locale":"zh-CN"},"7794":{"id":"/docs/quick-start-22","page_id":"/docs/quick-start","tags":[],"type":"text","url":"/docs/quick-start#发出第一个-api-请求","content":"没有设置模型 API 密钥时，`api_key` 可以填任意值；设置之后，请求要带上 `Authorization: Bearer <model-api-key>`。","locale":"zh-CN"},"7795":{"id":"/docs/quick-start-23","page_id":"/docs/quick-start","tags":[],"type":"text","url":"/docs/quick-start#命令行中的同样检查","content":"不打开浏览器，也可以用命令行确认渠道和模型（服务器不需要在运行）：","locale":"zh-CN"},"7796":{"id":"/docs/quick-start-24","page_id":"/docs/quick-start","tags":[],"type":"text","url":"/docs/quick-start#接下来","content":"添加更多渠道：在 **渠道** 页登录免费站点或填入 API Key，见渠道和渠道概念。","locale":"zh-CN"},"7797":{"id":"/docs/quick-start-25","page_id":"/docs/quick-start","tags":[],"type":"text","url":"/docs/quick-start#接下来","content":"接入 Claude Code、Codex、OpenCode 或自己的程序：接入客户端。","locale":"zh-CN"},"7798":{"id":"/docs/quick-start-26","page_id":"/docs/quick-start","tags":[],"type":"text","url":"/docs/quick-start#接下来","content":"让局域网里的其他机器访问，或给界面加上访问密钥：安全。","locale":"zh-CN"},"7799":{"id":"/docs/quick-start-27","page_id":"/docs/quick-start","tags":[],"type":"text","url":"/docs/quick-start#接下来","content":"第一次打开界面时各个页面的作用：首次运行。","locale":"zh-CN"},"7800":{"id":"/en/docs/advanced-eac","page_id":"/en/docs/advanced-eac","type":"page","content":"EAC","breadcrumbs":["Hoshimi Documentation","Advanced"],"tags":[],"url":"/en/docs/advanced-eac","locale":"en"},"7801":{"id":"/en/docs/advanced-eac-0","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac","content":"The EAC co-paid channel: enabling it with the bundled relay and a GitHub authorization, the worker and direct relay modes, account fields for your own relay, request signing, and common errors.","locale":"en"},"7802":{"id":"/en/docs/advanced-eac-1","page_id":"/en/docs/advanced-eac","type":"heading","tags":[],"url":"/en/docs/advanced-eac#enabling-it-with-the-bundled-relay","content":"Enabling it with the bundled relay","locale":"en"},"7803":{"id":"/en/docs/advanced-eac-2","page_id":"/en/docs/advanced-eac","type":"heading","tags":[],"url":"/en/docs/advanced-eac#start-the-login","content":"Start the login","locale":"en"},"7804":{"id":"/en/docs/advanced-eac-3","page_id":"/en/docs/advanced-eac","type":"heading","tags":[],"url":"/en/docs/advanced-eac#authorize-on-github","content":"Authorize on GitHub","locale":"en"},"7805":{"id":"/en/docs/advanced-eac-4","page_id":"/en/docs/advanced-eac","type":"heading","tags":[],"url":"/en/docs/advanced-eac#done","content":"Done","locale":"en"},"7806":{"id":"/en/docs/advanced-eac-5","page_id":"/en/docs/advanced-eac","type":"heading","tags":[],"url":"/en/docs/advanced-eac#the-two-relay-modes","content":"The two relay modes","locale":"en"},"7807":{"id":"/en/docs/advanced-eac-6","page_id":"/en/docs/advanced-eac","type":"heading","tags":[],"url":"/en/docs/advanced-eac#worker-mode-signing","content":"Worker-mode signing","locale":"en"},"7808":{"id":"/en/docs/advanced-eac-7","page_id":"/en/docs/advanced-eac","type":"heading","tags":[],"url":"/en/docs/advanced-eac#where-the-github-authorization-token-comes-from","content":"Where the GitHub authorization token comes from","locale":"en"},"7809":{"id":"/en/docs/advanced-eac-8","page_id":"/en/docs/advanced-eac","type":"heading","tags":[],"url":"/en/docs/advanced-eac#your-own-relay","content":"Your own relay","locale":"en"},"7810":{"id":"/en/docs/advanced-eac-9","page_id":"/en/docs/advanced-eac","type":"heading","tags":[],"url":"/en/docs/advanced-eac#common-errors","content":"Common errors","locale":"en"},"7811":{"id":"/en/docs/advanced-eac-10","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac","content":"EAC (shown as **EAC (co-paid)** in the UI) is a co-paid channel reached through a relay. The relay speaks OpenAI Chat Completions and only serves installs that have completed its authorization. It has no anonymous mode and runs only once an account is configured; until then, `GET /api/v1/providers` still lists it with `requires_authorization: true`, which is how the Web UI knows to say it needs authorization.","locale":"en"},"7812":{"id":"/en/docs/advanced-eac-11","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#enabling-it-with-the-bundled-relay","content":"Hoshimi ships with a relay address and its signing credential, so a fresh install only needs a GitHub authorization:","locale":"en"},"7813":{"id":"/en/docs/advanced-eac-12","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#start-the-login","content":"Open EAC on the **Channels** page and press **Sign in**, or run:","locale":"en"},"7814":{"id":"/en/docs/advanced-eac-13","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#start-the-login","content":"The command prints the relay's GitHub authorization link and opens it in a browser (`--no-open` prints it only).","locale":"en"},"7815":{"id":"/en/docs/advanced-eac-14","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#authorize-on-github","content":"Authorize with your GitHub account on the page that opens. The relay requires this GitHub account to have starred the upstream repository; otherwise the login fails with `the GitHub account has not starred the upstream repository`.","locale":"en"},"7816":{"id":"/en/docs/advanced-eac-15","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#done","content":"On success Hoshimi creates the account `eac-default` in `config.json`:","locale":"en"},"7817":{"id":"/en/docs/advanced-eac-16","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#done","content":"It also saves the authorization token in `eac-user.json` in the data directory (owner read/write only). The bundled relay's signing credential is never written to the config file; it is opened afresh for each request.","locale":"en"},"7818":{"id":"/en/docs/advanced-eac-17","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#done","content":"EAC's models are listed with an `EAC` prefix, such as **EAC Kimi K3**. Their ids carry the upstream organization prefix, for example `moonshotai/kimi-k3`, `z-ai/glm-5.3` and `opencode/glm-5.3-flash-free`. When the relay's model list cannot be fetched, a built-in fallback list is used. Most of these models have their own reasoning levels; see Model and account behaviour.","locale":"en"},"7819":{"id":"/en/docs/advanced-eac-18","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#the-two-relay-modes","content":"The account's credential decides the mode:","locale":"en"},"7820":{"id":"/en/docs/advanced-eac-19","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#the-two-relay-modes","content":"Mode","locale":"en"},"7821":{"id":"/en/docs/advanced-eac-20","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#the-two-relay-modes","content":"Account fields","locale":"en"},"7822":{"id":"/en/docs/advanced-eac-21","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#the-two-relay-modes","content":"What a request carries","locale":"en"},"7823":{"id":"/en/docs/advanced-eac-22","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#the-two-relay-modes","content":"worker","locale":"en"},"7824":{"id":"/en/docs/advanced-eac-23","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#the-two-relay-modes","content":"`base_url` + `signing_secret` (the bundled relay is one)","locale":"en"},"7825":{"id":"/en/docs/advanced-eac-24","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#the-two-relay-modes","content":"No secret at all, only a timestamp and an HMAC signature, plus the GitHub authorization token in `x-ofm-user`","locale":"en"},"7826":{"id":"/en/docs/advanced-eac-25","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#the-two-relay-modes","content":"direct","locale":"en"},"7827":{"id":"/en/docs/advanced-eac-26","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#the-two-relay-modes","content":"`base_url` + `access_token`","locale":"en"},"7828":{"id":"/en/docs/advanced-eac-27","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#the-two-relay-modes","content":"`Authorization: Bearer <access_token>`, no GitHub authorization","locale":"en"},"7829":{"id":"/en/docs/advanced-eac-28","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#the-two-relay-modes","content":"In worker mode a leaked request contains no reusable secret, and the relay can revoke access at any time.","locale":"en"},"7830":{"id":"/en/docs/advanced-eac-29","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#worker-mode-signing","content":"Each request carries two headers:","locale":"en"},"7831":{"id":"/en/docs/advanced-eac-30","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#worker-mode-signing","content":"`x-ofm-timestamp`: a timestamp in milliseconds;","locale":"en"},"7832":{"id":"/en/docs/advanced-eac-31","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#worker-mode-signing","content":"`x-ofm-signature`: the hex HMAC-SHA256 of the string below, keyed with `signing_secret`.","locale":"en"},"7833":{"id":"/en/docs/advanced-eac-32","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#worker-mode-signing","content":"The signature covers the body's hash, so the body is serialized once and the same bytes are signed and sent; anything that re-encodes the body after signing makes the relay's check fail.","locale":"en"},"7834":{"id":"/en/docs/advanced-eac-33","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#where-the-github-authorization-token-comes-from","content":"In worker mode, `x-ofm-user` follows the account's `user_token`:","locale":"en"},"7835":{"id":"/en/docs/advanced-eac-34","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#where-the-github-authorization-token-comes-from","content":"`user_token` in the account","locale":"en"},"7836":{"id":"/en/docs/advanced-eac-35","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#where-the-github-authorization-token-comes-from","content":"Used","locale":"en"},"7837":{"id":"/en/docs/advanced-eac-36","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#where-the-github-authorization-token-comes-from","content":"Field absent","locale":"en"},"7838":{"id":"/en/docs/advanced-eac-37","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#where-the-github-authorization-token-comes-from","content":"The latest token in `eac-user.json`, read on every request, so a new login applies at once","locale":"en"},"7839":{"id":"/en/docs/advanced-eac-38","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#where-the-github-authorization-token-comes-from","content":"A string","locale":"en"},"7840":{"id":"/en/docs/advanced-eac-39","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#where-the-github-authorization-token-comes-from","content":"That string","locale":"en"},"7841":{"id":"/en/docs/advanced-eac-40","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#where-the-github-authorization-token-comes-from","content":"`null` or an empty string","locale":"en"},"7842":{"id":"/en/docs/advanced-eac-41","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#where-the-github-authorization-token-comes-from","content":"No `x-ofm-user`: this account does not use the install's GitHub identity","locale":"en"},"7843":{"id":"/en/docs/advanced-eac-42","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#where-the-github-authorization-token-comes-from","content":"Without an authorization the relay answers `401 AuthorizationRequired`; the gateway reports `eac: the relay demands this install's GitHub authorization (set the account's user_token)` and does not renew or rotate accounts over it.","locale":"en"},"7844":{"id":"/en/docs/advanced-eac-43","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#your-own-relay","content":"When adding an EAC account on the **Channels** page you can pick the bundled relay, a custom worker relay or a direct relay. Or write it in the configuration:","locale":"en"},"7845":{"id":"/en/docs/advanced-eac-44","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#your-own-relay","content":"Requirements:","locale":"en"},"7846":{"id":"/en/docs/advanced-eac-45","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#your-own-relay","content":"`base_url` is an HTTP(S) URL ending in `/v1`, with no user name, password, query or fragment;","locale":"en"},"7847":{"id":"/en/docs/advanced-eac-46","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#your-own-relay","content":"a custom relay needs either `signing_secret` (worker) or `access_token` (direct);","locale":"en"},"7848":{"id":"/en/docs/advanced-eac-47","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#your-own-relay","content":"an account with `relay: \"bundled\"` cannot also set `base_url`, `signing_secret` or `access_token`;","locale":"en"},"7849":{"id":"/en/docs/advanced-eac-48","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#your-own-relay","content":"GitHub login is for worker relays only; a direct relay uses its Bearer credential as is.","locale":"en"},"7850":{"id":"/en/docs/advanced-eac-49","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#your-own-relay","content":"Signing in again on an existing worker account updates that account's authorization and keeps its address and signing secret. For login, Hoshimi prefers a bundled-relay account or one with a `signing_secret`.","locale":"en"},"7851":{"id":"/en/docs/advanced-eac-50","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#common-errors","content":"Message","locale":"en"},"7852":{"id":"/en/docs/advanced-eac-51","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#common-errors","content":"Cause and fix","locale":"en"},"7853":{"id":"/en/docs/advanced-eac-52","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#common-errors","content":"`eac: the GitHub account has not starred the upstream repository`","locale":"en"},"7854":{"id":"/en/docs/advanced-eac-53","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#common-errors","content":"The GitHub account used has not starred the upstream repository","locale":"en"},"7855":{"id":"/en/docs/advanced-eac-54","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#common-errors","content":"`eac: authorization expired, please start again`","locale":"en"},"7856":{"id":"/en/docs/advanced-eac-55","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#common-errors","content":"The authorization link expired; sign in again","locale":"en"},"7857":{"id":"/en/docs/advanced-eac-56","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#common-errors","content":"`eac: login timed out (last status: …)`","locale":"en"},"7858":{"id":"/en/docs/advanced-eac-57","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#common-errors","content":"The authorization was not completed in time","locale":"en"},"7859":{"id":"/en/docs/advanced-eac-58","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#common-errors","content":"`eac: cannot reach the authorization service (…)`","locale":"en"},"7860":{"id":"/en/docs/advanced-eac-59","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#common-errors","content":"The relay cannot be reached; check the network or proxy, see Network and proxies","locale":"en"},"7861":{"id":"/en/docs/advanced-eac-60","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#common-errors","content":"`eac: GitHub authorization requires a worker relay; direct relays use their existing Bearer token`","locale":"en"},"7862":{"id":"/en/docs/advanced-eac-61","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#common-errors","content":"A GitHub login was started for a direct relay","locale":"en"},"7863":{"id":"/en/docs/advanced-eac-62","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#common-errors","content":"`eac: configure a worker relay with base_url and signing_secret, or use the bundled relay`","locale":"en"},"7864":{"id":"/en/docs/advanced-eac-63","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#common-errors","content":"The account is neither the bundled relay nor has a `base_url`","locale":"en"},"7865":{"id":"/en/docs/advanced-eac-64","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#common-errors","content":"`eac: base_url must be an HTTP(S) relay URL ending in /v1, without credentials, query or fragment`","locale":"en"},"7866":{"id":"/en/docs/advanced-eac-65","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#common-errors","content":"Malformed relay address","locale":"en"},"7867":{"id":"/en/docs/advanced-eac-66","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#common-errors","content":"`eac: a custom relay needs signing_secret (worker) or access_token (direct)`","locale":"en"},"7868":{"id":"/en/docs/advanced-eac-67","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#common-errors","content":"A custom relay without a credential","locale":"en"},"7869":{"id":"/en/docs/advanced-eac-68","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#common-errors","content":"`eac: a bundled relay reference cannot also specify a custom relay`","locale":"en"},"7870":{"id":"/en/docs/advanced-eac-69","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#common-errors","content":"A `relay: \"bundled\"` account also has custom fields","locale":"en"},"7871":{"id":"/en/docs/advanced-eac-70","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#common-errors","content":"`eac: the bundled relay configuration is unavailable; configure your own worker relay or update Hoshimi`","locale":"en"},"7872":{"id":"/en/docs/advanced-eac-71","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#common-errors","content":"The bundled relay credential cannot be used; upgrade Hoshimi or use your own relay","locale":"en"},"7873":{"id":"/en/docs/advanced-eac-72","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#common-errors","content":"`eac: failed to persist the per-install authorization; check data-dir permissions`","locale":"en"},"7874":{"id":"/en/docs/advanced-eac-73","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#common-errors","content":"`eac-user.json` could not be written; check the data directory's permissions","locale":"en"},"7875":{"id":"/en/docs/advanced-eac-74","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#common-errors","content":"`eac: the relay account changed or was removed during login; start again`","locale":"en"},"7876":{"id":"/en/docs/advanced-eac-75","page_id":"/en/docs/advanced-eac","tags":[],"type":"text","url":"/en/docs/advanced-eac#common-errors","content":"The account was changed or removed during the login","locale":"en"},"7877":{"id":"/en/docs/advanced-faq","page_id":"/en/docs/advanced-faq","type":"page","content":"FAQ","breadcrumbs":["Hoshimi Documentation","Advanced"],"tags":[],"url":"/en/docs/advanced-faq","locale":"en"},"7878":{"id":"/en/docs/advanced-faq-0","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq","content":"Common questions by topic: where data and logs are, changing the configuration while the server runs, which key to use, model id clashes, free markers, reasoning effort, account rotation, check-in and renewal, proxies, and the requests Hoshimi makes on its own.","locale":"en"},"7879":{"id":"/en/docs/advanced-faq-1","page_id":"/en/docs/advanced-faq","type":"heading","tags":[],"url":"/en/docs/advanced-faq#data-and-files","content":"Data and files","locale":"en"},"7880":{"id":"/en/docs/advanced-faq-2","page_id":"/en/docs/advanced-faq","type":"heading","tags":[],"url":"/en/docs/advanced-faq#access-and-security","content":"Access and security","locale":"en"},"7881":{"id":"/en/docs/advanced-faq-3","page_id":"/en/docs/advanced-faq","type":"heading","tags":[],"url":"/en/docs/advanced-faq#models","content":"Models","locale":"en"},"7882":{"id":"/en/docs/advanced-faq-4","page_id":"/en/docs/advanced-faq","type":"heading","tags":[],"url":"/en/docs/advanced-faq#accounts","content":"Accounts","locale":"en"},"7883":{"id":"/en/docs/advanced-faq-5","page_id":"/en/docs/advanced-faq","type":"heading","tags":[],"url":"/en/docs/advanced-faq#network-and-privacy","content":"Network and privacy","locale":"en"},"7884":{"id":"/en/docs/advanced-faq-6","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq","content":"For a specific error message, see Troubleshooting first.","locale":"en"},"7885":{"id":"/en/docs/advanced-faq-7","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#data-and-files","content":"In the data directory: `~/.local/share/hoshimi` on Linux, `~/Library/Application Support/hoshimi` on macOS, `%APPDATA%\\hoshimi` on Windows; `HOSHIMI_DATA_DIR` moves it elsewhere. `config.json` holds the settings and accounts; `hoshimi.db` holds usage, check-ins, probe verdicts and Playground conversations.","locale":"en"},"7886":{"id":"/en/docs/advanced-faq-8","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#data-and-files","content":"The Web UI's **Settings** › **About** also shows the **Data directory**, **Config file** and **Database**.","locale":"en"},"7887":{"id":"/en/docs/advanced-faq-9","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#data-and-files","content":"Hoshimi writes no log file; logs go to the terminal running `hoshimi serve` (stderr). Redirect them when you want a file, for example `hoshimi serve 2>> hoshimi.log`; as a system service, the service manager collects them. See Data directory and migration.","locale":"en"},"7888":{"id":"/en/docs/advanced-faq-10","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#data-and-files","content":"You can, but the change applies only after a restart, and **until that restart** any write by the server (a settings save in the Web UI, a login, a token renewal) puts its in-memory configuration back into the file, overwriting your change. The right order is: stop the server, make the change, start it again.","locale":"en"},"7889":{"id":"/en/docs/advanced-faq-11","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#data-and-files","content":"Changes made in the Web UI apply at once with no restart (except the listening address and port).","locale":"en"},"7890":{"id":"/en/docs/advanced-faq-12","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#data-and-files","content":"Yes. They read and write the same data directory (as long as `HOSHIMI_DATA_DIR` is the same), and the database supports several processes at once. Only the configuration file needs the care described above: command-line changes to it apply after the server restarts.","locale":"en"},"7891":{"id":"/en/docs/advanced-faq-13","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#data-and-files","content":"With the server stopped:","locale":"en"},"7892":{"id":"/en/docs/advanced-faq-14","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#data-and-files","content":"to move: copy the whole data directory and put it in the default location on the new machine, or point `HOSHIMI_DATA_DIR` at it;","locale":"en"},"7893":{"id":"/en/docs/advanced-faq-15","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#data-and-files","content":"to reset the settings: rename `config.json`. Remember the channel accounts are in this file too;","locale":"en"},"7894":{"id":"/en/docs/advanced-faq-16","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#data-and-files","content":"to clear every record: delete `hoshimi.db`; settings and accounts are untouched.","locale":"en"},"7895":{"id":"/en/docs/advanced-faq-17","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#data-and-files","content":"No. Usage records hold only the model, channel, account, token counts, timings and a short error message, with anything shaped like a key masked. Playground conversations, on the other hand, are kept in `hoshimi.db` until you delete them; temporary chats are deleted when left and at the next start. See Usage statistics.","locale":"en"},"7896":{"id":"/en/docs/advanced-faq-18","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#access-and-security","content":"By default the server listens on `127.0.0.1` only, so other machines cannot connect; the gateway also checks the `Host` header and browser origins, which stops malicious web pages from reaching it through your browser. On a single-user computer you can go without keys. If other users or programs you do not trust share the machine, set the tool access key and the model API key.","locale":"en"},"7897":{"id":"/en/docs/advanced-faq-19","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#access-and-security","content":"Clients that call `/v1/*` (editor plugins, agents, SDKs) use the **Model API key** (`server.model_api_key`). The Web UI, the Playground and the management API `/api/*` use the **Tool access key** (`server.access_token`). Neither key works in place of the other, and a surface whose key is not set needs none. See Access control.","locale":"en"},"7898":{"id":"/en/docs/advanced-faq-20","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#access-and-security","content":"Keys are never shown again after saving. Stop the server, set a new one and start again:","locale":"en"},"7899":{"id":"/en/docs/advanced-faq-21","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#access-and-security","content":"or remove it with `hoshimi config set server.access_token null`.","locale":"en"},"7900":{"id":"/en/docs/advanced-faq-22","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#access-and-security","content":"Set the tool access key, the model API key and `security.allow_cidrs`, change `server.host` to `0.0.0.0`, then restart. Without any one of these prerequisites the server refuses to start on a non-loopback address. The full steps are in Access control.","locale":"en"},"7901":{"id":"/en/docs/advanced-faq-23","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#models","content":"With a bare model id, the gateway takes the first channel in its built-in order that lists it, and `/v1/models` shows only that entry. To choose the channel, write `channel/model`, such as `kilo/<model id>`.","locale":"en"},"7902":{"id":"/en/docs/advanced-faq-24","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#models","content":"`null` means the station did not say whether the model is free. Hoshimi marks `true` or `false` only with evidence (the station's prices, free labels or pricing documents) and never guesses. A free marker does not promise available credits either. See pi-free migration and differences.","locale":"en"},"7903":{"id":"/en/docs/advanced-faq-25","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#models","content":"For reasoning models without a level menu of their own, the upstream does not act on `reasoning_effort`; only the output ceiling works, so the gateway turns the level into `max_tokens`: `light` 2,048, `balanced` 8,192, `deep` the model's full output limit (doubled for models that cannot switch thinking off, never below 512). When you send no level, your own `max_tokens` is kept as is. See Model and account behaviour.","locale":"en"},"7904":{"id":"/en/docs/advanced-faq-26","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#models","content":"No. The gateway only calls the model you asked for; on failure it retries with other accounts of the same channel, and the model stays the caller's choice. When an upstream says a model does not exist, the gateway remembers that for a while and answers `503 model_unavailable` directly instead of using another model.","locale":"en"},"7905":{"id":"/en/docs/advanced-faq-27","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#models","content":"The model is remembered as temporarily unavailable: the upstream's accounts all said it does not exist. This lifts after 10 minutes (or lasts until a restart after 3 such answers within 10 minutes). Once the upstream is back, `POST /api/v1/models/unavailable/reset` lifts it at once.","locale":"en"},"7906":{"id":"/en/docs/advanced-faq-28","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#models","content":"A little: one `ping` per model, at most 64 tokens, at most 2 at a time. By default only `opencode`, `nvidia` and `agg` are probed, the channels whose lists cannot tell availability; you can also probe specific models only.","locale":"en"},"7907":{"id":"/en/docs/advanced-faq-29","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#accounts","content":"At most `server.max_account_retries` (default 3). Rejected credentials, rate limits and server errors move to another account; a problem with the request itself (such as 400 or 422) does not, because every account would answer the same. A request that has already sent you content is never resent automatically, so you never get a duplicated answer.","locale":"en"},"7908":{"id":"/en/docs/advanced-faq-30","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#accounts","content":"With **Daily check-in** on, it runs 30 seconds after the server starts and then every 24 hours, using calendar days in Beijing time (UTC+8) to decide whether today is done. Accounts are checked in one after another, never in parallel. The **Channels** page has **Claim now** and **Check in all**.","locale":"en"},"7909":{"id":"/en/docs/advanced-faq-31","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#accounts","content":"The timer starts only when the server starts, and turning the switch off while it runs does not stop it. Also, `hoshimi serve` overrides the setting at start with `--refresh/--no-refresh` (on by default), and `--checkin/--no-checkin` likewise. To turn them off, start with `hoshimi serve --no-refresh` or `--no-checkin`.","locale":"en"},"7910":{"id":"/en/docs/advanced-faq-32","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#accounts","content":"Holds live in memory and a restart clears them. But a hold usually follows an upstream rate limit (lasting as long as the upstream said, one hour when it said nothing) or a policy block (30 minutes); a restart does not lift the upstream's limit, and the account will soon be held again.","locale":"en"},"7911":{"id":"/en/docs/advanced-faq-33","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#network-and-privacy","content":"The default `auto` mode reads the `HTTPS_PROXY`, `HTTP_PROXY`, `ALL_PROXY` and `NO_PROXY` environment variables. On Windows you can turn on **Use Windows system proxy when no environment proxy exists** to fall back to the system proxy. You can also set a proxy directly, or give single channels a different route. See Network and proxies.","locale":"en"},"7912":{"id":"/en/docs/advanced-faq-34","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#network-and-privacy","content":"Login pages opened in your browser use the browser's own network settings. The requests the gateway itself makes during a login (starting authorization, polling, exchanging tokens) use the channel's network policy.","locale":"en"},"7913":{"id":"/en/docs/advanced-faq-35","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#network-and-privacy","content":"Request","locale":"en"},"7914":{"id":"/en/docs/advanced-faq-36","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#network-and-privacy","content":"When","locale":"en"},"7915":{"id":"/en/docs/advanced-faq-37","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#network-and-privacy","content":"How to turn it off","locale":"en"},"7916":{"id":"/en/docs/advanced-faq-38","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#network-and-privacy","content":"Each channel's model catalogue","locale":"en"},"7917":{"id":"/en/docs/advanced-faq-39","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#network-and-privacy","content":"When models are listed or a bare model id is looked up (including opening the **Models** page or the Playground, and `hoshimi check`), then cached for 5 minutes","locale":"en"},"7918":{"id":"/en/docs/advanced-faq-40","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#network-and-privacy","content":"Turn off channels you do not use, including the two keyless ones, `opencode` and `kilo`","locale":"en"},"7919":{"id":"/en/docs/advanced-faq-41","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#network-and-privacy","content":"Credential renewal","locale":"en"},"7920":{"id":"/en/docs/advanced-faq-42","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#network-and-privacy","content":"One round every 30 minutes, only for accounts about to expire","locale":"en"},"7921":{"id":"/en/docs/advanced-faq-43","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#network-and-privacy","content":"`hoshimi serve --no-refresh`","locale":"en"},"7922":{"id":"/en/docs/advanced-faq-44","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#network-and-privacy","content":"Daily check-in","locale":"en"},"7923":{"id":"/en/docs/advanced-faq-45","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#network-and-privacy","content":"Once a day","locale":"en"},"7924":{"id":"/en/docs/advanced-faq-46","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#network-and-privacy","content":"`hoshimi serve --no-checkin`","locale":"en"},"7925":{"id":"/en/docs/advanced-faq-47","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#network-and-privacy","content":"Balance queries","locale":"en"},"7926":{"id":"/en/docs/advanced-faq-48","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#network-and-privacy","content":"Only when the **Channels** page is opened or `GET /api/v1/credits` is called","locale":"en"},"7927":{"id":"/en/docs/advanced-faq-49","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#network-and-privacy","content":"Not made otherwise","locale":"en"},"7928":{"id":"/en/docs/advanced-faq-50","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#network-and-privacy","content":"PyPI update check","locale":"en"},"7929":{"id":"/en/docs/advanced-faq-51","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#network-and-privacy","content":"At start and then daily","locale":"en"},"7930":{"id":"/en/docs/advanced-faq-52","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#network-and-privacy","content":"`server.check_updates: false`","locale":"en"},"7931":{"id":"/en/docs/advanced-faq-53","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#network-and-privacy","content":"models.dev capability metadata","locale":"en"},"7932":{"id":"/en/docs/advanced-faq-54","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#network-and-privacy","content":"Fetched in the background when vision and reasoning need filling in for undeclared models","locale":"en"},"7933":{"id":"/en/docs/advanced-faq-55","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#network-and-privacy","content":"No switch; on failure the bundled snapshot is used and requests are unaffected","locale":"en"},"7934":{"id":"/en/docs/advanced-faq-56","page_id":"/en/docs/advanced-faq","tags":[],"type":"text","url":"/en/docs/advanced-faq#network-and-privacy","content":"Hoshimi sends no telemetry.","locale":"en"},"7935":{"id":"/en/docs/advanced-models","page_id":"/en/docs/advanced-models","type":"page","content":"Model and account behaviour","breadcrumbs":["Hoshimi Documentation","Advanced"],"tags":[],"url":"/en/docs/advanced-models","locale":"en"},"7936":{"id":"/en/docs/advanced-models-0","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models","content":"How model names are routed to channels, how catalogues are discovered and cached, how capabilities and reasoning effort shape the request, availability probes, and how failures lead to account rotation, retries, renewal and quota records.","locale":"en"},"7937":{"id":"/en/docs/advanced-models-1","page_id":"/en/docs/advanced-models","type":"heading","tags":[],"url":"/en/docs/advanced-models#how-model-names-are-routed","content":"How model names are routed","locale":"en"},"7938":{"id":"/en/docs/advanced-models-2","page_id":"/en/docs/advanced-models","type":"heading","tags":[],"url":"/en/docs/advanced-models#model-catalogues","content":"Model catalogues","locale":"en"},"7939":{"id":"/en/docs/advanced-models-3","page_id":"/en/docs/advanced-models","type":"heading","tags":[],"url":"/en/docs/advanced-models#capabilities","content":"Capabilities","locale":"en"},"7940":{"id":"/en/docs/advanced-models-4","page_id":"/en/docs/advanced-models","type":"heading","tags":[],"url":"/en/docs/advanced-models#reasoning-effort","content":"Reasoning effort","locale":"en"},"7941":{"id":"/en/docs/advanced-models-5","page_id":"/en/docs/advanced-models","type":"heading","tags":[],"url":"/en/docs/advanced-models#availability-probes","content":"Availability probes","locale":"en"},"7942":{"id":"/en/docs/advanced-models-6","page_id":"/en/docs/advanced-models","type":"heading","tags":[],"url":"/en/docs/advanced-models#remembered-model-failures","content":"Remembered model failures","locale":"en"},"7943":{"id":"/en/docs/advanced-models-7","page_id":"/en/docs/advanced-models","type":"heading","tags":[],"url":"/en/docs/advanced-models#account-rotation-and-retries","content":"Account rotation and retries","locale":"en"},"7944":{"id":"/en/docs/advanced-models-8","page_id":"/en/docs/advanced-models","type":"heading","tags":[],"url":"/en/docs/advanced-models#credential-renewal","content":"Credential renewal","locale":"en"},"7945":{"id":"/en/docs/advanced-models-9","page_id":"/en/docs/advanced-models","type":"heading","tags":[],"url":"/en/docs/advanced-models#balances-check-in-and-passive-quota","content":"Balances, check-in and passive quota","locale":"en"},"7946":{"id":"/en/docs/advanced-models-10","page_id":"/en/docs/advanced-models","type":"heading","tags":[],"url":"/en/docs/advanced-models#balances-and-check-in","content":"Balances and check-in","locale":"en"},"7947":{"id":"/en/docs/advanced-models-11","page_id":"/en/docs/advanced-models","type":"heading","tags":[],"url":"/en/docs/advanced-models#passive-quota","content":"Passive quota","locale":"en"},"7948":{"id":"/en/docs/advanced-models-12","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models","content":"This page covers the decisions the gateway makes behind each request: which channel gets a model name, what the model can do, what `reasoning_effort` finally becomes, and whether a failure means another account, a wait or a retry. Everyday use does not require any of this; when a result is not what you expected, the answer is here.","locale":"en"},"7949":{"id":"/en/docs/advanced-models-13","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#how-model-names-are-routed","content":"The request's `model` is resolved in this order:","locale":"en"},"7950":{"id":"/en/docs/advanced-models-14","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#how-model-names-are-routed","content":"Written as `channel/model` (such as `kilo/some-model`) where `channel` is a running channel id: it goes to that channel, and everything after the slash is the upstream model name.","locale":"en"},"7951":{"id":"/en/docs/advanced-models-15","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#how-model-names-are-routed","content":"A bare model id: the first channel, in the built-in channel order (`cline`, `opencode`, `kilo`, `gemini`, `zcode`, `minimax`, `trae`, `qoder`, …), whose catalogue lists it.","locale":"en"},"7952":{"id":"/en/docs/advanced-models-16","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#how-model-names-are-routed","content":"No match, but only one channel is running: passed through to it as is.","locale":"en"},"7953":{"id":"/en/docs/advanced-models-17","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#how-model-names-are-routed","content":"Otherwise `404 model_not_found`:","locale":"en"},"7954":{"id":"/en/docs/advanced-models-18","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#how-model-names-are-routed","content":"A request without `model` uses `server.default_model`; when that is not set either, the answer is `model is required`.","locale":"en"},"7955":{"id":"/en/docs/advanced-models-19","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#how-model-names-are-routed","content":"When the same id appears on several channels, `/v1/models` lists only the first channel's entry. Use the `channel/model` form to pick the channel.","locale":"en"},"7956":{"id":"/en/docs/advanced-models-20","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#model-catalogues","content":"Each channel's model list comes from the upstream's own listing; capabilities come from Hoshimi's built-in capability tables and the declarations in your accounts.","locale":"en"},"7957":{"id":"/en/docs/advanced-models-21","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#model-catalogues","content":"**Cached for 5 minutes**: a channel's listing is not fetched again within 5 minutes.","locale":"en"},"7958":{"id":"/en/docs/advanced-models-22","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#model-catalogues","content":"**Guarded against sudden shrinking**: when a fresh listing has fewer than half the models of the previous one, the old list is kept for one more cycle and the log warns `the catalogue came back at N of M models (likely a partial answer)`. If the next cycle says the same, the new list is accepted.","locale":"en"},"7959":{"id":"/en/docs/advanced-models-23","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#model-catalogues","content":"**Kept on failure**: when a fetch fails, the last good catalogue stays and the fetch is retried after 30 seconds. A channel that never succeeded uses its built-in fallback list; fallback lists are historical data, not a claim that those models are available now.","locale":"en"},"7960":{"id":"/en/docs/advanced-models-24","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#model-catalogues","content":"**Kept across restarts**: every successful catalogue is saved in the data directory's `catalog-cache/` and restored at start (only snapshots up to 7 days old, for exactly the same accounts and options), then refreshed in the background at once.","locale":"en"},"7961":{"id":"/en/docs/advanced-models-25","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#model-catalogues","content":"The Web UI's **Models** page and the Playground load the catalogue through `GET /api/v1/catalog/stream` (SSE): cached results come first, then each channel's fresh result as it arrives. At most 8 fetches run at once; a round waits at most 20 seconds, marks unfinished channels as timed out and keeps the models already received. The standard `/v1/models` stays plain JSON.","locale":"en"},"7962":{"id":"/en/docs/advanced-models-26","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#capabilities","content":"The management API `GET /api/v1/models` reports each model's capabilities:","locale":"en"},"7963":{"id":"/en/docs/advanced-models-27","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#capabilities","content":"Field","locale":"en"},"7964":{"id":"/en/docs/advanced-models-28","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#capabilities","content":"Meaning","locale":"en"},"7965":{"id":"/en/docs/advanced-models-29","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#capabilities","content":"`vision`","locale":"en"},"7966":{"id":"/en/docs/advanced-models-30","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#capabilities","content":"Reads images","locale":"en"},"7967":{"id":"/en/docs/advanced-models-31","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#capabilities","content":"`reasoning`","locale":"en"},"7968":{"id":"/en/docs/advanced-models-32","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#capabilities","content":"Reasons (thinks)","locale":"en"},"7969":{"id":"/en/docs/advanced-models-33","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#capabilities","content":"`tools`","locale":"en"},"7970":{"id":"/en/docs/advanced-models-34","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#capabilities","content":"Supports tool calls; `null` means unknown","locale":"en"},"7971":{"id":"/en/docs/advanced-models-35","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#capabilities","content":"`context_window`, `max_output`","locale":"en"},"7972":{"id":"/en/docs/advanced-models-36","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#capabilities","content":"Context length and maximum output; 131072 and 32768 when nothing is known","locale":"en"},"7973":{"id":"/en/docs/advanced-models-37","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#capabilities","content":"`can_disable_thinking`","locale":"en"},"7974":{"id":"/en/docs/advanced-models-38","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#capabilities","content":"Thinking can be switched off","locale":"en"},"7975":{"id":"/en/docs/advanced-models-39","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#capabilities","content":"`region_sensitive`","locale":"en"},"7976":{"id":"/en/docs/advanced-models-40","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#capabilities","content":"Availability depends on the egress region","locale":"en"},"7977":{"id":"/en/docs/advanced-models-41","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#capabilities","content":"`free`","locale":"en"},"7978":{"id":"/en/docs/advanced-models-42","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#capabilities","content":"Free to use: `true`, `false` or `null` (unknown)","locale":"en"},"7979":{"id":"/en/docs/advanced-models-43","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#capabilities","content":"`efforts`, `effort_default`","locale":"en"},"7980":{"id":"/en/docs/advanced-models-44","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#capabilities","content":"The model's own reasoning levels and default level","locale":"en"},"7981":{"id":"/en/docs/advanced-models-45","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#capabilities","content":"`probe`","locale":"en"},"7982":{"id":"/en/docs/advanced-models-46","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#capabilities","content":"The latest availability probe verdict","locale":"en"},"7983":{"id":"/en/docs/advanced-models-47","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#capabilities","content":"`unavailable`","locale":"en"},"7984":{"id":"/en/docs/advanced-models-48","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#capabilities","content":"Currently remembered as gone by the gateway (see below)","locale":"en"},"7985":{"id":"/en/docs/advanced-models-49","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#capabilities","content":"Where capabilities come from, highest priority first:","locale":"en"},"7986":{"id":"/en/docs/advanced-models-50","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#capabilities","content":"The channel's built-in capability table, and declarations in an account or the channel options (such as `model_specs` for `agg`; see agg aggregator);","locale":"en"},"7987":{"id":"/en/docs/advanced-models-51","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#capabilities","content":"metadata carried by the upstream listing itself (some channels);","locale":"en"},"7988":{"id":"/en/docs/advanced-models-52","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#capabilities","content":"models.dev, which **only fills in** `vision` and `reasoning` for models nothing else declared.","locale":"en"},"7989":{"id":"/en/docs/advanced-models-53","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#capabilities","content":"models.dev never supplies context length, output limits or reasoning levels: the same id has different limits on different stations and plans, and those numbers must describe the endpoint you actually use. Hoshimi bundles an offline snapshot and, when online, fetches fresh data in the background; that only affects later lookups and never delays a request, and a failed fetch keeps what is already known.","locale":"en"},"7990":{"id":"/en/docs/advanced-models-54","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#capabilities","content":"`free` is evidence about the upstream's price or access, not a promise of unlimited quota; without evidence it is `null`. Local models are not marked free automatically. The per-station rules are in pi-free migration and differences.","locale":"en"},"7991":{"id":"/en/docs/advanced-models-55","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#reasoning-effort","content":"The gateway rewrites a request only when the caller names a level:","locale":"en"},"7992":{"id":"/en/docs/advanced-models-56","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#reasoning-effort","content":"Chat Completions' `reasoning_effort`, or the Responses-style `reasoning.effort`;","locale":"en"},"7993":{"id":"/en/docs/advanced-models-57","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#reasoning-effort","content":"without a level the body is sent as is, and the caller's own `max_tokens` is kept. The Playground's **Auto (server default)** sends no level.","locale":"en"},"7994":{"id":"/en/docs/advanced-models-58","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#reasoning-effort","content":"Native Anthropic Messages requests (forwarded directly to an upstream that speaks Messages) keep the caller's own thinking and output settings and skip these rules.","locale":"en"},"7995":{"id":"/en/docs/advanced-models-59","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#reasoning-effort","content":"With a level, there are three cases:","locale":"en"},"7996":{"id":"/en/docs/advanced-models-60","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#reasoning-effort","content":"Model","locale":"en"},"7997":{"id":"/en/docs/advanced-models-61","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#reasoning-effort","content":"Handling","locale":"en"},"7998":{"id":"/en/docs/advanced-models-62","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#reasoning-effort","content":"Has its own level menu (`efforts` not empty)","locale":"en"},"7999":{"id":"/en/docs/advanced-models-63","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#reasoning-effort","content":"The level is chosen and the patch the model declares is merged into the body (for example `reasoning_effort`, or `thinking` and `output_config.effort`); `max_tokens` becomes the smaller of the model's output limit and the caller's limit","locale":"en"},"8000":{"id":"/en/docs/advanced-models-64","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#reasoning-effort","content":"Reasons but has no menu","locale":"en"},"8001":{"id":"/en/docs/advanced-models-65","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#reasoning-effort","content":"Thinking is limited through the output ceiling: `light` 2,048, `balanced` 8,192, `deep` the model's full output limit","locale":"en"},"8002":{"id":"/en/docs/advanced-models-66","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#reasoning-effort","content":"Does not reason","locale":"en"},"8003":{"id":"/en/docs/advanced-models-67","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#reasoning-effort","content":"No rewrite","locale":"en"},"8004":{"id":"/en/docs/advanced-models-68","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#reasoning-effort","content":"How level names map:","locale":"en"},"8005":{"id":"/en/docs/advanced-models-69","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#reasoning-effort","content":"Caller sends","locale":"en"},"8006":{"id":"/en/docs/advanced-models-70","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#reasoning-effort","content":"Model without a menu (ladder)","locale":"en"},"8007":{"id":"/en/docs/advanced-models-71","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#reasoning-effort","content":"Model with a menu","locale":"en"},"8008":{"id":"/en/docs/advanced-models-72","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#reasoning-effort","content":"`minimal`, `low`","locale":"en"},"8009":{"id":"/en/docs/advanced-models-73","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#reasoning-effort","content":"`light`","locale":"en"},"8010":{"id":"/en/docs/advanced-models-74","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#reasoning-effort","content":"The same level when the menu has it; otherwise `minimal` becomes `low`","locale":"en"},"8011":{"id":"/en/docs/advanced-models-75","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#reasoning-effort","content":"`medium`","locale":"en"},"8012":{"id":"/en/docs/advanced-models-76","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#reasoning-effort","content":"`balanced`","locale":"en"},"8013":{"id":"/en/docs/advanced-models-77","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#reasoning-effort","content":"Used when the menu has it","locale":"en"},"8014":{"id":"/en/docs/advanced-models-78","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#reasoning-effort","content":"`high`","locale":"en"},"8015":{"id":"/en/docs/advanced-models-79","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#reasoning-effort","content":"`deep`","locale":"en"},"8016":{"id":"/en/docs/advanced-models-80","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#reasoning-effort","content":"Used when the menu has it","locale":"en"},"8017":{"id":"/en/docs/advanced-models-81","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#reasoning-effort","content":"`xhigh`, `max`","locale":"en"},"8018":{"id":"/en/docs/advanced-models-82","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#reasoning-effort","content":"`deep`","locale":"en"},"8019":{"id":"/en/docs/advanced-models-83","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#reasoning-effort","content":"The same level when the menu has it; otherwise `xhigh` becomes `max`","locale":"en"},"8020":{"id":"/en/docs/advanced-models-84","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#reasoning-effort","content":"`light`, `balanced`, `deep`","locale":"en"},"8021":{"id":"/en/docs/advanced-models-85","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#reasoning-effort","content":"As is","locale":"en"},"8022":{"id":"/en/docs/advanced-models-86","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#reasoning-effort","content":"Become `low`, `medium`, `high`","locale":"en"},"8023":{"id":"/en/docs/advanced-models-87","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#reasoning-effort","content":"A menu model that still has no matching level after this mapping uses its default level; a ladder model given an unknown level uses `balanced`.","locale":"en"},"8024":{"id":"/en/docs/advanced-models-88","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#reasoning-effort","content":"For menu models, `reasoning_effort` and `reasoning` fields already in the request are removed unless the patch sets them; `max_completion_tokens` is replaced by `max_tokens`.","locale":"en"},"8025":{"id":"/en/docs/advanced-models-89","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#reasoning-effort","content":"Models that cannot switch thinking off (`can_disable_thinking` is `false`) get doubled ladder ceilings, because thinking and the answer share one limit.","locale":"en"},"8026":{"id":"/en/docs/advanced-models-90","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#reasoning-effort","content":"The ladder ceiling is lowered further by the model's output limit and by a smaller `max_tokens` from the caller, but never below 512; so with an explicit level, a caller limit below 512 is raised to 512. For menu models the minimum is 1.","locale":"en"},"8027":{"id":"/en/docs/advanced-models-91","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#reasoning-effort","content":"For ladder models the `reasoning_effort` and `reasoning` fields are removed, because the upstream does not act on them; only `max_tokens` does.","locale":"en"},"8028":{"id":"/en/docs/advanced-models-92","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#reasoning-effort","content":"Each station spells its menu differently: Kilo uses a `reasoning` object, MiniMax and ZCode use `output_config.effort`, CodeArts uses `thinking.type`, Raccoon uses `extra_body.thinking`, and Gemini Code Assist's `gemini-3.8-flash` offers `low`, `medium`, `high` and `tiered` (the model decides). Do not assume every model has the same levels; `GET /api/v1/models` lists each id's `efforts` and the ceiling of each level.","locale":"en"},"8029":{"id":"/en/docs/advanced-models-93","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#availability-probes","content":"Some channels' listings are a bare list of ids that cannot say which models this egress may actually use. A probe asks each one with the smallest possible request (`ping`, at most 64 tokens).","locale":"en"},"8030":{"id":"/en/docs/advanced-models-94","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#availability-probes","content":"Press **Probe** on the **Models** page, or call the management API:","locale":"en"},"8031":{"id":"/en/docs/advanced-models-95","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#availability-probes","content":"Without a model list, the probe covers `opencode`, `nvidia` and `agg`, the channels whose listings cannot tell availability. Kilo's free list is already filtered upstream and is not in the default round.","locale":"en"},"8032":{"id":"/en/docs/advanced-models-96","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#availability-probes","content":"Probes run in the background, at most 2 at a time, each waiting at most 45 seconds. A request while a round is running does not start another and returns `started: false`.","locale":"en"},"8033":{"id":"/en/docs/advanced-models-97","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#availability-probes","content":"Model names that cannot be resolved come back in `unresolved`.","locale":"en"},"8034":{"id":"/en/docs/advanced-models-98","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#availability-probes","content":"Verdicts are saved in `hoshimi.db`, survive restarts, and are attached to each row of the **Models** page and `GET /api/v1/models`.","locale":"en"},"8035":{"id":"/en/docs/advanced-models-99","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#availability-probes","content":"Verdict","locale":"en"},"8036":{"id":"/en/docs/advanced-models-100","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#availability-probes","content":"Shown as","locale":"en"},"8037":{"id":"/en/docs/advanced-models-101","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#availability-probes","content":"Meaning","locale":"en"},"8038":{"id":"/en/docs/advanced-models-102","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#availability-probes","content":"`available`","locale":"en"},"8039":{"id":"/en/docs/advanced-models-103","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#availability-probes","content":"Available","locale":"en"},"8040":{"id":"/en/docs/advanced-models-104","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#availability-probes","content":"The model produced content or tokens","locale":"en"},"8041":{"id":"/en/docs/advanced-models-105","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#availability-probes","content":"`region-blocked`","locale":"en"},"8042":{"id":"/en/docs/advanced-models-106","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#availability-probes","content":"Region blocked","locale":"en"},"8043":{"id":"/en/docs/advanced-models-107","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#availability-probes","content":"Refused for this egress's region","locale":"en"},"8044":{"id":"/en/docs/advanced-models-108","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#availability-probes","content":"`unavailable`","locale":"en"},"8045":{"id":"/en/docs/advanced-models-109","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#availability-probes","content":"Unavailable","locale":"en"},"8046":{"id":"/en/docs/advanced-models-110","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#availability-probes","content":"A refusal about this model","locale":"en"},"8047":{"id":"/en/docs/advanced-models-111","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#availability-probes","content":"`throttled`","locale":"en"},"8048":{"id":"/en/docs/advanced-models-112","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#availability-probes","content":"Throttled","locale":"en"},"8049":{"id":"/en/docs/advanced-models-113","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#availability-probes","content":"Quota prevented the model from being asked","locale":"en"},"8050":{"id":"/en/docs/advanced-models-114","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#availability-probes","content":"`unknown`","locale":"en"},"8051":{"id":"/en/docs/advanced-models-115","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#availability-probes","content":"Unknown","locale":"en"},"8052":{"id":"/en/docs/advanced-models-116","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#availability-probes","content":"A credential, network or server failure; nothing is known about the model","locale":"en"},"8053":{"id":"/en/docs/advanced-models-117","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#availability-probes","content":"Only `unavailable` is a verdict about the model itself; region, quota and unknown results do not say a model is gone. When the Playground looks for a model to describe images, it skips models probed as `unavailable` or `region-blocked`.","locale":"en"},"8054":{"id":"/en/docs/advanced-models-118","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#remembered-model-failures","content":"Ordinary requests also teach the gateway when an upstream says a model does not exist:","locale":"en"},"8055":{"id":"/en/docs/advanced-models-119","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#remembered-model-failures","content":"HTTP `404` or `410`, or a `400`, `405`, `406`, `415`, `418`, `422` or `451` whose body clearly says the model does not exist (such as `model not found`, `does not exist`, `不存在`, `已下线`), counts as one strike against that model.","locale":"en"},"8056":{"id":"/en/docs/advanced-models-120","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#remembered-model-failures","content":"A body that also talks about quota, rate limits, balance, login or credentials does not count; `401`, `402`, `429` and `5xx` never count, whatever the body says.","locale":"en"},"8057":{"id":"/en/docs/advanced-models-121","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#remembered-model-failures","content":"A strike is recorded only when every account asked in the channel answered that way.","locale":"en"},"8058":{"id":"/en/docs/advanced-models-122","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#remembered-model-failures","content":"Once struck:","locale":"en"},"8059":{"id":"/en/docs/advanced-models-123","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#remembered-model-failures","content":"for 10 minutes from the first strike, requests for that model get `503 model_unavailable` (`… is temporarily unavailable: the station stopped answering for it.`) without reaching upstream;","locale":"en"},"8060":{"id":"/en/docs/advanced-models-124","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#remembered-model-failures","content":"three strikes within those 10 minutes make it unavailable for the rest of the run;","locale":"en"},"8061":{"id":"/en/docs/advanced-models-125","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#remembered-model-failures","content":"a normal answer from the model clears the record;","locale":"en"},"8062":{"id":"/en/docs/advanced-models-126","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#remembered-model-failures","content":"`POST /api/v1/models/unavailable/reset` or a server restart clears every record.","locale":"en"},"8063":{"id":"/en/docs/advanced-models-127","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#remembered-model-failures","content":"This record lives in memory only, unlike the probe verdicts saved in the database. A struck model is marked `unavailable` on the **Models** page and in `GET /api/v1/models`, but does not necessarily disappear from the list.","locale":"en"},"8064":{"id":"/en/docs/advanced-models-128","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#account-rotation-and-retries","content":"When a channel has several accounts, a request starts with the first usable one, skipping accounts that need a login or are held out of rotation. After a failure, the kind of failure decides what happens next:","locale":"en"},"8065":{"id":"/en/docs/advanced-models-129","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#account-rotation-and-retries","content":"Failure","locale":"en"},"8066":{"id":"/en/docs/advanced-models-130","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#account-rotation-and-retries","content":"Typical upstream answer","locale":"en"},"8067":{"id":"/en/docs/advanced-models-131","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#account-rotation-and-retries","content":"What the gateway does","locale":"en"},"8068":{"id":"/en/docs/advanced-models-132","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#account-rotation-and-retries","content":"Credentials rejected","locale":"en"},"8069":{"id":"/en/docs/advanced-models-133","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#account-rotation-and-retries","content":"`401`, or a `403` whose body is about credentials","locale":"en"},"8070":{"id":"/en/docs/advanced-models-134","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#account-rotation-and-retries","content":"Tries to renew this account's token and, if that works, retries with it; otherwise the next account","locale":"en"},"8071":{"id":"/en/docs/advanced-models-135","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#account-rotation-and-retries","content":"Permission denied","locale":"en"},"8072":{"id":"/en/docs/advanced-models-136","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#account-rotation-and-retries","content":"A `403` whose body is not about credentials","locale":"en"},"8073":{"id":"/en/docs/advanced-models-137","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#account-rotation-and-retries","content":"Returns at once, no rotation","locale":"en"},"8074":{"id":"/en/docs/advanced-models-138","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#account-rotation-and-retries","content":"Quota or rate limit","locale":"en"},"8075":{"id":"/en/docs/advanced-models-139","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#account-rotation-and-retries","content":"`402`, `429`, or a body about quota, rate limits or insufficient balance","locale":"en"},"8076":{"id":"/en/docs/advanced-models-140","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#account-rotation-and-retries","content":"Holds this account out of rotation, then the next account","locale":"en"},"8077":{"id":"/en/docs/advanced-models-141","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#account-rotation-and-retries","content":"Policy block","locale":"en"},"8078":{"id":"/en/docs/advanced-models-142","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#account-rotation-and-retries","content":"CodeBuddy business code `11140`, or \"safety review\" and similar","locale":"en"},"8079":{"id":"/en/docs/advanced-models-143","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#account-rotation-and-retries","content":"Holds the account for 30 minutes without renewing its token, then the next account","locale":"en"},"8080":{"id":"/en/docs/advanced-models-144","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#account-rotation-and-retries","content":"Model saturated","locale":"en"},"8081":{"id":"/en/docs/advanced-models-145","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#account-rotation-and-retries","content":"CodeBuddy business code `14003` (offering only `SWITCH_MODEL`), or \"model busy\" and similar","locale":"en"},"8082":{"id":"/en/docs/advanced-models-146","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#account-rotation-and-retries","content":"Returns the upstream's message to the caller at once: every account would meet the same wall","locale":"en"},"8083":{"id":"/en/docs/advanced-models-147","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#account-rotation-and-retries","content":"Model does not exist","locale":"en"},"8084":{"id":"/en/docs/advanced-models-148","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#account-rotation-and-retries","content":"`404`, `410` and the like (see the previous section)","locale":"en"},"8085":{"id":"/en/docs/advanced-models-149","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#account-rotation-and-retries","content":"Asks the other accounts; when all agree, records a strike","locale":"en"},"8086":{"id":"/en/docs/advanced-models-150","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#account-rotation-and-retries","content":"Recoverable error","locale":"en"},"8087":{"id":"/en/docs/advanced-models-151","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#account-rotation-and-retries","content":"`408`, `409`, `425`, `500`, `502`, `503`, `504`, `507`, Cloudflare `521`–`527`, Anthropic `529`, and any status not in a table","locale":"en"},"8088":{"id":"/en/docs/advanced-models-152","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#account-rotation-and-retries","content":"The next account","locale":"en"},"8089":{"id":"/en/docs/advanced-models-153","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#account-rotation-and-retries","content":"The request itself","locale":"en"},"8090":{"id":"/en/docs/advanced-models-154","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#account-rotation-and-retries","content":"`400`, `405`, `406`, `415`, `418`, `422`, `451`","locale":"en"},"8091":{"id":"/en/docs/advanced-models-155","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#account-rotation-and-retries","content":"Returns at once: every account would answer the same","locale":"en"},"8092":{"id":"/en/docs/advanced-models-156","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#account-rotation-and-retries","content":"Rules:","locale":"en"},"8093":{"id":"/en/docs/advanced-models-157","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#account-rotation-and-retries","content":"A request tries at most `server.max_account_retries` (default 3) different accounts.","locale":"en"},"8094":{"id":"/en/docs/advanced-models-158","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#account-rotation-and-retries","content":"**How long a quota hold lasts**: the `Retry-After` header first, then a reset time stated in the body (such as `将在 2026-09-11 18:08:17 UTC+8 重置` or `reset at … UTC+8`, converted with its stated offset), and one hour when neither exists. A running hold is never shortened.","locale":"en"},"8095":{"id":"/en/docs/advanced-models-159","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#account-rotation-and-retries","content":"When every account has been asked and the last failure was recoverable (not credentials, quota, policy or a missing model), the gateway waits and tries the pool again, at most twice. The wait is `Retry-After` or the body's reset time when given, capped at 8 seconds; `Retry-After: 0` means at once. Otherwise it is random (a ceiling starting at 0.25 seconds that doubles, up to 8 seconds).","locale":"en"},"8096":{"id":"/en/docs/advanced-models-160","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#account-rotation-and-retries","content":"**A request that has already sent content to the caller is never replayed automatically**, so the same answer never arrives twice.","locale":"en"},"8097":{"id":"/en/docs/advanced-models-161","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#account-rotation-and-retries","content":"When a channel has no account left to try at all (all need a login or are held), the answer is `502`: `Provider '…' exhausted all accounts.`","locale":"en"},"8098":{"id":"/en/docs/advanced-models-162","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#account-rotation-and-retries","content":"Accounts held out of rotation, and why, are shown on the **Channels** page (**Resting**, with **Rate limited** or **Blocked by policy**) and in `cooled` of `GET /api/v1/credits`. Holds live in memory and are cleared by a restart.","locale":"en"},"8099":{"id":"/en/docs/advanced-models-163","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#credential-renewal","content":"Accounts with a refresh token are kept fresh by the renewal timer (`server.auto_refresh`):","locale":"en"},"8100":{"id":"/en/docs/advanced-models-164","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#credential-renewal","content":"the first round runs 30 seconds after start, then one every 30 minutes;","locale":"en"},"8101":{"id":"/en/docs/advanced-models-165","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#credential-renewal","content":"each round renews accounts expiring within the hour; accounts with no recorded expiry are renewed every round;","locale":"en"},"8102":{"id":"/en/docs/advanced-models-166","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#credential-renewal","content":"after a successful renewal, the new tokens are written back to that one account in `config.json`;","locale":"en"},"8103":{"id":"/en/docs/advanced-models-167","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#credential-renewal","content":"when the upstream rejects the refresh token itself (such as `invalid_grant`, or a `401` with no explanation), the account is marked **Needs login** and leaves rotation until you sign in again; other failures are retried next round. A bare `403` never invalidates an account.","locale":"en"},"8104":{"id":"/en/docs/advanced-models-168","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#credential-renewal","content":"A request that meets rejected credentials also renews once on the spot. Renewal state and manual renewal:","locale":"en"},"8105":{"id":"/en/docs/advanced-models-169","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#credential-renewal","content":"`force` renews whether or not expiry is near; accounts marked as needing a login are skipped even with `force`. In the Web UI these are **Renew now** and **Renew every account** on the **Channels** page.","locale":"en"},"8106":{"id":"/en/docs/advanced-models-170","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#balances-and-check-in","content":"`GET /api/v1/credits` reads each account's balance, the accounts held out of rotation and the check-in state; `POST /api/v1/credits/claim` (optionally with `{\"provider\": \"…\"}`) checks in now; `GET /api/v1/credits/checkins` lists the check-in history. Channels without a balance or check-in endpoint are skipped.","locale":"en"},"8107":{"id":"/en/docs/advanced-models-171","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#balances-and-check-in","content":"With `server.auto_checkin` on, the first check-in round runs 30 seconds after start, then one every 24 hours. Days are calendar days in Beijing time (UTC+8); once an account has checked in for the day (or the station says it already has), the day is not repeated. Accounts are checked in one after another, never in parallel, to avoid tripping the stations' risk controls. Every outcome, scheduled or manual, joins a 365-day history.","locale":"en"},"8108":{"id":"/en/docs/advanced-models-172","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#passive-quota","content":"Upstream answers often carry quota information. The gateway reads the remaining amount and the limit from the headers of inference responses, with no extra request. The first pair that parses wins, in this order:","locale":"en"},"8109":{"id":"/en/docs/advanced-models-173","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#passive-quota","content":"Remaining","locale":"en"},"8110":{"id":"/en/docs/advanced-models-174","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#passive-quota","content":"Limit","locale":"en"},"8111":{"id":"/en/docs/advanced-models-175","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#passive-quota","content":"`x-ratelimit-remaining-requests`","locale":"en"},"8112":{"id":"/en/docs/advanced-models-176","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#passive-quota","content":"`x-ratelimit-limit-requests`","locale":"en"},"8113":{"id":"/en/docs/advanced-models-177","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#passive-quota","content":"`x-ratelimit-remaining`","locale":"en"},"8114":{"id":"/en/docs/advanced-models-178","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#passive-quota","content":"`x-ratelimit-limit`","locale":"en"},"8115":{"id":"/en/docs/advanced-models-179","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#passive-quota","content":"`ratelimit-remaining-requests`","locale":"en"},"8116":{"id":"/en/docs/advanced-models-180","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#passive-quota","content":"`ratelimit-limit-requests`","locale":"en"},"8117":{"id":"/en/docs/advanced-models-181","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#passive-quota","content":"`ratelimit-remaining`","locale":"en"},"8118":{"id":"/en/docs/advanced-models-182","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#passive-quota","content":"`ratelimit-limit`","locale":"en"},"8119":{"id":"/en/docs/advanced-models-183","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#passive-quota","content":"`x-ratelimit-remaining-requests-day`","locale":"en"},"8120":{"id":"/en/docs/advanced-models-184","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#passive-quota","content":"`x-ratelimit-limit-requests-day`","locale":"en"},"8121":{"id":"/en/docs/advanced-models-185","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#passive-quota","content":"`x-ratelimit-remaining-day`","locale":"en"},"8122":{"id":"/en/docs/advanced-models-186","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#passive-quota","content":"`x-ratelimit-limit-day`","locale":"en"},"8123":{"id":"/en/docs/advanced-models-187","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#passive-quota","content":"Parsing is strict: `10 requests` is not read as 10. When remaining and limit headers are both present but no pair parses, an \"unreadable quota header\" is counted.","locale":"en"},"8124":{"id":"/en/docs/advanced-models-188","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#passive-quota","content":"Percentages are clamped to 0–100; a reading older than 5 minutes is stale.","locale":"en"},"8125":{"id":"/en/docs/advanced-models-189","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#passive-quota","content":"Each channel also has four counters: responses, `401`/`403`, `429` and `5xx`.","locale":"en"},"8126":{"id":"/en/docs/advanced-models-190","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#passive-quota","content":"The **Channels** page shows the reading: red at 10% or less, amber at 25% or less, and stale readings marked **· old**.","locale":"en"},"8127":{"id":"/en/docs/advanced-models-191","page_id":"/en/docs/advanced-models","tags":[],"type":"text","url":"/en/docs/advanced-models#passive-quota","content":"Readings are kept per channel (not per account), in memory only, and recording one can never fail a generation. The management API returns header names, never raw values.","locale":"en"},"8128":{"id":"/en/docs/advanced-pi-free","page_id":"/en/docs/advanced-pi-free","type":"page","content":"pi-free migration and differences","breadcrumbs":["Hoshimi Documentation","Advanced"],"tags":[],"url":"/en/docs/advanced-pi-free","locale":"en"},"8129":{"id":"/en/docs/advanced-pi-free-0","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free","content":"How Hoshimi relates to pi-free: what to do when moving over from pi-free, which station rules were carried across, which were deliberately left out, and how runtime behaviour differs.","locale":"en"},"8130":{"id":"/en/docs/advanced-pi-free-1","page_id":"/en/docs/advanced-pi-free","type":"heading","tags":[],"url":"/en/docs/advanced-pi-free#moving-over-from-pi-free","content":"Moving over from pi-free","locale":"en"},"8131":{"id":"/en/docs/advanced-pi-free-2","page_id":"/en/docs/advanced-pi-free","type":"heading","tags":[],"url":"/en/docs/advanced-pi-free#put-your-credentials-into-hoshimi","content":"Put your credentials into Hoshimi","locale":"en"},"8132":{"id":"/en/docs/advanced-pi-free-3","page_id":"/en/docs/advanced-pi-free","type":"heading","tags":[],"url":"/en/docs/advanced-pi-free#aggregator-stations-add-agg-accounts","content":"Aggregator stations: add agg accounts","locale":"en"},"8133":{"id":"/en/docs/advanced-pi-free-4","page_id":"/en/docs/advanced-pi-free","type":"heading","tags":[],"url":"/en/docs/advanced-pi-free#stations-that-need-a-login-sign-in-again","content":"Stations that need a login: sign in again","locale":"en"},"8134":{"id":"/en/docs/advanced-pi-free-5","page_id":"/en/docs/advanced-pi-free","type":"heading","tags":[],"url":"/en/docs/advanced-pi-free#use-native-model-ids","content":"Use native model ids","locale":"en"},"8135":{"id":"/en/docs/advanced-pi-free-6","page_id":"/en/docs/advanced-pi-free","type":"heading","tags":[],"url":"/en/docs/advanced-pi-free#catalogue-filtering","content":"Catalogue filtering","locale":"en"},"8136":{"id":"/en/docs/advanced-pi-free-7","page_id":"/en/docs/advanced-pi-free","type":"heading","tags":[],"url":"/en/docs/advanced-pi-free#free-markers","content":"Free markers","locale":"en"},"8137":{"id":"/en/docs/advanced-pi-free-8","page_id":"/en/docs/advanced-pi-free","type":"heading","tags":[],"url":"/en/docs/advanced-pi-free#capabilities-and-model-choice","content":"Capabilities and model choice","locale":"en"},"8138":{"id":"/en/docs/advanced-pi-free-9","page_id":"/en/docs/advanced-pi-free","type":"heading","tags":[],"url":"/en/docs/advanced-pi-free#runtime-differences","content":"Runtime differences","locale":"en"},"8139":{"id":"/en/docs/advanced-pi-free-10","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free","content":"pi-free is one of Hoshimi's main references: many station integrations, catalogue filters and free markers were transcribed from it. It is not a runtime dependency, though, and Hoshimi does not read pi-free's configuration. pi and free-claude-code are likewise only migration references. This page covers moving over from pi-free and how the two behave differently.","locale":"en"},"8140":{"id":"/en/docs/advanced-pi-free-11","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#put-your-credentials-into-hoshimi","content":"pi-free reads station keys from environment variables (such as `ZENMUX_API_KEY`). Hoshimi does **not** read these variables; every credential lives in Hoshimi's own account configuration. The **Key env** column of `hoshimi stations` only documents the upstream convention, to help you find the key you used before.","locale":"en"},"8141":{"id":"/en/docs/advanced-pi-free-12","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#aggregator-stations-add-agg-accounts","content":"Stations pi-free reached with an API key are accounts of the `agg` channel in Hoshimi. Name the station with `preset` instead of writing its address:","locale":"en"},"8142":{"id":"/en/docs/advanced-pi-free-13","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#aggregator-stations-add-agg-accounts","content":"Or open agg on the Web UI's **Channels** page, press **Add account** and pick from the **Station** list. All 22 presets are listed in agg aggregator.","locale":"en"},"8143":{"id":"/en/docs/advanced-pi-free-14","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#stations-that-need-a-login-sign-in-again","content":"Stations that sign in through a browser, such as Cline, Qoder and ZCode, need one new login with `hoshimi login <channel>` or **Sign in** in the Web UI; see Free stations.","locale":"en"},"8144":{"id":"/en/docs/advanced-pi-free-15","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#use-native-model-ids","content":"Hoshimi keeps each station's native channel ids and model ids. In clients, name `channel/model`, or just the model id and let the gateway find it; see Model and account behaviour.","locale":"en"},"8145":{"id":"/en/docs/advanced-pi-free-16","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#use-native-model-ids","content":"Each channel's source id, endpoint, protocol, credential type and coverage are recorded in the Provider inventory. Its snapshot ids describe the source revision used as the baseline, not the latest upstream revision or a tested live integration.","locale":"en"},"8146":{"id":"/en/docs/advanced-pi-free-17","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#catalogue-filtering","content":"Besides chat models, a station's `/models` list often carries image and video generators, embeddings, rerankers, transcription and other endpoints. `agg` decides, row by row and station by station, which rows are chat models:","locale":"en"},"8147":{"id":"/en/docs/advanced-pi-free-18","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#catalogue-filtering","content":"**Stations are recognised by address**, not by preset name: an account with `preset: sambanova` whose `base_url` points elsewhere is not reading SambaNova's catalogue and does not get its rules. Addresses outside the preset table (your own relays included) are not filtered.","locale":"en"},"8148":{"id":"/en/docs/advanced-pi-free-19","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#catalogue-filtering","content":"The filters of 10 stations are transcribed from pi-free: Agnes, B.AI, DeepInfra, FastRouter, Novita, OrcaRouter, Routeway, TokenRouter, XKiro and ZenMux.","locale":"en"},"8149":{"id":"/en/docs/advanced-pi-free-20","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#catalogue-filtering","content":"**LLM7 uses Hoshimi's own rule**: keep rows whose `model_type` is `chat`. Checking for text output is not enough: `whisper-large-v3` (speech-to-text) and `gpt-image-2` (text and an image) would both slip in.","locale":"en"},"8150":{"id":"/en/docs/advanced-pi-free-21","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#catalogue-filtering","content":"A row missing the field a rule needs is kept (Novita is the exception: its `status` and `model_type` are the station's own contract). That way an upstream format change never silently empties a whole catalogue.","locale":"en"},"8151":{"id":"/en/docs/advanced-pi-free-22","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#catalogue-filtering","content":"The `default`, `fast` and `pro` routing selectors pi-free builds locally for LLM7 are not added: they are not the station's live model list, and the probe of the time did not show they could be used anonymously. This is a historical design reason, not a report on the endpoint's current health.","locale":"en"},"8152":{"id":"/en/docs/advanced-pi-free-23","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#free-markers","content":"Hoshimi's `free` has three values: `true`, `false` and `null` (the station did not say); unknown is not the same as paid. Nine of the 22 presets can give an answer:","locale":"en"},"8153":{"id":"/en/docs/advanced-pi-free-24","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#free-markers","content":"Station","locale":"en"},"8154":{"id":"/en/docs/advanced-pi-free-25","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#free-markers","content":"Evidence","locale":"en"},"8155":{"id":"/en/docs/advanced-pi-free-26","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#free-markers","content":"B.AI, TokenRouter","locale":"en"},"8156":{"id":"/en/docs/advanced-pi-free-27","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#free-markers","content":"Ids with a `:free` suffix; B.AI also has a few ids its pricing page lists as free","locale":"en"},"8157":{"id":"/en/docs/advanced-pi-free-28","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#free-markers","content":"GMI","locale":"en"},"8158":{"id":"/en/docs/advanced-pi-free-29","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#free-markers","content":"`is_free` in the row","locale":"en"},"8159":{"id":"/en/docs/advanced-pi-free-30","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#free-markers","content":"XKiro","locale":"en"},"8160":{"id":"/en/docs/advanced-pi-free-31","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#free-markers","content":"`access_tier` in the row, then a free label in the name, then the price","locale":"en"},"8161":{"id":"/en/docs/advanced-pi-free-32","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#free-markers","content":"AnyAPI, OrcaRouter","locale":"en"},"8162":{"id":"/en/docs/advanced-pi-free-33","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#free-markers","content":"`isFree` in the row, then a free label in the name, then the price","locale":"en"},"8163":{"id":"/en/docs/advanced-pi-free-34","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#free-markers","content":"OpenGateway","locale":"en"},"8164":{"id":"/en/docs/advanced-pi-free-35","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#free-markers","content":"The price in the row (promotional price first)","locale":"en"},"8165":{"id":"/en/docs/advanced-pi-free-36","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#free-markers","content":"Agnes, CommandCode","locale":"en"},"8166":{"id":"/en/docs/advanced-pi-free-37","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#free-markers","content":"Ids the station's pricing documents list as free (the listing carries no prices)","locale":"en"},"8167":{"id":"/en/docs/advanced-pi-free-38","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#free-markers","content":"Deliberately not carried across:","locale":"en"},"8168":{"id":"/en/docs/advanced-pi-free-39","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#free-markers","content":"Once pi-free finds any priced row at a station, it treats rows without a price as paid. Hoshimi does not: no price means `null`.","locale":"en"},"8169":{"id":"/en/docs/advanced-pi-free-40","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#free-markers","content":"Venice lists some models at a price of 0, but requires a positive account balance and answers HTTP 402 to an unfunded key, so a zero price there is not taken as free.","locale":"en"},"8170":{"id":"/en/docs/advanced-pi-free-41","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#free-markers","content":"LLM7 prices every row; that is a list price, not a statement about whether an account can use the model for free.","locale":"en"},"8171":{"id":"/en/docs/advanced-pi-free-42","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#free-markers","content":"A free marker promises neither available credits nor access for every key. When a station's limited-time offer ends, a marker can go stale, but only in the direction of a missing badge, never of a wrong promise.","locale":"en"},"8172":{"id":"/en/docs/advanced-pi-free-43","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#capabilities-and-model-choice","content":"CommandCode's own vision and reasoning lists were kept, with account declarations taking precedence. Its paid price table and default output ceilings were not imported.","locale":"en"},"8173":{"id":"/en/docs/advanced-pi-free-44","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#capabilities-and-model-choice","content":"models.dev only fills in vision and reasoning for models nothing else declared; context length, output limits and reasoning levels must describe the endpoint actually used, so they are never taken from it.","locale":"en"},"8174":{"id":"/en/docs/advanced-pi-free-45","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#capabilities-and-model-choice","content":"Artificial Analysis benchmark snapshots and fuzzy model-name rankings were not imported. Hoshimi routes the model the caller asked for; a failing model is recorded, never silently swapped for a better-ranked one.","locale":"en"},"8175":{"id":"/en/docs/advanced-pi-free-46","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#runtime-differences","content":"Aspect","locale":"en"},"8176":{"id":"/en/docs/advanced-pi-free-47","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#runtime-differences","content":"pi-free","locale":"en"},"8177":{"id":"/en/docs/advanced-pi-free-48","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#runtime-differences","content":"Hoshimi","locale":"en"},"8178":{"id":"/en/docs/advanced-pi-free-49","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#runtime-differences","content":"What changes after a failure","locale":"en"},"8179":{"id":"/en/docs/advanced-pi-free-50","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#runtime-differences","content":"The model picker switches to another model","locale":"en"},"8180":{"id":"/en/docs/advanced-pi-free-51","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#runtime-differences","content":"The same model on another account; the caller chooses the model","locale":"en"},"8181":{"id":"/en/docs/advanced-pi-free-52","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#runtime-differences","content":"Status classification","locale":"en"},"8182":{"id":"/en/docs/advanced-pi-free-53","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#runtime-differences","content":"A table of recoverable and unrecoverable statuses","locale":"en"},"8183":{"id":"/en/docs/advanced-pi-free-54","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#runtime-differences","content":"The same table, used to decide whether to try another account","locale":"en"},"8184":{"id":"/en/docs/advanced-pi-free-55","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#runtime-differences","content":"Remembered model failures","locale":"en"},"8185":{"id":"/en/docs/advanced-pi-free-56","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#runtime-differences","content":"10-minute window, banned after 3 strikes","locale":"en"},"8186":{"id":"/en/docs/advanced-pi-free-57","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#runtime-differences","content":"The same 10 minutes and 3 strikes; in memory only, cleared by a restart or `POST /api/v1/models/unavailable/reset`","locale":"en"},"8187":{"id":"/en/docs/advanced-pi-free-58","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#runtime-differences","content":"Catalogue shrink guard","locale":"en"},"8188":{"id":"/en/docs/advanced-pi-free-59","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#runtime-differences","content":"A new list under half the old one does not replace it","locale":"en"},"8189":{"id":"/en/docs/advanced-pi-free-60","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#runtime-differences","content":"The same threshold; accepted when the next cycle says the same","locale":"en"},"8190":{"id":"/en/docs/advanced-pi-free-61","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#runtime-differences","content":"Passive quota","locale":"en"},"8191":{"id":"/en/docs/advanced-pi-free-62","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#runtime-differences","content":"The same header order, lenient number parsing","locale":"en"},"8192":{"id":"/en/docs/advanced-pi-free-63","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#runtime-differences","content":"The same order, strict parsing: `10 requests` is not read as 10 but counted as an unreadable header","locale":"en"},"8193":{"id":"/en/docs/advanced-pi-free-64","page_id":"/en/docs/advanced-pi-free","tags":[],"type":"text","url":"/en/docs/advanced-pi-free#runtime-differences","content":"The full current rules are in Model and account behaviour.","locale":"en"},"8194":{"id":"/en/docs/advanced-troubleshooting","page_id":"/en/docs/advanced-troubleshooting","type":"page","content":"Troubleshooting","breadcrumbs":["Hoshimi Documentation","Advanced"],"tags":[],"url":"/en/docs/advanced-troubleshooting","locale":"en"},"8195":{"id":"/en/docs/advanced-troubleshooting-0","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting","content":"Common problems by symptom: the server will not start or the port is taken, 401/403/400, missing models or 503, expired logins, exhausted accounts, proxy and network errors, stations refusing images or tools.","locale":"en"},"8196":{"id":"/en/docs/advanced-troubleshooting-1","page_id":"/en/docs/advanced-troubleshooting","type":"heading","tags":[],"url":"/en/docs/advanced-troubleshooting#gather-information-first","content":"Gather information first","locale":"en"},"8197":{"id":"/en/docs/advanced-troubleshooting-2","page_id":"/en/docs/advanced-troubleshooting","type":"heading","tags":[],"url":"/en/docs/advanced-troubleshooting#the-server-will-not-start","content":"The server will not start","locale":"en"},"8198":{"id":"/en/docs/advanced-troubleshooting-3","page_id":"/en/docs/advanced-troubleshooting","type":"heading","tags":[],"url":"/en/docs/advanced-troubleshooting#the-gateway-refuses-requests-401-403-400","content":"The gateway refuses requests: 401, 403, 400","locale":"en"},"8199":{"id":"/en/docs/advanced-troubleshooting-4","page_id":"/en/docs/advanced-troubleshooting","type":"heading","tags":[],"url":"/en/docs/advanced-troubleshooting#model-problems","content":"Model problems","locale":"en"},"8200":{"id":"/en/docs/advanced-troubleshooting-5","page_id":"/en/docs/advanced-troubleshooting","type":"heading","tags":[],"url":"/en/docs/advanced-troubleshooting#accounts-and-logins","content":"Accounts and logins","locale":"en"},"8201":{"id":"/en/docs/advanced-troubleshooting-6","page_id":"/en/docs/advanced-troubleshooting","type":"heading","tags":[],"url":"/en/docs/advanced-troubleshooting#network-and-proxies","content":"Network and proxies","locale":"en"},"8202":{"id":"/en/docs/advanced-troubleshooting-7","page_id":"/en/docs/advanced-troubleshooting","type":"heading","tags":[],"url":"/en/docs/advanced-troubleshooting#stations-refusing-images-or-tools","content":"Stations refusing images or tools","locale":"en"},"8203":{"id":"/en/docs/advanced-troubleshooting-8","page_id":"/en/docs/advanced-troubleshooting","type":"heading","tags":[],"url":"/en/docs/advanced-troubleshooting#data-and-files","content":"Data and files","locale":"en"},"8204":{"id":"/en/docs/advanced-troubleshooting-9","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting","content":"Find the section for your symptom. Each entry gives the message you will see, its cause and the fix; the messages are the program's actual output, so you can search for them.","locale":"en"},"8205":{"id":"/en/docs/advanced-troubleshooting-10","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#gather-information-first","content":"Where to look","locale":"en"},"8206":{"id":"/en/docs/advanced-troubleshooting-11","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#gather-information-first","content":"What it shows","locale":"en"},"8207":{"id":"/en/docs/advanced-troubleshooting-12","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#gather-information-first","content":"The terminal running `hoshimi serve`","locale":"en"},"8208":{"id":"/en/docs/advanced-troubleshooting-13","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#gather-information-first","content":"Every log line (written to stderr; there is no log file). `HOSHIMI_LOG_LEVEL=DEBUG hoshimi serve` or `hoshimi serve --debug` adds detail","locale":"en"},"8209":{"id":"/en/docs/advanced-troubleshooting-14","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#gather-information-first","content":"`hoshimi check`","locale":"en"},"8210":{"id":"/en/docs/advanced-troubleshooting-15","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#gather-information-first","content":"Whether the configuration reads and validates, and which channels and how many accounts would run","locale":"en"},"8211":{"id":"/en/docs/advanced-troubleshooting-16","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#gather-information-first","content":"The **Channels** page","locale":"en"},"8212":{"id":"/en/docs/advanced-troubleshooting-17","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#gather-information-first","content":"Each channel's state (**Needs attention**), account states (**Needs login**, **Expired**, **Resting**, **Failing**), allowance and recent network errors","locale":"en"},"8213":{"id":"/en/docs/advanced-troubleshooting-18","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#gather-information-first","content":"The call list on the **Usage** page","locale":"en"},"8214":{"id":"/en/docs/advanced-troubleshooting-19","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#gather-information-first","content":"Each call's channel, account, attempts, error code and message; tick **Failed only** to see failures","locale":"en"},"8215":{"id":"/en/docs/advanced-troubleshooting-20","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#gather-information-first","content":"The **Models** page","locale":"en"},"8216":{"id":"/en/docs/advanced-troubleshooting-21","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#gather-information-first","content":"Each model's probe verdict and whether it is remembered as unavailable","locale":"en"},"8217":{"id":"/en/docs/advanced-troubleshooting-22","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#gather-information-first","content":"`GET /api/v1/network/diagnostics`","locale":"en"},"8218":{"id":"/en/docs/advanced-troubleshooting-23","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#gather-information-first","content":"The latest network result per channel and operation; see Network and proxies","locale":"en"},"8219":{"id":"/en/docs/advanced-troubleshooting-24","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#the-server-will-not-start","content":"`config.json` is not valid JSON, usually a missing quote or comma after a hand edit. Hoshimi refuses to start rather than overwrite it with an empty configuration (which would look as if every account had vanished), and it has kept a copy of the original. Fix `config.json` at the line and column given, then start again; if you cannot, copy the accounts out of the `.corrupt-…` file. `Config file … must contain a JSON object.` means the file's top level is not an object.","locale":"en"},"8220":{"id":"/en/docs/advanced-troubleshooting-25","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#the-server-will-not-start","content":"Start-up, `hoshimi check` and `hoshimi config set` validate the configuration first, with messages such as `network.proxy is required in proxy mode` or `playground.compact_threshold must be between 0.5 and 0.95.`. Each is explained in the validation section of Configuration file.","locale":"en"},"8221":{"id":"/en/docs/advanced-troubleshooting-26","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#the-server-will-not-start","content":"When `server.host` is `0.0.0.0` or a LAN address, a tool access key and `security.allow_cidrs` are required, or the server refuses to start (exit code 4). Follow \"Opening the gateway to your LAN\" in Access control, or set `server.host` back to `127.0.0.1`.","locale":"en"},"8222":{"id":"/en/docs/advanced-troubleshooting-27","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#the-server-will-not-start","content":"This is not an error. When the port is taken (or reserved by the system), the server tries the next port, up to 65535, then continues from 1024 upwards. The port actually used is:","locale":"en"},"8223":{"id":"/en/docs/advanced-troubleshooting-28","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#the-server-will-not-start","content":"printed in the log and on standard output as `SERVER_READY url=http://127.0.0.1:10601`;","locale":"en"},"8224":{"id":"/en/docs/advanced-troubleshooting-29","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#the-server-will-not-start","content":"the one the browser is opened on;","locale":"en"},"8225":{"id":"/en/docs/advanced-troubleshooting-30","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#the-server-will-not-start","content":"written to `server.json` in the data directory;","locale":"en"},"8226":{"id":"/en/docs/advanced-troubleshooting-31","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#the-server-will-not-start","content":"shown on the **Settings** page as **Port 10600 was taken, so the server is on 10601.**","locale":"en"},"8227":{"id":"/en/docs/advanced-troubleshooting-32","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#the-server-will-not-start","content":"Clients must use the new port. To pin the port:","locale":"en"},"8228":{"id":"/en/docs/advanced-troubleshooting-33","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#the-server-will-not-start","content":"With strict port on, a taken port gives `Port 10600 on 127.0.0.1 is unavailable (…), and strict port mode is on` and exit code 3. Find what holds the port first; often it is another Hoshimi still running: see the `pid` in `server.json`.","locale":"en"},"8229":{"id":"/en/docs/advanced-troubleshooting-34","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#the-server-will-not-start","content":"The listening address does not belong to this machine (its IP changed, or the wrong interface address was written). Another port would not help, so the server exits at once (exit code 3). Use `0.0.0.0` or the machine's current address.","locale":"en"},"8230":{"id":"/en/docs/advanced-troubleshooting-35","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#the-server-will-not-start","content":"The Web UI build files are missing and only the API is served. Packages installed from PyPI include the build; when running from source, build the Web UI first; see Development setup.","locale":"en"},"8231":{"id":"/en/docs/advanced-troubleshooting-36","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#the-server-will-not-start","content":"Every channel is turned off, the two keyless ones included. Enable one (`hoshimi config set providers.kilo.enabled true`) or add an account to a channel.","locale":"en"},"8232":{"id":"/en/docs/advanced-troubleshooting-37","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#the-gateway-refuses-requests-401-403-400","content":"These errors come from Hoshimi's own access control; the request never reached upstream. Their body looks like `{\"code\": \"…\", \"message\": \"…\", \"detail\": {}}`. An OpenAI-shaped `{\"error\": {…}}` is an error from upstream or from routing instead; see the sections below.","locale":"en"},"8233":{"id":"/en/docs/advanced-troubleshooting-38","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#the-gateway-refuses-requests-401-403-400","content":"Status and code","locale":"en"},"8234":{"id":"/en/docs/advanced-troubleshooting-39","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#the-gateway-refuses-requests-401-403-400","content":"Message","locale":"en"},"8235":{"id":"/en/docs/advanced-troubleshooting-40","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#the-gateway-refuses-requests-401-403-400","content":"Cause and fix","locale":"en"},"8236":{"id":"/en/docs/advanced-troubleshooting-41","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#the-gateway-refuses-requests-401-403-400","content":"`401` `model_api_key_required`","locale":"en"},"8237":{"id":"/en/docs/advanced-troubleshooting-42","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#the-gateway-refuses-requests-401-403-400","content":"`A model API key is required`","locale":"en"},"8238":{"id":"/en/docs/advanced-troubleshooting-43","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#the-gateway-refuses-requests-401-403-400","content":"`/v1/*` needs the model API key. Send `Authorization: Bearer <model API key>` or `x-api-key`. The tool access key does not work here","locale":"en"},"8239":{"id":"/en/docs/advanced-troubleshooting-44","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#the-gateway-refuses-requests-401-403-400","content":"`401` `auth_required`","locale":"en"},"8240":{"id":"/en/docs/advanced-troubleshooting-45","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#the-gateway-refuses-requests-401-403-400","content":"`A tool access key is required`","locale":"en"},"8241":{"id":"/en/docs/advanced-troubleshooting-46","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#the-gateway-refuses-requests-401-403-400","content":"`/api/*`, `/docs` and `/openapi.json` need the tool access key, as `Authorization: Bearer` only; the model API key and `x-api-key` do not work here","locale":"en"},"8242":{"id":"/en/docs/advanced-troubleshooting-47","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#the-gateway-refuses-requests-401-403-400","content":"`403` `remote_not_allowed`","locale":"en"},"8243":{"id":"/en/docs/advanced-troubleshooting-48","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#the-gateway-refuses-requests-401-403-400","content":"`Remote address not allowed`","locale":"en"},"8244":{"id":"/en/docs/advanced-troubleshooting-49","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#the-gateway-refuses-requests-401-403-400","content":"The client IP is not in `security.allow_cidrs`. Add its network","locale":"en"},"8245":{"id":"/en/docs/advanced-troubleshooting-50","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#the-gateway-refuses-requests-401-403-400","content":"`400` `bad_host`","locale":"en"},"8246":{"id":"/en/docs/advanced-troubleshooting-51","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#the-gateway-refuses-requests-401-403-400","content":"`Host not allowed`","locale":"en"},"8247":{"id":"/en/docs/advanced-troubleshooting-52","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#the-gateway-refuses-requests-401-403-400","content":"The server listens on loopback and the request's `Host` is not `localhost`, `127.0.0.1`, `::1` or the listening address. Typical with a reverse proxy forwarding the public name, or a custom local host name. Have the proxy forward `Host: 127.0.0.1:<port>`","locale":"en"},"8248":{"id":"/en/docs/advanced-troubleshooting-53","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#the-gateway-refuses-requests-401-403-400","content":"`403` `bad_origin`","locale":"en"},"8249":{"id":"/en/docs/advanced-troubleshooting-54","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#the-gateway-refuses-requests-401-403-400","content":"`Cross-origin request refused`","locale":"en"},"8250":{"id":"/en/docs/advanced-troubleshooting-55","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#the-gateway-refuses-requests-401-403-400","content":"A browser made a write request from another origin. Add that origin to `security.allow_origins` (needs a tool access key)","locale":"en"},"8251":{"id":"/en/docs/advanced-troubleshooting-56","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#the-gateway-refuses-requests-401-403-400","content":"`403` `bad_origin`","locale":"en"},"8252":{"id":"/en/docs/advanced-troubleshooting-57","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#the-gateway-refuses-requests-401-403-400","content":"`Cross-site request refused`","locale":"en"},"8253":{"id":"/en/docs/advanced-troubleshooting-58","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#the-gateway-refuses-requests-401-403-400","content":"The request has no `Origin`, but the browser marked it as coming from another site","locale":"en"},"8254":{"id":"/en/docs/advanced-troubleshooting-59","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#the-gateway-refuses-requests-401-403-400","content":"If the Web UI keeps showing **Tool access key required**, or says **The tool access key is incorrect.**, the key was changed: sign in with the current one. If you forgot it, stop the server, set a new one with `hoshimi config set server.access_token \"<new key>\"` (or `null` to remove it), then start again. The full rules are in Access control.","locale":"en"},"8255":{"id":"/en/docs/advanced-troubleshooting-60","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#model-problems","content":"No running channel lists this model (`404 model_not_found`).","locale":"en"},"8256":{"id":"/en/docs/advanced-troubleshooting-61","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#model-problems","content":"Check the exact id with `GET /v1/models` or the **Models** page, including case and prefix;","locale":"en"},"8257":{"id":"/en/docs/advanced-troubleshooting-62","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#model-problems","content":"use the `channel/model` form, such as `kilo/<model id>`;","locale":"en"},"8258":{"id":"/en/docs/advanced-troubleshooting-63","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#model-problems","content":"the channel may not be running: turned off, enabled without accounts, or with accounts dropped for missing fields (the log says `agg: dropping accounts without base_url or key: …`). `hoshimi check` shows the channels that actually run.","locale":"en"},"8259":{"id":"/en/docs/advanced-troubleshooting-64","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#model-problems","content":"A request without `model` and no `server.default_model` gets `model is required`.","locale":"en"},"8260":{"id":"/en/docs/advanced-troubleshooting-65","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#model-problems","content":"When a catalogue fetch fails, the gateway keeps the last good catalogue and retries after 30 seconds; the **Models** page says **Catalogue unavailable or timed out: …. Existing models are retained.** A loading round waits at most 20 seconds and marks slow channels as timed out; refresh a little later.","locale":"en"},"8261":{"id":"/en/docs/advanced-troubleshooting-66","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#model-problems","content":"A channel that never fetched successfully uses its built-in fallback list, whose models are not guaranteed to work.","locale":"en"},"8262":{"id":"/en/docs/advanced-troubleshooting-67","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#model-problems","content":"When a new list suddenly has fewer than half the models, the old list is kept for one cycle and the log says `the catalogue came back at N of M models (likely a partial answer)`; if the next cycle agrees, it is accepted and the log says `accepting it as the station's own answer`.","locale":"en"},"8263":{"id":"/en/docs/advanced-troubleshooting-68","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#model-problems","content":"When the channel's network fails, the **Network** section of its **Channels** page shows errors for the **Model catalogue** operation.","locale":"en"},"8264":{"id":"/en/docs/advanced-troubleshooting-69","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#model-problems","content":"**Models** and **Channels › Network** show the failure reason, known HTTP status, target host and suggested action. HTTP 200 can still carry an invalid model list. For 404/405, check the API base URL; if the upstream has no model listing endpoint, enter model IDs on the account manually. Another account succeeding in the same channel does not clear the failed refresh; a complete successful refresh does. The UI and catalogue failure logs omit raw response bodies, full request URLs and keys.","locale":"en"},"8265":{"id":"/en/docs/advanced-troubleshooting-70","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#model-problems","content":"Every account of the upstream said this model does not exist (404, 410, or a body that clearly says so), so for 10 minutes the gateway stops sending requests for it; three such answers within 10 minutes keep it that way for the rest of the run. Once the upstream is back, clear the record with `POST /api/v1/models/unavailable/reset` or restart the server. The rules are in Model and account behaviour.","locale":"en"},"8266":{"id":"/en/docs/advanced-troubleshooting-71","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#model-problems","content":"`region-blocked` (Region blocked): the station refuses this egress's region. Give the channel a proxy route in another region; see Network and proxies.","locale":"en"},"8267":{"id":"/en/docs/advanced-troubleshooting-72","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#model-problems","content":"`throttled` (Throttled): not enough quota to ask the model. Probe again later.","locale":"en"},"8268":{"id":"/en/docs/advanced-troubleshooting-73","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#model-problems","content":"`unknown` (Unknown): a credential, network or server error that says nothing about the model. Check the channel's network errors and account states on the **Channels** page.","locale":"en"},"8269":{"id":"/en/docs/advanced-troubleshooting-74","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#model-problems","content":"Only `unavailable` means the model itself is unavailable.","locale":"en"},"8270":{"id":"/en/docs/advanced-troubleshooting-75","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#accounts-and-logins","content":"The upstream rejected this account's refresh token (log: `<channel>/<account>: refresh token rejected, account needs a new login`). The account leaves rotation and renewal skips it until you sign in again:","locale":"en"},"8271":{"id":"/en/docs/advanced-troubleshooting-76","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#accounts-and-logins","content":"or press **Sign in** on the **Channels** page. Signing in as the same identity replaces the account. A restart clears the mark, but if the token is really invalid the next renewal sets it again.","locale":"en"},"8272":{"id":"/en/docs/advanced-troubleshooting-77","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#accounts-and-logins","content":"`502`: the channel has no account left to try; each one either needs a login or is held out of rotation after a rate limit or policy block. The **Channels** page lists each account's state and when it comes back (**Resting**, with **Rate limited** or **Blocked by policy**); `cooled` in `GET /api/v1/credits` gives the seconds left.","locale":"en"},"8273":{"id":"/en/docs/advanced-troubleshooting-78","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#accounts-and-logins","content":"A rate-limit hold lasts as long as the upstream's `Retry-After` or the reset time in its message, and one hour when it says nothing; a policy block lasts 30 minutes.","locale":"en"},"8274":{"id":"/en/docs/advanced-troubleshooting-79","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#accounts-and-logins","content":"Holds live in memory and a restart clears them, but that does not lift the upstream's limit.","locale":"en"},"8275":{"id":"/en/docs/advanced-troubleshooting-80","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#accounts-and-logins","content":"More accounts let requests continue while one is limited.","locale":"en"},"8276":{"id":"/en/docs/advanced-troubleshooting-81","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#accounts-and-logins","content":"`No accounts configured for provider '…'.` (401) means the channel has no accounts at all.","locale":"en"},"8277":{"id":"/en/docs/advanced-troubleshooting-82","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#accounts-and-logins","content":"Upstream errors passed through the gateway keep the upstream's status code.","locale":"en"},"8278":{"id":"/en/docs/advanced-troubleshooting-83","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#accounts-and-logins","content":"`401`: the gateway already tried renewing and other accounts, and was still refused. Check the account states on the **Channels** page and sign in again if needed.","locale":"en"},"8279":{"id":"/en/docs/advanced-troubleshooting-84","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#accounts-and-logins","content":"`403` (`permission denied`): a 403 whose body is not about credentials is a permission or gateway block; it triggers neither renewal nor rotation. Check the channel's network errors: **Request rejected by an upstream proxy**, **Region restriction** or **Client compatibility restriction** point at the route or region, not the account.","locale":"en"},"8280":{"id":"/en/docs/advanced-troubleshooting-85","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#accounts-and-logins","content":"`429`: every account tried was rate limited. A request tries at most `server.max_account_retries` (default 3) accounts; raise it if you have more.","locale":"en"},"8281":{"id":"/en/docs/advanced-troubleshooting-86","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#accounts-and-logins","content":"When a model is saturated (such as CodeBuddy's `14003`, \"model busy\"), the gateway returns the upstream's message without rotating: every account would get the same answer. Use another model or try later.","locale":"en"},"8282":{"id":"/en/docs/advanced-troubleshooting-87","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#accounts-and-logins","content":"A login not finished within 10 minutes times out (for example `Login timed out waiting for authorization`); start again.","locale":"en"},"8283":{"id":"/en/docs/advanced-troubleshooting-88","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#accounts-and-logins","content":"Stations that need a local callback listen on `127.0.0.1`: Codex always uses port 1455 (a busy port gives `codex: cannot bind the local callback port 1455: …`; `codex: another login is already in progress` means another Codex login has not finished), and Cline's browser method uses 48801–48811 (`cline: no available callback port (48801–48811)`). Close whatever holds those ports and retry.","locale":"en"},"8284":{"id":"/en/docs/advanced-troubleshooting-89","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#accounts-and-logins","content":"When the browser and Hoshimi are on different machines, the callback cannot reach Hoshimi. Use `hoshimi login <channel> --no-open --manual`: open the printed link in any browser, finish there, and paste the address the browser ended on (or the authorization code) back into the terminal. Not every station supports manual input.","locale":"en"},"8285":{"id":"/en/docs/advanced-troubleshooting-90","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#accounts-and-logins","content":"Each station's login method is in Free stations.","locale":"en"},"8286":{"id":"/en/docs/advanced-troubleshooting-91","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#accounts-and-logins","content":"The timers start only when the server starts. `hoshimi serve` turns both on by default and overrides `server.auto_refresh` and `server.auto_checkin` from the configuration; to turn them off, start with `--no-refresh` or `--no-checkin`.","locale":"en"},"8287":{"id":"/en/docs/advanced-troubleshooting-92","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#accounts-and-logins","content":"Check-in days are calendar days in Beijing time (UTC+8); a day that already succeeded is not repeated. The history: `GET /api/v1/credits/checkins`.","locale":"en"},"8288":{"id":"/en/docs/advanced-troubleshooting-93","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#accounts-and-logins","content":"Channels without a balance or check-in endpoint are skipped.","locale":"en"},"8289":{"id":"/en/docs/advanced-troubleshooting-94","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#network-and-proxies","content":"When a channel request fails, the message looks like `<channel>: <category>; <advice>`, with the same categories as `kind` in the network diagnostics:","locale":"en"},"8290":{"id":"/en/docs/advanced-troubleshooting-95","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#network-and-proxies","content":"Message","locale":"en"},"8291":{"id":"/en/docs/advanced-troubleshooting-96","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#network-and-proxies","content":"Cause and fix","locale":"en"},"8292":{"id":"/en/docs/advanced-troubleshooting-97","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#network-and-proxies","content":"`…: proxy_error; check network configuration`","locale":"en"},"8293":{"id":"/en/docs/advanced-troubleshooting-98","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#network-and-proxies","content":"The configured proxy cannot be reached. Check it is running and the address and port are right. A failed configured proxy never falls back to direct","locale":"en"},"8294":{"id":"/en/docs/advanced-troubleshooting-99","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#network-and-proxies","content":"`…: timeout; check network configuration`","locale":"en"},"8295":{"id":"/en/docs/advanced-troubleshooting-100","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#network-and-proxies","content":"Connect or read timeout. The station may need a proxy, or the proxy is too slow","locale":"en"},"8296":{"id":"/en/docs/advanced-troubleshooting-101","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#network-and-proxies","content":"`…: connection_error; check network configuration`","locale":"en"},"8297":{"id":"/en/docs/advanced-troubleshooting-102","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#network-and-proxies","content":"DNS, connection refused or TLS error","locale":"en"},"8298":{"id":"/en/docs/advanced-troubleshooting-103","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#network-and-proxies","content":"`…: challenge; complete_browser_authorization`","locale":"en"},"8299":{"id":"/en/docs/advanced-troubleshooting-104","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#network-and-proxies","content":"The upstream answered with a Cloudflare challenge. Hoshimi does not solve challenges; try another route or later","locale":"en"},"8300":{"id":"/en/docs/advanced-troubleshooting-105","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#network-and-proxies","content":"`…: edge_rejected; check_endpoint_and_network`","locale":"en"},"8301":{"id":"/en/docs/advanced-troubleshooting-106","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#network-and-proxies","content":"An HTML block page came back. Check the address and whether the route is blocked","locale":"en"},"8302":{"id":"/en/docs/advanced-troubleshooting-107","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#network-and-proxies","content":"`…: invalid_response; check_endpoint_and_network`","locale":"en"},"8303":{"id":"/en/docs/advanced-troubleshooting-108","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#network-and-proxies","content":"HTML instead of JSON, usually an address pointing at a web page rather than the API","locale":"en"},"8304":{"id":"/en/docs/advanced-troubleshooting-109","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#network-and-proxies","content":"`…: region_restricted; check_provider_availability`","locale":"en"},"8305":{"id":"/en/docs/advanced-troubleshooting-110","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#network-and-proxies","content":"The station does not serve this egress's region. Use a proxy route in another region","locale":"en"},"8306":{"id":"/en/docs/advanced-troubleshooting-111","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#network-and-proxies","content":"`…: client_restricted; check_client_compatibility`","locale":"en"},"8307":{"id":"/en/docs/advanced-troubleshooting-112","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#network-and-proxies","content":"The station grants its free tier to its own clients only","locale":"en"},"8308":{"id":"/en/docs/advanced-troubleshooting-113","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#network-and-proxies","content":"`…: signature_rejected; check_request_integrity`","locale":"en"},"8309":{"id":"/en/docs/advanced-troubleshooting-114","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#network-and-proxies","content":"The station refused the request signature","locale":"en"},"8310":{"id":"/en/docs/advanced-troubleshooting-115","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#network-and-proxies","content":"None of these invalidates an account or rotates accounts.","locale":"en"},"8311":{"id":"/en/docs/advanced-troubleshooting-116","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#network-and-proxies","content":"Also note:","locale":"en"},"8312":{"id":"/en/docs/advanced-troubleshooting-117","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#network-and-proxies","content":"`auto` mode reads the environment the server process started with; `HTTPS_PROXY` set in another terminal has no effect on a running server. Lowercase `https_proxy` wins over uppercase.","locale":"en"},"8313":{"id":"/en/docs/advanced-troubleshooting-118","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#network-and-proxies","content":"A malformed proxy URL in the environment makes requests fail rather than being ignored.","locale":"en"},"8314":{"id":"/en/docs/advanced-troubleshooting-119","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#network-and-proxies","content":"`network.system_proxy` only works on Windows.","locale":"en"},"8315":{"id":"/en/docs/advanced-troubleshooting-120","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#network-and-proxies","content":"SOCKS proxies do not apply to Bedrock's AWS SDK; Bedrock needs an HTTP(S) proxy.","locale":"en"},"8316":{"id":"/en/docs/advanced-troubleshooting-121","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#network-and-proxies","content":"Local addresses (such as a local Ollama) always go direct, never through a proxy.","locale":"en"},"8317":{"id":"/en/docs/advanced-troubleshooting-122","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#network-and-proxies","content":"Configuration is covered in Network and proxies.","locale":"en"},"8318":{"id":"/en/docs/advanced-troubleshooting-123","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#stations-refusing-images-or-tools","content":"When a model cannot read images (`vision` is `false` in its capabilities), the Playground has the **Image model** (`playground.vision_model`) describe the image in words first, and says above the reply **The image “…” was described by …, because this model can’t read images.** When no model can read it, or the **Image model** is **Off**, it says **The image “…” was left out: no model could read it.**","locale":"en"},"8319":{"id":"/en/docs/advanced-troubleshooting-124","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#stations-refusing-images-or-tools","content":"When a model should read images but the upstream refuses the image before the reply starts (an error mentioning image, vision, multimodal and the like), the Playground retries once with descriptions and says **… refused the image, so it was sent as a description.**","locale":"en"},"8320":{"id":"/en/docs/advanced-troubleshooting-125","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#stations-refusing-images-or-tools","content":"Over the API, the gateway does no such conversion and the upstream's error comes back as is. To send images, pick a model whose `vision` is `true`.","locale":"en"},"8321":{"id":"/en/docs/advanced-troubleshooting-126","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#stations-refusing-images-or-tools","content":"When a model does not support tool calls, or the upstream refuses `tools` before the reply starts (an error mentioning tool, tool_choice or function call), the Playground retries without tools and says **… can’t call tools, so it answered without them.** Pick a model that supports tools (**Tools** on the **Models** page). Turning tools on and the approval modes are covered in Playground tools.","locale":"en"},"8322":{"id":"/en/docs/advanced-troubleshooting-127","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#stations-refusing-images-or-tools","content":"Over the API, an upstream's refusal of `tools` is returned to the client as is.","locale":"en"},"8323":{"id":"/en/docs/advanced-troubleshooting-128","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#data-and-files","content":"`hoshimi.db` was used by a newer Hoshimi and an older one is running now. It still runs, but some records may not show correctly. Upgrade, or restore the data directory from a backup.","locale":"en"},"8324":{"id":"/en/docs/advanced-troubleshooting-129","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#data-and-files","content":"`hoshimi config set` and hand edits need a server restart. More importantly, while the server runs, every settings save in the Web UI, every login and every renewal writes the in-memory configuration back to `config.json`, overwriting changes made to the file in the meantime. Stop the server before changing the file.","locale":"en"},"8325":{"id":"/en/docs/advanced-troubleshooting-130","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#data-and-files","content":"When old JSON records were imported after an upgrade, this file could not be read; it was renamed aside and that record started empty. Nothing else is affected; delete it if you do not need it.","locale":"en"},"8326":{"id":"/en/docs/advanced-troubleshooting-131","page_id":"/en/docs/advanced-troubleshooting","tags":[],"type":"text","url":"/en/docs/advanced-troubleshooting#data-and-files","content":"If the problem remains, open a report on GitHub Issues with logs taken with `HOSHIMI_LOG_LEVEL=DEBUG`, the output of `hoshimi version` and the steps to reproduce. Logs can contain account ids and host names; check them before sharing.","locale":"en"},"8327":{"id":"/en/docs/advanced-usage","page_id":"/en/docs/advanced-usage","type":"page","content":"Usage statistics","breadcrumbs":["Hoshimi Documentation","Advanced"],"tags":[],"url":"/en/docs/advanced-usage","locale":"en"},"8328":{"id":"/en/docs/advanced-usage-0","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage","content":"How the gateway records each call: which fields, where token and cache counts come from, how speed is measured, how long records are kept, how to query them, and the live event stream.","locale":"en"},"8329":{"id":"/en/docs/advanced-usage-1","page_id":"/en/docs/advanced-usage","type":"heading","tags":[],"url":"/en/docs/advanced-usage#what-is-recorded","content":"What is recorded","locale":"en"},"8330":{"id":"/en/docs/advanced-usage-2","page_id":"/en/docs/advanced-usage","type":"heading","tags":[],"url":"/en/docs/advanced-usage#where-tokens-and-cache-counts-come-from","content":"Where tokens and cache counts come from","locale":"en"},"8331":{"id":"/en/docs/advanced-usage-3","page_id":"/en/docs/advanced-usage","type":"heading","tags":[],"url":"/en/docs/advanced-usage#time-to-first-token-and-speed","content":"Time to first token and speed","locale":"en"},"8332":{"id":"/en/docs/advanced-usage-4","page_id":"/en/docs/advanced-usage","type":"heading","tags":[],"url":"/en/docs/advanced-usage#how-long-records-are-kept","content":"How long records are kept","locale":"en"},"8333":{"id":"/en/docs/advanced-usage-5","page_id":"/en/docs/advanced-usage","type":"heading","tags":[],"url":"/en/docs/advanced-usage#querying","content":"Querying","locale":"en"},"8334":{"id":"/en/docs/advanced-usage-6","page_id":"/en/docs/advanced-usage","type":"heading","tags":[],"url":"/en/docs/advanced-usage#a-report-for-a-range","content":"A report for a range","locale":"en"},"8335":{"id":"/en/docs/advanced-usage-7","page_id":"/en/docs/advanced-usage","type":"heading","tags":[],"url":"/en/docs/advanced-usage#the-call-list","content":"The call list","locale":"en"},"8336":{"id":"/en/docs/advanced-usage-8","page_id":"/en/docs/advanced-usage","type":"heading","tags":[],"url":"/en/docs/advanced-usage#clearing","content":"Clearing","locale":"en"},"8337":{"id":"/en/docs/advanced-usage-9","page_id":"/en/docs/advanced-usage","type":"heading","tags":[],"url":"/en/docs/advanced-usage#the-live-view","content":"The live view","locale":"en"},"8338":{"id":"/en/docs/advanced-usage-10","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage","content":"The gateway leaves one record for every request it handles. The charts, breakdowns and call list of the **Usage** page, and the **Live activity** in the top bar, all come from these records. This page describes the recording rules and the matching management API; using the page itself is covered in Usage page.","locale":"en"},"8339":{"id":"/en/docs/advanced-usage-11","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#what-is-re
":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#what-is-recorded","content":"`finish_reason`","locale":"en"},"8390":{"id":"/en/docs/advanced-usage-62","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#what-is-recorded","content":"Why it ended","locale":"en"},"8391":{"id":"/en/docs/advanced-usage-63","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#what-is-recorded","content":"`error_code`, `error_message`","locale":"en"},"8392":{"id":"/en/docs/advanced-usage-64","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#what-is-recorded","content":"Error code and a short explanation on failure","locale":"en"},"8393":{"id":"/en/docs/advanced-usage-65","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#what-is-recorded","content":"`no_usage`","locale":"en"},"8394":{"id":"/en/docs/advanced-usage-66","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#what-is-recorded","content":"The upstream reported no token usage","locale":"en"},"8395":{"id":"/en/docs/advanced-usage-67","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#what-is-recorded","content":"A few rules:","locale":"en"},"8396":{"id":"/en/docs/advanced-usage-68","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#what-is-recorded","content":"**Routing failures count as failures**: a request that ends before reaching upstream (model not found, every account failed and so on) is still recorded, as a failure.","locale":"en"},"8397":{"id":"/en/docs/advanced-usage-69","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#what-is-recorded","content":"**A client disconnecting is not a failure**: when the caller hangs up mid-answer, the gateway did serve the call, and the record counts as a success.","locale":"en"},"8398":{"id":"/en/docs/advanced-usage-70","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#what-is-recorded","content":"An error frame from the upstream inside a stream is recorded as a failure.","locale":"en"},"8399":{"id":"/en/docs/advanced-usage-71","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#what-is-recorded","content":"Records hold usage and metadata only; prompts and replies are not stored here (Playground conversations are stored separately).","locale":"en"},"8400":{"id":"/en/docs/advanced-usage-72","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#what-is-recorded","content":"Error explanations are kept to one line of at most 160 characters, with anything shaped like a key (`Bearer …`, `sk-…`, random strings of 32 characters or more, and so on) replaced with `***`. An upstream error that carries a status is recorded only as `upstream returned HTTP <status>`, without the upstream's body; error frames inside a stream keep their explanation, shortened and masked by the same rules.","locale":"en"},"8401":{"id":"/en/docs/advanced-usage-73","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#where-tokens-and-cache-counts-come-from","content":"Every channel's usage is first normalized to OpenAI's fields, then recorded:","locale":"en"},"8402":{"id":"/en/docs/advanced-usage-74","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#where-tokens-and-cache-counts-come-from","content":"Record field","locale":"en"},"8403":{"id":"/en/docs/advanced-usage-75","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#where-tokens-and-cache-counts-come-from","content":"Read from","locale":"en"},"8404":{"id":"/en/docs/advanced-usage-76","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#where-tokens-and-cache-counts-come-from","content":"`input`","locale":"en"},"8405":{"id":"/en/docs/advanced-usage-77","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#where-tokens-and-cache-counts-come-from","content":"`prompt_tokens`","locale":"en"},"8406":{"id":"/en/docs/advanced-usage-78","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#where-tokens-and-cache-counts-come-from","content":"`output`","locale":"en"},"8407":{"id":"/en/docs/advanced-usage-79","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#where-tokens-and-cache-counts-come-from","content":"`completion_tokens`","locale":"en"},"8408":{"id":"/en/docs/advanced-usage-80","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#where-tokens-and-cache-counts-come-from","content":"`reasoning`","locale":"en"},"8409":{"id":"/en/docs/advanced-usage-81","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#where-tokens-and-cache-counts-come-from","content":"`completion_tokens_details.reasoning_tokens`","locale":"en"},"8410":{"id":"/en/docs/advanced-usage-82","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#where-tokens-and-cache-counts-come-from","content":"`cache_read`","locale":"en"},"8411":{"id":"/en/docs/advanced-usage-83","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#where-tokens-and-cache-counts-come-from","content":"`prompt_tokens_details.cached_tokens`; DeepSeek's `prompt_cache_hit_tokens` and Anthropic's `cache_read_input_tokens` are mapped here too","locale":"en"},"8412":{"id":"/en/docs/advanced-usage-84","page_id":"/en/docs/advanced-usage","tags":[],"type":"text","url":"/en/docs/advanced-usage#where-tokens-and-cache-counts-come-from","content":"`cache_write`","locale":"en"},"8413":{"id":"/en/docs/advance
est), then `bun run typecheck` (vue-tsc)","locale":"en"},"11510":{"id":"/en/docs/development-setup-75","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`openapi`","locale":"en"},"11511":{"id":"/en/docs/development-setup-76","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"Prints the OpenAPI document on standard output (`scripts/generate_openapi.py`)","locale":"en"},"11512":{"id":"/en/docs/development-setup-77","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`typegen`","locale":"en"},"11513":{"id":"/en/docs/development-setup-78","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"Regenerates `hoshimi/webui/src/api/schema.d.ts` from the OpenAPI document (commit the result)","locale":"en"},"11514":{"id":"/en/docs/development-setup-79","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`typegen-check`","locale":"en"},"11515":{"id":"/en/docs/development-setup-80","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`typegen`, then `git diff --exit-code`: fails when the generated types are out of date","locale":"en"},"11516":{"id":"/en/docs/development-setup-81","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"`wheel`","locale":"en"},"11517":{"id":"/en/docs/development-setup-82","page_id":"/en/docs/development-setup","tags":[],"type":"text","url":"/en/docs/development-setup#scriptsdevpy-tasks","content":"Builds the Web UI, then writes the wheel and sdist to `dist/` (`scripts/build_wheel.py`)","locale":"en"},"11518":{"id":"/en/docs/develo
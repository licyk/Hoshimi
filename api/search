the-text","content":"Add the text","locale":"en"},"11738":{"id":"/en/docs/development-webui-15","page_id":"/en/docs/development-webui","type":"heading","tags":[],"url":"/en/docs/development-webui#check","content":"Check","locale":"en"},"11739":{"id":"/en/docs/development-webui-16","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui","content":"The Web UI lives in `hoshimi/webui/`: a Vue 3 + Vite + TypeScript app following the Material Design 3 system it shares with its sister project Mizuoto. It talks to the server over HTTP only; the built `dist/` ships in the Python package and the server serves it as static files. This page covers its structure, its contract with the server, and the rules a change to the interface must keep, most of them enforced by tests under `src/`.","locale":"en"},"11740":{"id":"/en/docs/development-webui-17","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#stack-and-commands","content":"For","locale":"en"},"11741":{"id":"/en/docs/development-webui-18","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#stack-and-commands","content":"Dependencies","locale":"en"},"11742":{"id":"/en/docs/development-webui-19","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#stack-and-commands","content":"Framework and routing","locale":"en"},"11743":{"id":"/en/docs/development-webui-20","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#stack-and-commands","content":"Vue 3, vue-router (hash mode), Pinia","locale":"en"},"11744":{"id":"/en/docs/development-webui-21","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en/docs/development-webui#stack-and-commands","content":"Components","locale":"en"},"11745":{"id":"/en/docs/development-webui-22","page_id":"/en/docs/development-webui","tags":[],"type":"text","url":"/en